	file.0000000000000001.title: "Unser Modpack"
	quest.1023A177D0C1D052.quest_desc: [
		"Stabilisatoren rund um den Actuator vergrößern das Lager. Mit dem Storage Accessor greifst du von überall darauf zu."
	]
	quest.1023A177D0C1D052.title: "Lager erweitern"
	quest.10323C73533CCBDF.quest_desc: [
		"Fabriken verarbeiten mehrere Items gleichzeitig. Mit dem Stufen-Installateur machst du aus einer Maschine direkt eine Fabrik, ohne sie abzubauen."
	]
	quest.10323C73533CCBDF.title: "Fabriken"
	quest.1038DA911CD7B60F.quest_desc: [
		"Verstärkt Erdzauber wie Wachstum und Zerquetschen."
	]
	quest.1038DA911CD7B60F.title: "Erd-Fokus"
	quest.10426978DB3F3AF2.quest_desc: [
		"Die Windmühle dreht den Dynamo. Je höher und freier sie steht, desto mehr Strom. Wo Wasser fließt, geht auch ein Wasserrad (braucht Stahl)."
	]
	quest.10426978DB3F3AF2.title: "Windmühle"
	quest.104730F6A543FD4D.quest_desc: [
		"Behält beim Abbauen ihren Inhalt und lässt sich genauso aufwerten wie die Truhen. Shulkerschalen gibt es in den Endstädten."
	]
	quest.104730F6A543FD4D.title: "Shulker-Kiste"
	quest.1048DFCC176A3424.quest_desc: [
		"Plastikplatten kommen aus Polymerharz oder Biopolymer, die du in der Zentrifuge herstellst. Die genauen Wege zeigt EMI."
	]
	quest.1048DFCC176A3424.title: "Plastik"
	quest.105258EF3732EE78.quest_desc: [
		"Der Boss der Zitadelle. Er lässt den &ePanzerhandschuh der Wacht&r fallen."
	]
	quest.105258EF3732EE78.title: "Enderwächter"
	quest.1055241A975F792E.quest_desc: [
		"Der wichtigste Begleiter: Rechtsklick, Struktur auswählen, und der Kompass zeigt dir den Weg. Er findet jede Struktur aus jeder Mod."
	]
	quest.1055241A975F792E.title: "Kompass des Entdeckers"
	quest.105E9A0C2CEC95C4.quest_desc: [
		"Tief im Labyrinth unter dem Sumpf wartet der Minoschwammerl."
	]
	quest.105E9A0C2CEC95C4.title: "Der Minoschwammerl"
	quest.106C7A7E14912230.quest_desc: [
		"Pflanzen im Zerkleinerer ergeben Biobrennstoff, der Biogenerator macht daraus Strom."
	]
	quest.106C7A7E14912230.title: "Biostrom"
	quest.106EB79AD830D19A.quest_desc: [
		"Alex's Caves versteckt fünf große Höhlenbiome tief unter der Overworld. Hier: Magnete und schwebende Blöcke.\n\nAus rotem und blauem Neodym entstehen magnetische Maschinen."
	]
	quest.106EB79AD830D19A.title: "Magnetische Höhlen"
	quest.108D158308E19C07.quest_desc: [
		"Am Amboss kombinierst du Verzauberungen und reparierst Werkzeuge."
		""
		"Dank Easy Anvils bleiben die Items darauf liegen, wenn du ihn verlässt."
	]
	quest.108D158308E19C07.title: "Amboss"
	quest.10A17F7181107E91.quest_desc: [
		"Mit dem Katalysator öffnest du das Portal in den Undergarden. Rezept in EMI."
	]
	quest.10A17F7181107E91.title: "Katalysator"
	quest.10A29809685B7E20.quest_desc: [
		"Leichte Rüstung, die Fernkampfschaden verstärkt. Gibt es als Bogenschützen- und Waldläufer-Set."
	]
	quest.10A29809685B7E20.title: "Bogenschützen-Rüstung"
	quest.10A330017BC2DBF6.quest_desc: [
		"Eine Welt nur zum Graben, ohne Strukturen. Ganz unten liegt Allthemodium-Erz in Massen."
	]
	quest.10A330017BC2DBF6.title: "Mining-Dimension"
	quest.10AE08D71A5BB841.quest_desc: [
		"Der Concurrent Processor ist der Schlüssel für fast alle ExtendedAE-Geräte. Die Presse dafür baust du aus Entro, Siliziumdruck und Enderauge."
	]
	quest.10AE08D71A5BB841.title: "Parallelprozessor"
	quest.10C282A93513E701.quest_desc: [
		"Ein Fokus, mit dem Zauber Blöcke verwandeln. Was genau geht, steht im Handbuch."
	]
	quest.10C282A93513E701.title: "Fokus der Verwandlung"
	quest.10E44D1617AE4C33.quest_desc: [
		"Samen plus Quelljuwel ergeben Magebloom-Saat. Die Blüten werden zu Fasern für Rüstungen und Pergament."
	]
	quest.10E44D1617AE4C33.title: "Magebloom"
	quest.10E73C9EFDA77686.quest_desc: [
		"Trägst du einen Obsidianschädel bei dir, schützt er dich eine Zeit lang vor Feuer und Lava."
	]
	quest.10E73C9EFDA77686.title: "Obsidianschädel"
	quest.10E94F9577609EF6.quest_desc: [
		"&cDer Boss von Ars Nouveau.&r Er wechselt zwischen Angriffsphasen. Bring gute Rüstung und Heilung mit.\n\nEr lässt den &eWilden-Tribut&r fallen."
	]
	quest.10E94F9577609EF6.title: "Wilden-Chimäre"
	quest.10F18168FD9E5B8D.quest_desc: [
		"Ein Fokus (Curio) verstärkt alle Zauber eines Elements. Feuer: Entzünden und Co. werden stärker."
	]
	quest.10F18168FD9E5B8D.title: "Feuer-Fokus"
	quest.1110650C9EF6CFE2.quest_desc: [
		"Controller, Brennstäbe mit Steuerstab oben drauf, ein Stromabnehmer und ein Zugangsport für den Brennstoff. Wie es zusammengehört, steht im Handbuch von Extreme Reactors."
	]
	quest.1110650C9EF6CFE2.title: "Der erste Reaktor"
	quest.11221A1DC8316145.quest_desc: [
		"Archers Expansion bringt weitere Sets für Fernkämpfer. Für das Deadeye-Set brauchst du &eGehärtetes Leder&r."
	]
	quest.11221A1DC8316145.title: "Deadeye-Rüstung"
	quest.1126FFE3F9F8BCA5.quest_desc: [
		"Create: Diesel Generators. Mit dem Ölscanner findest du Chunks, unter denen Öl liegt."
	]
	quest.1126FFE3F9F8BCA5.title: "Öl finden"
	quest.112768FBFF6DE87C.quest_desc: [
		"Der Zerkleinerer mahlt Erz zu Staub und verdoppelt so deine Ausbeute."
	]
	quest.112768FBFF6DE87C.title: "Zerkleinerer"
	quest.113DFB1F82282398.quest_desc: [
		"Rituale brauchen Essenzen: Aureal, Blut, Seelen und Erfahrung. Mit dem Seelenextraktor holst du Seelen aus Seelensand."
	]
	quest.113DFB1F82282398.title: "Seelen sammeln"
	quest.113EB4D59E0E4380.quest_desc: [
		"Mit dem Filetiermesser zerlegst du Fische in der Werkbank zu Fischfilets."
	]
	quest.113EB4D59E0E4380.title: "Filetiermesser"
	quest.114311F7649CA2A1.quest_desc: [
		"Für diese beiden brauchst du Drops der Wilden und Starbuncle-Scherben."
	]
	quest.114311F7649CA2A1.title: "Luft und Beschwörung"
	quest.114770708E247CB5.quest_desc: [
		"Bau einen Monster-Spawner ab, dann bekommst du fleckigen Schrott. Den brauchst du für die Monster-Küche."
	]
	quest.114770708E247CB5.title: "Fleckiger Schrott"
	quest.11499AFEF7539638.quest_desc: [
		"Energiezellen puffern Strom fürs Netzwerk. Die dichte Variante brauchst du auch für die drahtlose Konsole."
	]
	quest.11499AFEF7539638.title: "Energiespeicher"
	quest.11562ABB86D7D2D6.quest_desc: [
		"Für die UV-Lichtbox brauchst du einen &ePCB-Bauplan&r. Wo du ihn bekommst, steht im PneumaticCraft-Handbuch."
	]
	quest.11562ABB86D7D2D6.title: "PCB-Bauplan"
	quest.1165D2479D74D5E8.quest_desc: [
		"Create: Transmission! überträgt Rotation mit Ketten."
	]
	quest.1165D2479D74D5E8.title: "Transmission"
	quest.11735E4944746904.quest_desc: [
		"Der Zwielichtwald hat keine Geheimnisse mehr vor dir."
	]
	quest.11735E4944746904.title: "Herr des Zwielichts"
	quest.11781295A5104BA9.quest_desc: [
		"In der Welt gibt es &eÖlseen&r, an der Oberfläche und unter der Erde. Ein paar Eimer Rohöl brauchst du für die Raffinerie."
	]
	quest.11781295A5104BA9.title: "Rohöl"
	quest.117AE7D5B1B27BDE.quest_desc: [
		"Salbeisamen findest du beim Abbauen von Gras. Pflanz sie auf Ackerland an."
	]
	quest.117AE7D5B1B27BDE.title: "Salbei"
	quest.117C6B424C8750E9.quest_desc: [
		"Eisen, Kupfer und Redstone wachsen ab jetzt auf dem Feld."
	]
	quest.117C6B424C8750E9.title: "Stufe 3: Erze"
	quest.117CA602A510C120.quest_desc: [
		"Sonnenaufgang macht Tag, Wolkenformen ändert das Wetter."
	]
	quest.117CA602A510C120.title: "Wetter und Tag"
	quest.1186FF408E0B5391.quest_desc: [
		"Die einfachste Kraftquelle: Rechtsklick gedrückt halten und kurbeln. Für den Anfang reicht das zum Testen."
	]
	quest.1186FF408E0B5391.title: "Handkurbel"
	quest.118768C4116BF1D1.quest_desc: [
		"Yellorit-Erz liegt in der Oberwelt. Eingeschmolzen ergibt es Yellorium, den Brennstoff für Extreme Reactors."
	]
	quest.118768C4116BF1D1.title: "Yellorium"
	quest.118F073D484295F0.quest_desc: [
		"Eine stärkere Version des Dominion-Stabs. Was sie zusätzlich kann, zeigt der Tooltip."
	]
	quest.118F073D484295F0.title: "Besserer Dominion-Stab"
	quest.118FA2A77F138F0F.quest_desc: [
		"Ein Tank für Flüssigkeiten, vor allem für Blut."
	]
	quest.118FA2A77F138F0F.title: "Dunkler Tank"
	quest.119858F55EEFAEDC.quest_desc: [
		"Die &eRaffinerie&r trennt Rohöl in Diesel, Kerosin, Benzin und LPG. Je mehr Ausgabe-Blöcke du stapelst, desto mehr Sorten kommen raus."
		""
		"Sie braucht &cHitze&r: Details zur Hitze im PneumaticCraft-Handbuch."
	]
	quest.119858F55EEFAEDC.title: "Raffinerie"
	quest.11BAF40516496207.quest_desc: [
		"Wieder mehr Platz und Slots."
	]
	quest.11BAF40516496207.title: "Goldrucksack"
	quest.11C5A8C431319C9C.quest_desc: [
		"Tief im Ozean liegt eine versunkene Stadt. Atemtränke nicht vergessen."
	]
	quest.11C5A8C431319C9C.title: "Versunkene Stadt"
	quest.11C7C9737135536F.quest_desc: [
		"Ein kleiner Akku und Zutat für Energiewürfel, Generatoren, Laser und vieles mehr."
	]
	quest.11C7C9737135536F.title: "Energietablette"
	quest.11D4D2E8A0E1756A.quest_desc: [
		"Eine Tasche am Besen gibt dir 9 Plätze mehr. Pack Ersatzbürsten hinein, denn Bürsten nutzen sich ab."
	]
	quest.11D4D2E8A0E1756A.title: "Besentasche"
	quest.11D586342E8B41B1.quest_desc: [
		"Koks brennt doppelt so lange wie Kohle. Gib 64 Stück ab."
	]
	quest.11D586342E8B41B1.title: "Abgabe: Koks"
	quest.11D90564C9661E4D.quest_desc: [
		"Fast jede Maschine baut auf dem Stahlgehäuse auf. Den einfachen Schaltkreis machst du aus Osmium und Redstone im Infuser.\n\nMit dem Konfigurator stellst du die Seiten von Maschinen ein: Shift-Rechtsklick wechselt den Modus."
	]
	quest.11D90564C9661E4D.title: "Stahlgehäuse"
	quest.11F004B7D9CD0F2B.quest_desc: [
		"Schwere Rüstung für den Nahkampf. Die Berserker-Rüstung baut darauf auf."
	]
	quest.11F004B7D9CD0F2B.title: "Krieger-Rüstung"
	quest.11F7920096D09F96.quest_desc: [
		"Die elektrische Zentrifuge arbeitet mit Strom und automatisch. Ideal, um sie an deinen Bienenstock zu hängen."
	]
	quest.11F7920096D09F96.title: "Elektrische Zentrifuge"
	quest.11F9629C7953113D.quest_desc: [
		"Verbrennt Wasserstoff oder Ethen zu Strom."
	]
	quest.11F9629C7953113D.title: "Gasgenerator"
	quest.1209B07E70843A74.quest_desc: [
		"Im Fahrplan legst du Halte und Bedingungen fest. Rechtsklick auf den Lokführer, und der Zug fährt allein."
	]
	quest.1209B07E70843A74.title: "Fahrplan"
	quest.121410DBECB18B17.quest_desc: [
		"Ein Talisman, der wie ein Totem wirkt. Es gibt noch viele weitere, z. B. gegen Feuer oder Ertrinken."
	]
	quest.121410DBECB18B17.title: "Zweiter Atem"
	quest.1215486666BFFA4E.quest_desc: [
		"&eEnergit&r ist eine Legierung aus Nickel und Fluxit. Daraus entstehen bessere Batterien."
	]
	quest.1215486666BFFA4E.title: "Energit"
	quest.124B303FAFC06616.quest_desc: [
		"Gib 64 Lapislazuli ab. Fürs Verzaubern brauchst du ohnehin Unmengen davon."
	]
	quest.124B303FAFC06616.title: "Abgabe: Lapis"
	quest.124E91D8000A6642.quest_desc: [
		"Das stärkste craftbare Buch: Netherit, Blutfläschchen, Blitzflasche, Arkanes Tuch und ein zerstörtes Buch."
	]
	quest.124E91D8000A6642.title: "Antiker Kodex"
	quest.1254397AB2C01693.quest_desc: [
		"Baue einen Portalrahmen aus Steinziegeln (Form wie beim Nether) und aktiviere ihn mit dem Katalysator.\n\nEine dunkle Höhlenwelt mit eigenen Erzen. Fackeln nicht vergessen!"
	]
	quest.1254397AB2C01693.title: "Undergarden"
	quest.125468E6B5D8698F.quest_desc: [
		"Eine große Maschine, die das Wetter ändern kann. Wie man sie bekommt und bedient, steht im Handbuch."
	]
	quest.125468E6B5D8698F.title: "Umgebungsakkumulator"
	quest.125B109315F7AC3E.quest_desc: [
		"Riesige Mammutbäume und der bunte, magische Hain."
	]
	quest.125B109315F7AC3E.title: "Biomes O' Plenty"
	quest.12782618D31D5FA4.quest_desc: [
		"Der Spaltreaktor erhitzt Kühlmittel zu Dampf und erzeugt dabei Atommüll.\n\n&cAchtung:&r Ohne genug Kühlung steigt die Temperatur. Erreicht der Schaden 100 %, kann er &cexplodieren und alles verstrahlen&r. Immer mit Logikadapter absichern und klein anfangen!"
	]
	quest.12782618D31D5FA4.title: "Spaltreaktor"
	quest.12923C57B8CDF6EA.quest_desc: [
		"Die &eWyvern-Brustplatte&r erzeugt einen &eSchild&r, der Schaden abfängt, solange sie Strom hat."
	]
	quest.12923C57B8CDF6EA.title: "Wyvern-Brustplatte"
	quest.12CC94D9B77E7152.quest_desc: [
		"&eFusion Crafting&r: Der Fusion Crafting Core steht in der Mitte, die &eInjektoren&r zeigen auf ihn. In den Kern kommt das Haupt-Item, in die Injektoren die Zutaten."
		""
		"Die Injektoren brauchen Strom. Jedes Rezept braucht eine Mindeststufe der Injektoren (in EMI angezeigt)."
	]
	quest.12CC94D9B77E7152.title: "Fusion Crafting"
	quest.12E37EE8060FD6BA.quest_desc: [
		"Ein Spülbecken liefert der Küche Wasser."
	]
	quest.12E37EE8060FD6BA.title: "Spülbecken"
	quest.12F2DE19074140D3.quest_desc: [
		"Ein kleines Luftwesen aus Ars Elemental."
	]
	quest.12F2DE19074140D3.title: "Flashjack"
	quest.12F97AF4966DF9BC.quest_desc: [
		"Runen fallen aus Runengestein, das du unter Tage findest. Daraus werden Reagenzgläser und Quantenkerne."
	]
	quest.12F97AF4966DF9BC.title: "Runen"
	quest.1318AAF5BB14CFDF.quest_desc: [
		"&ePlatin&r-Erz gibt es tief in der Oberwelt (Tiefenschiefer) und im End."
	]
	quest.1318AAF5BB14CFDF.title: "Platin"
	quest.1320A74A7EC0FE16.quest_desc: [
		"Terminit plus Netheritbarren: Aeternium ist eines der stärksten Materialien aus BetterEnd."
	]
	quest.1320A74A7EC0FE16.title: "Aeternium"
	quest.132578639807F468.quest_desc: [
		"Das Herz des Netzwerks. Er braucht &eStrom&r (Forge Energy), z. B. aus Powah oder Mekanism."
		""
		"Pro Netzwerk gibt es genau einen Controller."
	]
	quest.132578639807F468.title: "Der Controller"
	quest.136074C21A4820F9.quest_desc: [
		"Simply Swords hat auch einzigartige Waffen mit Spezialfähigkeiten, die nur in Truhen liegen. Die Glutklinge ist eine davon."
	]
	quest.136074C21A4820F9.title: "Einzigartige Waffe"
	quest.138A9D21E58BF39C.quest_desc: [
		"Der Thermomix schneidet Zutaten maschinell (Rezepte vom Schneidebrett). Der Sprinkler bewässert Felder."
	]
	quest.138A9D21E58BF39C.title: "Slice & Dice"
	quest.1398A72816F20117.quest_desc: [
		"Lässt Babybienen schneller erwachsen werden."
	]
	quest.1398A72816F20117.title: "BaBee-Inkubator"
	quest.139FC95D3E83D54E.quest_desc: [
		"Teig aus Weizen und Ei, mit dem Messer zu Nudeln geschnitten, dazu Hackfleisch und Tomatensauce aus dem Kochtopf."
	]
	quest.139FC95D3E83D54E.title: "Nudeln mit Fleischbällchen"
	quest.13AC657D686AED12.quest_desc: [
		"Weitere Glyphen-Addons: &eStrahl&r (Too Many Glyphs), &eRakete&r (Ars Omega) und &eGröße ändern&r (Ars Scalaes)."
	]
	quest.13AC657D686AED12.title: "Noch mehr Glyphen"
	quest.13B16C539288D02E.quest_desc: [
		"Beute vom toten König: ein starkes Zauberbuch."
	]
	quest.13B16C539288D02E.title: "Necronomicon"
	quest.13D2537BFCAE09C0.quest_desc: [
		"Der primitive Heizgenerator verbrennt Brennstoff und reicht für den Anfang."
	]
	quest.13D2537BFCAE09C0.title: "Erster Strom"
	quest.13D2C9ED6A556358.quest_desc: [
		"Am Änderungstisch steckst du &eFäden&r in deine Rüstung. Jeder Faden bringt einen Bonus."
	]
	quest.13D2C9ED6A556358.title: "Fäden"
	quest.13DDC6C482CB2709.quest_desc: [
		"Ein schwer gepanzerter Ritter aus Born in Chaos. Schilde und gute Rüstung lohnen sich hier."
	]
	quest.13DDC6C482CB2709.title: "Gefallener Chaosritter"
	quest.13E38E812B65F397.quest_desc: [
		"Auch Edelsteine fallen von Monstern. Deinen ersten &eEdelsteinstaub&r bekommst du, wenn du einen Edelstein auf den Boden wirfst und einen Amboss darauf fallen lässt."
	]
	quest.13E38E812B65F397.title: "Edelsteinstaub"
	quest.13F6F22498030965.quest_desc: [
		"Gold und Seelensand ergeben Soularium. Damit geht es an die Seelen."
	]
	quest.13F6F22498030965.title: "Soularium"
	quest.13FBA7A2B62A161E.quest_desc: [
		"Atommüll muss irgendwohin. Das Fass baut ihn langsam ab, besser ist es, ihn zu Polonium oder Plutonium weiterzuverarbeiten."
	]
	quest.13FBA7A2B62A161E.title: "Wohin mit dem Müll?"
	quest.140DD6EC92430E36.quest_desc: [
		"Über den &eEnergie-Pylon&r (mit Glas darauf) fließt Strom in den Energiekern hinein oder heraus."
	]
	quest.140DD6EC92430E36.title: "Energie-Pylon"
	quest.14113B6F624B27CB.quest_desc: [
		"Reichweiten-, Tempo- und Effizienz-Upgrades kommen direkt in die Maschine. Höhere Reichweiten-Stufen stehen in EMI."
	]
	quest.14113B6F624B27CB.title: "Upgrades"
	quest.141667D8349427F7.quest_desc: [
		"Scylla herrscht über die Akropolis. Folge dem &eSturmauge&r.\n\nMit der Essenz des Sturms baust du ihre mächtigen Waffen."
	]
	quest.141667D8349427F7.title: "Scylla"
	quest.141DCC208DADA2C5.quest_desc: [
		"Eine Fertigungs-CPU ist ein Quader aus Fertigungseinheiten mit mindestens einem Speicher. Sie plant die Aufträge.\n\nJetzt kannst du in der Konsole Items mit Mittelklick bestellen!"
	]
	quest.141DCC208DADA2C5.title: "Fertigungs-CPU"
	quest.14251141C7CE9FB2.quest_desc: [
		"Aus Drops der Chimäre: Der Fokus macht beschworene Wesen stärker."
	]
	quest.14251141C7CE9FB2.title: "Fokus der Beschwörung"
	quest.1425F29BA8D3D453.quest_desc: [
		"Im Nether gibt es Seelenstein-Felder. Darin steckt Soulium-Erz, aus dem du &eSoulium-Staub&r bekommst."
	]
	quest.1425F29BA8D3D453.title: "Seelenstein"
	quest.142CDAE615830C98.quest_desc: [
		"Die &ePneumatische Rüstung&r läuft mit Luft und wird mit Upgrades erweitert: Nachtsicht, Sprungkraft, Jet-Stiefel und vieles mehr."
		""
		"Upgrades steckst du in der Ladestation ein."
	]
	quest.142CDAE615830C98.title: "Pneumatische Rüstung"
	quest.143F37F83EA1417E.quest_desc: [
		"Jede Runenwaffe bekommt eine zufällige Rune. Wenn sie dir nicht gefällt, bau eine neue."
	]
	quest.143F37F83EA1417E.title: "Runenschwert"
	quest.1448DDA1529BEBA7.quest_desc: [
		"Storage Drawers: Eine Schublade fasst viele Stacks von nur einer Sorte. Rechtsklick legt rein, Linksklick nimmt raus."
		""
		"Doppelter Rechtsklick legt alle passenden Items aus dem Inventar hinein."
	]
	quest.1448DDA1529BEBA7.title: "Schubladen"
	quest.146609E1BD782EFC.quest_desc: [
		"Stellt die Drehzahl eines großen Zahnrads stufenlos ein. Praktisch für Maschinen, die schnell laufen sollen."
	]
	quest.146609E1BD782EFC.title: "Drehzahlregler"
	quest.1489CEC857D5FFCA.quest_desc: [
		"Ein Zauberbuch für die Abgrund-Schule aus der Tiefsee. Dazu gibt es eine eigene Abgrund-Rune und Upgrade-Kugel."
	]
	quest.1489CEC857D5FFCA.title: "Buch o' R'lyeh"
	quest.149693DAD2A88405.quest_desc: [
		"Ein echter Aufzug: Seilrolle, Kabine und Kontakte an jedem Stockwerk. In der Kabine wählst du das Ziel."
	]
	quest.149693DAD2A88405.title: "Aufzug"
	quest.14B533EE5898D7EE.quest_desc: [
		"Leg ein Regal in den Zaubertisch und verzaubere es: Das ist eine &eInfusion&r. Die nötigen Werte zeigt EMI. Infundierte Regale sind die Basis für alle besseren Varianten."
	]
	quest.14B533EE5898D7EE.title: "Infusion"
	quest.14CA01035714C0B9.quest_desc: [
		"Der Quantentunnel verbindet zwei Netzwerke über jede Entfernung, sogar zwischen Dimensionen. Beide Seiten brauchen eine Quantenverschränkte Singularität."
	]
	quest.14CA01035714C0B9.title: "Quantenverbindung"
	quest.14D31A5B54A54E79.quest_desc: [
		"Gib 64 Draconium-Barren ab und hol dir eine Belohnung."
	]
	quest.14D31A5B54A54E79.title: "Abgabe: Draconium"
	quest.14DCB9FC28A7FF30.quest_desc: [
		"Rachegeister sind nachts unterwegs und lassen sich nur schwer treffen. Besieg einen."
	]
	quest.14DCB9FC28A7FF30.title: "Rachegeist"
	quest.14E3A47EF66B58C0.quest_desc: [
		"Zum Abschluss noch ein kleines Opfer: vier Nethersterne."
	]
	quest.14E3A47EF66B58C0.title: "Abgabe: Nethersterne"
	quest.14F297D9620D5A74.quest_desc: [
		"Der Monsterspawner erzeugt den Mob aus dem Fanggerät immer wieder, solange er Strom und Essenz bekommt."
	]
	quest.14F297D9620D5A74.title: "Monsterspawner"
	quest.14F912949424B1B1.quest_desc: [
		"Gib 64 Oritech-Stahl ab und hol dir eine Belohnung."
	]
	quest.14F912949424B1B1.title: "Abgabe: Stahl"
	quest.150381585B11E73F.quest_desc: [
		"Certus-Quarz ist die Grundlage von AE2. Du findest ihn in &eMeteoriten&r: Krater mit Himmelsstein und Certus-Knospen.\n\nAlles Wichtige erklärt dir die AE2-Anleitung im Spiel. Bau sie dir gleich als Erstes."
	]
	quest.150381585B11E73F.title: "Certus-Quarz"
	quest.15080A8733FE8A21.quest_desc: [
		"Der Abfüller füllt Honig in Flaschen. Mit einer Biene darin macht er aus einer Flasche besonderes Bienenmaterial."
	]
	quest.15080A8733FE8A21.title: "Abfüller"
	quest.1527F2E42F60C030.quest_desc: [
		"Dunkelstahl, Endstein und Obsidian. Die stärkste Legierung von Ender IO."
	]
	quest.1527F2E42F60C030.title: "Endstahl"
	quest.152C900C9E51C661.quest_desc: [
		"Trade Cycling: Solange du mit einem Dorfbewohner noch nicht gehandelt hast, kannst du im Handelsfenster per Knopf neue Angebote würfeln."
	]
	quest.152C900C9E51C661.title: "Handel neu würfeln"
	quest.153AE0F15E49D275.quest_desc: [
		"MEGA Cells braucht Himmelsstahl und Himmelsbronze. Rezepte siehst du in EMI."
	]
	quest.153AE0F15E49D275.title: "Himmelsmetalle"
	quest.153DB2682CEC39D5.quest_desc: [
		"Gummi im Ofen schmelzen ergibt Kunststoff. Davon brauchst du ab jetzt Unmengen."
	]
	quest.153DB2682CEC39D5.title: "Kunststoff"
	quest.15414B3C734DA7CB.quest_desc: [
		"Die letzte Injektor-Stufe. Jeder braucht ein &eDrachenei&r, du musst also mehrmals an eins kommen."
	]
	quest.15414B3C734DA7CB.title: "Chaotische Injektoren"
	quest.155D6EE638883874.quest_desc: [
		"Eisdrachen findest du in verschneiten Gebieten. Ihr Atem friert dich ein."
	]
	quest.155D6EE638883874.title: "Eisdrache"
	quest.1567EBCE6A3D837E.quest_desc: [
		"Steck einen Dorfbewohner hinein und handle mit ihm, ganz ohne Gehege. Was er dafür noch braucht, zeigt dir EMI."
	]
	quest.1567EBCE6A3D837E.title: "Händlerblock"
	quest.157BEEC60F99312B.quest_desc: [
		"Die &eAtomschmiede&r ist ein Multiblock, der vom Enderischen Laser mit Energie versorgt wird. Sie stellt die stärksten Materialien her."
	]
	quest.157BEEC60F99312B.title: "Atomschmiede"
	quest.1583F458B3EB4243.quest_desc: [
		"Die ersten Draconic-Werkzeuge. Sie laufen mit Strom und lassen sich mit Modulen aufwerten."
	]
	quest.1583F458B3EB4243.title: "Wyvern-Werkzeug"
	quest.158910F703716CDC.quest_desc: [
		"Setz die Enderaugen in den Portalrahmen und spring rein. Der Enderdrache wartet schon (siehe Bosse-Kapitel).\n\n&cNimm Blöcke zum Bauen mit&r, falls du auf einer kleinen Insel landest."
	]
	quest.158910F703716CDC.title: "Das End"
	quest.1595B634D0C3F8EC.quest_desc: [
		"Rakete auf die Startrampe stellen, betanken, einsteigen und mit Leertaste starten."
	]
	quest.1595B634D0C3F8EC.title: "Rakete Stufe 1"
	quest.15998F5DBAED0897.quest_desc: [
		"Der Herd ist eine bequeme Hitzequelle für den Kochtopf. Oben drauf kannst du auch direkt Fleisch braten."
	]
	quest.15998F5DBAED0897.title: "Herd"
	quest.15AD6B56EDB6EDF2.quest_desc: [
		"Das Uralte Relikt schläft in der Verfluchten Pyramide in der Wüste. Folge dem &eWüstenauge&r."
	]
	quest.15AD6B56EDB6EDF2.title: "Uraltes Relikt"
	quest.15BC6AD0F02E7331.quest_desc: [
		"Rabenfeder, Fackelbeeren und Glowstone ergeben den Kartenfokus, mit Papier die Magische Karte. Sie zeigt Biome und Boss-Strukturen."
	]
	quest.15BC6AD0F02E7331.title: "Magische Karte"
	quest.15DBC538E707CF99.quest_desc: [
		"Gold liegt tiefer als Eisen, in Badlands-Biomen auch weiter oben. Im Nether gibt es Goldnuggets im Netherrack."
	]
	quest.15DBC538E707CF99.title: "Gold"
	quest.15E63FFE4C9CBD64.quest_desc: [
		"Mit dem Stab verbindest du Relais und gibst Wesen wie dem Starbuncle Aufgaben."
	]
	quest.15E63FFE4C9CBD64.title: "Dominion-Stab"
	quest.15EC297DEAD4BC6E.quest_desc: [
		"Aus dem Prototyp machst du im Steinschneider die Tür in vielen Varianten, vom ICE bis zur Londoner U-Bahn."
	]
	quest.15EC297DEAD4BC6E.title: "Zugtür"
	quest.15F09ED7AC553F4A.quest_desc: [
		"Im Frostgefängnis wartet der Maledictus. Das &eAuge des Fluchs&r führt dich hin.\n\nEr lässt &eCursium&r fallen."
	]
	quest.15F09ED7AC553F4A.title: "Maledictus"
	quest.15F572294E1640C5.quest_desc: [
		"Aus einer Enderperle und Allthemodium-Nuggets. Je nachdem, wo du das Pad benutzt, bringt es dich in eine andere Dimension.\n\nIn der Oberwelt geht es in die &eMining-Dimension&r."
	]
	quest.15F572294E1640C5.title: "Teleport-Pad"
	quest.16023CF7176124DF.quest_desc: [
		"Der Vulkanische Link verbrennt Brennstoff, der Myzel-Link frisst Essen. Beide liefern mehr Quelle als der Agronomische."
	]
	quest.16023CF7176124DF.title: "Mehr Quellen"
	quest.161627C8518716D7.quest_desc: [
		"Keine andere Stromquelle? Die Vibrationskammer verbrennt Brennstoff wie ein Ofen und speist das Netz direkt."
	]
	quest.161627C8518716D7.title: "Vibrationskammer"
	quest.1627C6612AB7AE3D.quest_desc: [
		"Ring und Anhänger sind leer. Im Verzauberungsapparat werden daraus echte Curios."
	]
	quest.1627C6612AB7AE3D.title: "Schmuckrohlinge"
	quest.16289D4340FB223A.quest_desc: [
		"Polierter Rosenquarz auf einem Eisenblech. Die Röhre steckt in fast allen Messing-Maschinen."
	]
	quest.16289D4340FB223A.title: "Elektronenröhre"
	quest.163878E36B4AB3FB.quest_desc: [
		"Repurposed Structures bringt bekannte Strukturen in neuen Varianten, z. B. Dörfer im Birken-, Dschungel- oder Kirschblütenstil. Jedes davon zählt."
	]
	quest.163878E36B4AB3FB.title: "Repurposed Structures"
	quest.164DA1F0C90ABF78.quest_desc: [
		"Wirkt auch auf Ressourcen-Pflanzen, wo normales Knochenmehl nichts bringt."
	]
	quest.164DA1F0C90ABF78.title: "Mystischer Dünger"
	quest.16524B0976ED00B7.quest_desc: [
		"Die Augen von Cataclysm baust du aus einem Enderauge und passenden Zutaten. Geworfen zeigen sie zur Boss-Struktur.\n\nFür den Anfang: das &eAuge der Monstrosität&r (Nether) und das &eAuge der Leere&r (End)."
	]
	quest.16524B0976ED00B7.title: "Augen von Cataclysm"
	quest.165A1C179FA15E8F.quest_desc: [
		"Mit Filter: Sie lassen nur bestimmte Items durch. Messingtunnel können außerdem gleichmäßig verteilen."
	]
	quest.165A1C179FA15E8F.title: "Messing-Schleuse und -Tunnel"
	quest.1669D8493EE34097.quest_desc: [
		"Zerstöre zuerst die Endkristalle auf den Obsidiansäulen, sonst heilt sich der Drache.\n\nDanach steht dir das äußere End offen."
	]
	quest.1669D8493EE34097.title: "Der Enderdrache"
	quest.166BB30A85C34D36.quest_desc: [
		"Aus Desh baust du Motor, Tank und die Stufe-2-Rakete. Damit kommst du zum Mars."
	]
	quest.166BB30A85C34D36.title: "Rakete Stufe 2"
	quest.166DA94DBFFF1C74.quest_desc: [
		"Die Minenschächte haben je nach Biom einen eigenen Stil und sind viel größer. Achte auf die Loren mit Kisten."
	]
	quest.166DA94DBFFF1C74.title: "Bessere Minen"
	quest.166E84AF197D8DDE.quest_desc: [
		"Ein großer Tempel mit Fallen und versteckten Räumen. Schau genau hin, wo du hintrittst."
	]
	quest.166E84AF197D8DDE.title: "Dschungeltempel"
	quest.1673A4B1845D29A9.quest_desc: [
		"Viele Oritech-Maschinen sind &eMultiblöcke&r und brauchen Maschinenkerne um sich herum. Beim Platzieren zeigt dir die Vorschau, wohin sie gehören."
	]
	quest.1673A4B1845D29A9.title: "Maschinenkerne"
	quest.168E8EE94652ECC5.quest_desc: [
		"Ein Create-Motor, der mit Quelle läuft statt mit Strom."
	]
	quest.168E8EE94652ECC5.title: "Quellmotor"
	quest.1690820C73F858DD.quest_desc: [
		"Riesige Fertigungs-CPUs für riesige Aufträge."
	]
	quest.1690820C73F858DD.title: "MEGA-CPU"
	quest.1690DC83E11ED26B.quest_desc: [
		"Selten und wertvoll: Aus Nether-Rubin baust du Werkzeuge und Rüstung."
	]
	quest.1690DC83E11ED26B.title: "Nether-Rubin"
	quest.1697E44735604F50.quest_desc: [
		"Mutant Monsters macht aus normalen Monstern riesige Brocken. Der Mutantenzombie steht nach dem ersten Tod gerne wieder auf."
	]
	quest.1697E44735604F50.title: "Mutantenzombie"
	quest.16A134E807B81CAE.quest_desc: [
		"Aufgeladene Kristalle sind die Zutaten für die besten Maschinen der Mod."
	]
	quest.16A134E807B81CAE.title: "Aufgeladene Kristalle"
	quest.16B52586AD106CEB.quest_desc: [
		"Öl findest du an Ölquellen. Die Raffinerie macht daraus Raketentreibstoff (braucht Strom)."
	]
	quest.16B52586AD106CEB.title: "Treibstoff"
	quest.16BE5121AFD232A1.quest_desc: [
		"Ein Bett aus drei Wolle und drei Brettern lässt dich die Nacht überspringen und setzt deinen Spawnpunkt."
		""
		"Wolle bekommst du von Schafen. Hak die Quest ab, sobald du eins hast."
	]
	quest.16BE5121AFD232A1.title: "Bett"
	quest.16C50E598BD2A973.quest_desc: [
		"Der Schlaue Schacht filtert Items, der Schlaue Beobachter reagiert auf bestimmte Inhalte."
	]
	quest.16C50E598BD2A973.title: "Schlauer Schacht"
	quest.16C5C3360EAB375E.quest_desc: [
		"Mit diesem Ritual bindest du ein Wesen an ein Skript. So bekommst du &eVertraute&r, die dich begleiten."
	]
	quest.16C5C3360EAB375E.title: "Ritual der Bindung"
	quest.16C5E1CA4D1BFEEB.quest_desc: [
		"Die Wildfire hütet Bastionen im Nether und wird von Lohen begleitet. Sie lässt Fragmente ihrer Krone fallen.\n\nAus den Fragmenten baust du die &eLauffeuer-Krone&r."
	]
	quest.16C5E1CA4D1BFEEB.title: "Wildfire"
	quest.16CAE98EB19058EA.quest_desc: [
		"Applied Flux speichert Energie (FE) direkt im ME-Netz. Dafür brauchst du Isolierharz und Redstone-Kristalle."
	]
	quest.16CAE98EB19058EA.title: "Applied Flux"
	quest.16D0E23B91F6F34A.quest_desc: [
		"Der Kapitän der Piraten von Bosses'Rise hat eine ganze Mannschaft dabei."
	]
	quest.16D0E23B91F6F34A.title: "Piratenkapitän"
	quest.16D507A9DBB21038.quest_desc: [
		"Mit Leckerlis lockst und vermehrst du Bienen. Zwei passende Bienen mit Leckerli füttern ergibt manchmal eine neue Art."
	]
	quest.16D507A9DBB21038.title: "Honig-Leckerli"
	quest.16E15FD85A75E6A0.quest_desc: [
		"Bessere Energiestäbe laden die Kugel schneller. Ab Spirited lohnt sich das wirklich."
	]
	quest.16E15FD85A75E6A0.title: "Schnellere Stäbe"
	quest.16F39659029AE244.quest_desc: [
		"Für weite Strecken und große Maschinen. Dafür brauchst du Aluminium aus Bauxit."
	]
	quest.16F39659029AE244.title: "Stahlkabel (HV)"
	quest.170105E53BEA0461.quest_desc: [
		"Das Fokus-Item der Blitz-Schule. Du brauchst es für die Blitz-Rune und den Antiken Kodex. Wie man es bekommt, zeigt EMI."
	]
	quest.170105E53BEA0461.title: "Blitz in der Flasche"
	quest.171148D31F0DABDC.quest_desc: [
		"Du hast alle Dimensionen des Packs bereist."
	]
	quest.171148D31F0DABDC.title: "Weltenbummler"
	quest.174041CD05D1F964.quest_desc: [
		"Artefakte findest du in Truhen und bei Mimics. Sie kommen in die Zusatzplätze und geben dauerhaft Boni, z. B. schnelleres Laufen."
	]
	quest.174041CD05D1F964.title: "Erstes Artefakt"
	quest.174701AC59CF81FB.quest_desc: [
		"Sprengst du einen Spawner, bleibt eine &eSpawner-Kette&r übrig. Daraus werden Runen, mit denen du Spawner noch weiter verbesserst."
	]
	quest.174701AC59CF81FB.title: "Spawner-Runen"
	quest.1749169803616808.quest_desc: [
		"Die Zerlegebank nimmt Items wieder auseinander, gegen ein paar Erfahrungslevel. Du brauchst dafür den Labyrinthkarten-Fokus (Rezept in EMI)."
	]
	quest.1749169803616808.title: "Zerlegebank"
	quest.174F0B0A61ACFBA0.quest_desc: [
		"Mit dem &eSoulium-Dolch&r sammelst du Seelen von Mobs in Seelenurnen. Volle Urnen sind die Zutat für Mob-Samen."
	]
	quest.174F0B0A61ACFBA0.title: "Soulium"
	quest.174F526534674A42.quest_desc: [
		"Enderperle, Blutfläschchen und Arkane Essenz. Die Arkan-Rune braucht man für Mana-Kugeln."
	]
	quest.174F526534674A42.title: "Ender, Blut, Arkan"
	quest.175253F3A02AF69E.quest_desc: [
		"Drei Köpfe, Feuer und Mörser. Die Hydra lebt im Feuersumpf. Triff sie in die offenen Mäuler."
	]
	quest.175253F3A02AF69E.title: "Die Hydra"
	quest.17555AAB9E4C75C2.quest_desc: [
		"Der Controller verbindet alle Schubladen in der Nähe. Was du hineinsteckst, landet in der passenden Schublade."
		""
		"Für den Komparator brauchst du Netherquarz."
	]
	quest.17555AAB9E4C75C2.title: "Netzwerkschublade"
	quest.1773678FDCE88B33.quest_desc: [
		"Create: Garnished bringt Nussbäume in die Welt. Aus ihren Blättern fallen ungarnierte Nüsse."
		""
		"Mit Create werden daraus garnierte Nüsse und viele Snacks. Wie genau, zeigt dir EMI."
	]
	quest.1773678FDCE88B33.title: "Nüsse"
	quest.178B34D3803D3C16.quest_desc: [
		"Das Speichersystem von Mekanism: Laufwerke in einem Array, Zugriff über das Dashboard, kabellos im ganzen Netz."
	]
	quest.178B34D3803D3C16.title: "QIO-Speicher"
	quest.17AF2158C5275212.quest_desc: [
		"&eLogik-Kabel&r verbinden alle Teile eines Netzwerks. Sie transportieren Informationen, keine Items."
	]
	quest.17AF2158C5275212.title: "Logik-Kabel"
	quest.17B09B91E5DA2739.quest_desc: [
		"Wellen und Zahnräder in allen Holz- und Gehäusearten, dazu einstellbare Getriebe."
	]
	quest.17B09B91E5DA2739.title: "Create Encased"
	quest.17B82332255E603B.quest_desc: [
		"Gib 64 Honigwaben ab."
	]
	quest.17B82332255E603B.title: "Abgabe: Honigwaben"
	quest.17C10C0152512FC8.quest_desc: [
		"Acht Bruchstein im Kreis ergeben einen Ofen. Damit schmilzt du Erze und brätst Essen."
	]
	quest.17C10C0152512FC8.title: "Ofen"
	quest.17C7BEDA1AF10E88.quest_desc: [
		"&cEin Feuer-Boss aus Iron's Spells.&r Feuerresistenz-Tränke helfen sehr."
	]
	quest.17C7BEDA1AF10E88.title: "Feuer-Boss"
	quest.17CA5FE18CA0C5E4.quest_desc: [
		"Ein Starbuncle trägt Items von Truhe zu Truhe. Mit dem Dominion-Stab legst du fest, woher und wohin."
	]
	quest.17CA5FE18CA0C5E4.title: "Starbuncle"
	quest.17E23D123DB2489E.quest_desc: [
		"Tollkirsche und Salbei werden im Mörser zur ersten Kräutermischung."
	]
	quest.17E23D123DB2489E.title: "Kräutermischung"
	quest.17E8B60312A1328B.quest_desc: [
		"Die Goldstufe für dein Hauptlager."
	]
	quest.17E8B60312A1328B.title: "Goldtruhe"
	quest.17FF4941B3C2DF1F.quest_desc: [
		"In der Modifikationsstation baust du Module in MekaSuit und Meka-Tool ein: Jetpack, Nachtsicht, Magnet und vieles mehr."
	]
	quest.17FF4941B3C2DF1F.title: "Module"
	quest.18304F9C1519C6D0.quest_desc: [
		"Ein Stapel Messing für die Werkstatt."
	]
	quest.18304F9C1519C6D0.title: "Abgabe: Messing"
	quest.1831FA28E1358990.quest_desc: [
		"Hohes Gras und Weizen mit dem Messer abbauen gibt Stroh. Daraus werden Seile, Leinen und Kompost."
	]
	quest.1831FA28E1358990.title: "Stroh"
	quest.183AC59E542FDDFA.quest_desc: [
		"Mit Kleber verbindest du Blöcke zu einer Contraption. Bereich markieren, fertig."
	]
	quest.183AC59E542FDDFA.title: "Sekundenkleber"
	quest.185AFA590FE6C3F7.quest_desc: [
		"Jede Linsenfarbe bevorzugt andere Erze. In EMI siehst du bei der Laserbasis, welche Farbe was bringt."
	]
	quest.185AFA590FE6C3F7.title: "Linsen"
	quest.186CE55CF3A53C59.quest_desc: [
		"Tief unten im Tiefen Dunkel. &cSchleichen!&r Jedes Geräusch kann den Wärter rufen. Im Zentrum steht ein großer Rahmen aus verstärktem Tiefenschiefer."
	]
	quest.186CE55CF3A53C59.title: "Antike Stadt"
	quest.18723E0129EDAAE4.quest_desc: [
		"Diamant, Schweinsleder, Arkanes Tuch und ein verzaubertes Buch. Das beste craftbare Standardbuch."
	]
	quest.18723E0129EDAAE4.title: "Verzaubertes Buch"
	quest.1875821C004CC694.quest_desc: [
		"&cEin harter Boss.&r Der tote König wacht in alten Gemäuern über sein Grab. Bring Heilung und gute Rüstung."
	]
	quest.1875821C004CC694.title: "Der tote König"
	quest.188B6227E282EF05.quest_desc: [
		"Eine kleine Spielerei: Der Stab verpasst Gegnern einen elektrischen Schlag, solange er geladen ist."
	]
	quest.188B6227E282EF05.title: "Geladener Stab"
	quest.1892F3337D157F4C.quest_desc: [
		"Der Rucksack sammelt Items vom Boden direkt selbst ein, auch mit Filter."
	]
	quest.1892F3337D157F4C.title: "Aufsammeln"
	quest.18969110CADB6113.quest_desc: [
		"Die Vorlage wertet Netherit-Ausrüstung im Schmiedetisch auf. Eine Vorlage, Netheritbarren und Tiefenschiefer ergeben zwei neue."
	]
	quest.18969110CADB6113.title: "Allthemodium-Vorlage"
	quest.189B9FA22F626819.quest_desc: [
		"Das versiegelte Gerüst ist der Rahmen der Seelenmaschinen. Mit der Seelenampulle fängst du Mobs ein."
	]
	quest.189B9FA22F626819.title: "Versiegeltes Gerüst"
	quest.18A40924A87FACCC.quest_desc: [
		"Dieser Faden erhöht dein maximales Mana. Weitere Fäden findest du in EMI."
	]
	quest.18A40924A87FACCC.title: "Magische Kapazität"
	quest.18AB83470B076AB9.quest_desc: [
		"Auf dem Trockengestell trocknen Kräuter und Besenbürsten. Ein getrocknetes Salbeibündel kannst du anzünden."
	]
	quest.18AB83470B076AB9.title: "Kräuter trocknen"
	quest.18AEC561A5B34AF6.quest_desc: [
		"Dolche treffen sehr schnell. Die Doppelaxt ist das genaue Gegenteil: langsam, aber brutal."
	]
	quest.18AEC561A5B34AF6.title: "Schneller Dolch"
	quest.18B55C1D03088783.quest_desc: [
		"Eine riesige Truhe mit eingebauter Werkbank und Ofen."
	]
	quest.18B55C1D03088783.title: "Draconium-Truhe"
	quest.18B7714535F6A384.quest_desc: [
		"Das Becken nimmt Items und Flüssigkeiten auf. Mit der Presse darüber wird verdichtet, mit dem Mixer gemischt."
	]
	quest.18B7714535F6A384.title: "Becken"
	quest.18C70E83F74E65FF.quest_desc: [
		"Das ultimative Werkzeug mit Modulen für Abbaugeschwindigkeit, Vein Mining, Teleport und mehr."
	]
	quest.18C70E83F74E65FF.title: "Meka-Tool"
	quest.18E72CAC787CC8A7.quest_desc: [
		"Kostenloser Strom. Solar nur bei Tag und freiem Himmel, Wind ist weiter oben stärker."
	]
	quest.18E72CAC787CC8A7.title: "Sonne und Wind"
	quest.191B006DC87D0D7A.quest_desc: [
		"Create: Dreams & Desires bringt stärkere Maschinen. Los geht es mit dem Industriegehäuse."
	]
	quest.191B006DC87D0D7A.title: "Industriegehäuse"
	quest.19337D87017071E3.quest_desc: [
		"Der &eMob Grinder&r tötet Mobs in seiner Nähe mit Strom. Perfekt für Mobfarmen."
	]
	quest.19337D87017071E3.title: "Mob Grinder"
	quest.193D98269F5C23E5.quest_desc: [
		"Pulsierende Legierung ist Eisen plus Enderperle. Diamant mit pulsierenden Klumpen und Smaragd mit strahlenden Klumpen ergeben die Kristalle für die besten Maschinen."
	]
	quest.193D98269F5C23E5.title: "Kristalle"
	quest.19431669CCDA8CE2.quest_desc: [
		"Das Handbuch von EvilCraft. Hier steht genau, wie die Maschinen und Rituale funktionieren. Das Rezept zeigt dir EMI."
	]
	quest.19431669CCDA8CE2.title: "Origins of Darkness"
	quest.19502274DB449EF9.quest_desc: [
		"Manche Truhen in Höhlen und Strukturen sind Mimics. Sie beißen zu, wenn du sie öffnest. Besiegte Mimics lassen Artefakte fallen."
	]
	quest.19502274DB449EF9.title: "Falsche Truhe!"
	quest.1955C273ED764C05.quest_desc: [
		"Hier stecken drei kleinere Mods: &eActually Additions&r (Mitte), &eIntegrated Dynamics&r (oben) und &eIron Jetpacks&r (unten)."
		""
		"Such dir aus, womit du anfangen willst."
	]
	quest.1955C273ED764C05.title: "Kleine Technik"
	quest.19686DBACEAA8E6C.quest_desc: [
		"Der Auflösungsapparat verbindet Items mit Flüssigkeiten. Viele Teile von Industrial Foregoing entstehen nur hier."
	]
	quest.19686DBACEAA8E6C.title: "Auflösungsapparat"
	quest.196922115F9A35B9.quest_desc: [
		"Normale Kabel tragen 8 Kanäle, dichte Kabel 32. Schlaue Kabel zeigen dir die belegten Kanäle als Lichtstreifen an."
	]
	quest.196922115F9A35B9.title: "Kanäle verstehen"
	quest.1972FECAE9B9FCF5.quest_desc: [
		"Ein Whirlisprig lässt Pflanzen in seiner Nähe schneller wachsen."
	]
	quest.1972FECAE9B9FCF5.title: "Whirlisprig"
	quest.197EDF81309AF84A.quest_desc: [
		"Die Fermentationsstation braucht schon das einfache Gehäuse. Was sie herstellt, siehst du in EMI."
	]
	quest.197EDF81309AF84A.title: "Fermentation"
	quest.197F5ACBD7134EB7.quest_desc: [
		"Noch mehr Platz. Ab hier lohnen sich Upgrades richtig."
	]
	quest.197F5ACBD7134EB7.title: "Eisentruhe"
	quest.19902A07A3EDB892.quest_desc: [
		"Die Sämaschine pflanzt, die Erntemaschine erntet, auch Bäume. Zusammen eine vollautomatische Farm."
	]
	quest.19902A07A3EDB892.title: "Automatische Farm"
	quest.1995E63350857E06.quest_desc: [
		"Der Materiekondensator vernichtet Items und macht daraus Materiebälle und mit genug Speicher eine &eSingularität&r. Die brauchen später die Addons (MEGA, AdvancedAE)."
	]
	quest.1995E63350857E06.title: "Singularität"
	quest.199698B570F82B1E.quest_desc: [
		"Der &eMischkessel&r ist das Herzstück von Hexerei. Er fasst zwei Eimer Flüssigkeit, mischt Zutaten und braut Tränke. Manche Rezepte brauchen eine Hitzequelle darunter."
	]
	quest.199698B570F82B1E.title: "Mischkessel"
	quest.199D9AC686FCA584.quest_desc: [
		"Mithril-Erz liegt tief unten im Tiefenschiefer. Daraus bekommst du Mithril-Schrott."
	]
	quest.199D9AC686FCA584.title: "Mithril"
	quest.19ADA048D98D80EE.quest_desc: [
		"Kupfer und Zink im Mixer mischen, mit einem &ebeheizten&r Becken (Lohenbrenner darunter). Heraus kommt Messing.\n\nMessing öffnet die nächste Stufe von Create."
	]
	quest.19ADA048D98D80EE.title: "Messing"
	quest.19B5589CDF3FB20B.quest_desc: [
		"Trash Cans: Die Item-Abfalltonne löscht alles, was hineinkommt. Es gibt auch Tonnen für Flüssigkeiten und Energie. Praktisch am Ende einer Farm."
	]
	quest.19B5589CDF3FB20B.title: "Mülleimer"
	quest.19C176FBD3F3532D.quest_desc: [
		"Graphit schmilzt du aus Kohle oder Holzkohle. Es steckt im Gehäuse und in den Brennstäben."
	]
	quest.19C176FBD3F3532D.title: "Graphit"
	quest.19C3894257545A7F.quest_desc: [
		"Lädt Items mit Strom auf, zum Beispiel Eisen zu Überladenem Eisen."
	]
	quest.19C3894257545A7F.title: "Energiser"
	quest.19C406FCFAC4A841.quest_desc: [
		"Mehrere Einheiten zusammen bilden ein großes Rezeptfeld. Manche Rezepte gehen nur hier.\n\nMit dem Schraubenschlüssel stellst du die Laufrichtung der Items ein."
	]
	quest.19C406FCFAC4A841.title: "Mechanische Handwerkseinheit"
	quest.19C8BA7A3D349C27.quest_desc: [
		"Erweiterte Gravurmaschine und erweitertes Ladegerät arbeiten mehrere Items parallel ab."
	]
	quest.19C8BA7A3D349C27.title: "Schnellere Maschinen"
	quest.19CA8C82F49839D1.quest_desc: [
		"Ein Jetpack aus Stuff 'N Additions, auch als Brustpanzer tragbar. Treibstoff und Bedienung stehen im Tooltip."
	]
	quest.19CA8C82F49839D1.title: "Messing-Jetpack"
	quest.19D34D116F012E7D.quest_desc: [
		"Mit Apotheosis hat der Zaubertisch drei Werte: &eEterna&r (maximale Stufe), &eQuanta&r (Zufall) und &eArcana&r (seltene Verzauberungen). Jedes Regal ändert sie.\n\nMit besseren Regalen kommst du weit über Stufe 30."
	]
	quest.19D34D116F012E7D.title: "Mehr als nur Regale"
	quest.19D6151CFFD0A61E.quest_desc: [
		"Create Ore Excavation: Der Aderfinder zeigt dir, ob unter einem Chunk eine Erzader liegt."
	]
	quest.19D6151CFFD0A61E.title: "Erzadern"
	quest.19EA9F972D6A24E1.quest_desc: [
		"Honigglasierter Schinken: eines der aufwendigsten Gerichte. Du bist jetzt ein echter Koch!"
	]
	quest.19EA9F972D6A24E1.title: "Meisterkoch"
	quest.19EC9551771F72F0.quest_desc: [
		"Ein schneller Ofen, der mit Upgrades noch schneller wird."
	]
	quest.19EC9551771F72F0.title: "Essenzofen"
	quest.19F12DA719873012.quest_desc: [
		"Mit &eWyvern-Injektoren&r schaffst du die nächste Fusionsstufe. Am besten gleich mehr als vier bauen."
	]
	quest.19F12DA719873012.title: "Wyvern-Injektoren"
	quest.19FAC5BC8EF36C87.quest_desc: [
		"Tempel in der Taiga, im Ozean und in jedem Nether-Biom. Einer davon reicht."
	]
	quest.19FAC5BC8EF36C87.title: "Neue Tempel"
	quest.1A00A9B68BB26152.quest_desc: [
		"Djinnis sind stärker als Foliots. Mit einem gebundenen Djinni-Buch kannst du sie beschwören und sie mächtigere Dinge herstellen lassen."
	]
	quest.1A00A9B68BB26152.title: "Djinni binden"
	quest.1A218ED3324C8F95.quest_desc: [
		"Mit 15 Bücherregalen erreichst du die höchste Stufe am Zaubertisch."
	]
	quest.1A218ED3324C8F95.title: "Bücherregale"
	quest.1A26B241DE5F7688.quest_desc: [
		"Der fortgeschrittene Schaltkreis öffnet die nächste Stufe Maschinen."
	]
	quest.1A26B241DE5F7688.title: "Fortgeschritten"
	quest.1A2B6CB9E5CFCCE3.quest_desc: [
		"ExtendedAE bringt einen neuen Kristall: &eEntro&r. Er wächst ähnlich wie Certus an knospenden Blöcken. Die genauen Wege dorthin zeigt dir EMI.\n\nAus Entro-Staub, Gold und Lapis wird ein Entro-Barren."
	]
	quest.1A2B6CB9E5CFCCE3.title: "Entro"
	quest.1A3B194466340C81.quest_desc: [
		"Bau einen Monsterspawner ab, mit etwas Glück bekommst du einen kaputten Spawner. Im Seelenbinder bekommt er einen Mob, dann spawnt er mit Strom."
	]
	quest.1A3B194466340C81.title: "Energiebetriebener Spawner"
	quest.1A464377E86A977C.quest_desc: [
		"Die höchste Stufe: Nitro-Kristalle aus einem Netherstern, Redstone-Blöcken und Lohenkristallblöcken. Dafür musst du einen Wither besiegen."
	]
	quest.1A464377E86A977C.title: "Nitro"
	quest.1A67D31874C1DCC4.quest_desc: [
		"In der &ePresse&r (Squeezer) springst du auf Menril-Holz und bekommst &eMenril-Harz&r. Im &eTrockenbecken&r wird das Harz fest."
	]
	quest.1A67D31874C1DCC4.title: "Presse und Becken"
	quest.1A75E8EF2409DDB0.quest_desc: [
		"Create: Enchantable Machinery erlaubt Verzauberungen auf Maschinen wie Bohrer, Säge oder Lüfter, z. B. Effizienz oder Glück. Welche gehen, zeigt das Tooltip.\n\nHak ab, wenn du es ausprobiert hast."
	]
	quest.1A75E8EF2409DDB0.title: "Verzauberte Maschinen"
	quest.1A78C87B4D7762D9.quest_desc: [
		"Der umgekehrte Weg: Strom rein, Rotation raus. Die Drehzahl stellst du am Motor ein."
	]
	quest.1A78C87B4D7762D9.title: "Elektromotor"
	quest.1A83BF3C5955F39E.quest_desc: [
		"Baue einen Portalrahmen wie beim Nether, aber aus &eGlowstone-Blöcken&r. Dann einen Eimer Wasser hineinkippen."
	]
	quest.1A83BF3C5955F39E.title: "Himmelsportal"
	quest.1A845B89F73C6C90.quest_desc: [
		"Der &eAtomare Rekonstruktor&r schießt einen Laser in Blickrichtung und verwandelt Blöcke und Items, die davor liegen. Er braucht Strom."
		""
		"Rezepte im Handbuch (Actually Additions Manual) oder in EMI."
	]
	quest.1A845B89F73C6C90.title: "Atomarer Rekonstruktor"
	quest.1A84AF0E13D42CB9.quest_desc: [
		"Steuert bis zu sechs Redstone-Verbindungen aus der Hand."
	]
	quest.1A84AF0E13D42CB9.title: "Fernsteuerung"
	quest.1A8E248A3B858538.quest_desc: [
		"Für den Afrit kommen graue und orange Kreide dazu. Was genau hinein muss, steht im Wörterbuch."
	]
	quest.1A8E248A3B858538.title: "Kreide für Afrits"
	quest.1A9050191D4645C0.quest_desc: [
		"Der Enderkristall kommt aus dem Seelenbinder. Mit dem Stab teleportierst du dich ein Stück in Blickrichtung oder zu Reiseankern."
	]
	quest.1A9050191D4645C0.title: "Stab des Reisenden"
	quest.1AC96D5EA93ADCFA.quest_desc: [
		"In der Welt stehen Türme von Magiern. Besieg den Pyromanten und plündere den Turm."
	]
	quest.1AC96D5EA93ADCFA.title: "Pyromanten-Turm"
	quest.1AFEABA4FBBF9E24.quest_desc: [
		"Tief in der Bumblezone wohnt die &eBee Queen&r. Sie tauscht wertvolle Dinge gegen Bienen-Items, aber greif sie bloß nicht an. In ihrer Nähe findest du auch Gelée Royale."
	]
	quest.1AFEABA4FBBF9E24.title: "Die Bienenkönigin"
	quest.1B04A35ABC0FD1B9.quest_desc: [
		"Hier zündest du Rituale. Leg das Ritual-Item hinein und versorg das Becken mit Quelle. Viele Rituale brauchen farbiges Archwood."
	]
	quest.1B04A35ABC0FD1B9.title: "Ritual-Kohlenbecken"
	quest.1B0A734023FA31FE.quest_desc: [
		"Die Hydra lebt in Sümpfen. Abgeschlagene Köpfe wachsen nach, also schnell und hart zuschlagen."
	]
	quest.1B0A734023FA31FE.title: "Hydra"
	quest.1B1CDB8EE4B6A8F9.quest_desc: [
		"Hackfleisch machst du aus Rindfleisch mit dem Messer, daraus brätst du die Bulette."
	]
	quest.1B1CDB8EE4B6A8F9.title: "Hamburger"
	quest.1B2917D4769CDB65.quest_desc: [
		"Die Amboss-Variante des Lohenbrenners. Was er genau kann, steht in EMI."
	]
	quest.1B2917D4769CDB65.title: "Lohen-Schmied"
	quest.1B304D990F679220.quest_desc: [
		"Die &eAssembly Line&r bohrt und lasert Items automatisch, z. B. für Spezialteile. Für den Anfang nicht nötig."
	]
	quest.1B304D990F679220.title: "Fließband"
	quest.1B3BB8BD21C0FE73.quest_desc: [
		"MV-Kabel tragen mehr Strom. Zwischen LV und MV gehört ein Trafo."
	]
	quest.1B3BB8BD21C0FE73.title: "Elektrumkabel (MV)"
	quest.1B4D5AB2FB2387BD.quest_desc: [
		"Wandelt Mob-Drops in Seelen um und füllt damit Seelenurnen."
	]
	quest.1B4D5AB2FB2387BD.title: "Seelenextraktor"
	quest.1B58A70D208E741B.quest_desc: [
		"Wie der Basisprozessor, nur mit Gold."
	]
	quest.1B58A70D208E741B.title: "Verbesserter Prozessor"
	quest.1B72E9BA80BD5B97.quest_desc: [
		"In jedem Ozeanmonument leben drei Große Wächter. Sie geben dir Abbaulähmung, bis alle besiegt sind.\n\nMilch hebt den Effekt kurz auf, Wasseratmung hilft beim Tauchen."
	]
	quest.1B72E9BA80BD5B97.title: "Großer Wächter"
	quest.1B7651ABDF440D26.quest_desc: [
		"Stufe 4: Gold, Lapis und Erfahrung."
	]
	quest.1B7651ABDF440D26.title: "Imperium"
	quest.1B7F6F71FA73906B.quest_desc: [
		"Aus Bienenstacheln baust du einen Speer, der Gift verursacht."
	]
	quest.1B7F6F71FA73906B.title: "Stachelspeer"
	quest.1B8368B9094FFFD9.quest_desc: [
		"Kopiert Bücher, auch verzauberte, mit Erfahrung als Tinte."
	]
	quest.1B8368B9094FFFD9.title: "Drucker"
	quest.1B836FC682280E43.quest_desc: [
		"Spawnt Mobs mit Spawn-Flüssigkeit und Rotation. Der Beutesammler holt die Drops direkt ab. Details in EMI."
	]
	quest.1B836FC682280E43.title: "Mechanischer Spawner"
	quest.1B965833FC5D3E92.quest_desc: [
		"Gehärtete Blutscherben brauchst du für den Blutinfusionskern. Wie man sie bekommt, steht im Handbuch und in EMI."
	]
	quest.1B965833FC5D3E92.title: "Gehärtetes Blut"
	quest.1B9975F32697473A.quest_desc: [
		"Create Deco, Design n' Decor und Interiors: Laufstege, Kessel-Optik, Sitze und vieles mehr."
	]
	quest.1B9975F32697473A.title: "Deko für Ingenieure"
	quest.1BBD56043151838D.quest_desc: [
		"Die Anima-Essenz braucht einen Witherskelett-Schädel. Sie ist eine Zutat für das Meisterzeichen."
	]
	quest.1BBD56043151838D.title: "Anima-Essenz"
	quest.1BC0CF46A3721848.quest_desc: [
		"Die Turbine wandelt Dampf aus dem Reaktor in sehr viel Strom um. Die Spulen um die Welle bestimmen, wie viel."
	]
	quest.1BC0CF46A3721848.title: "Turbine"
	quest.1BC3B0B7DBAA677C.quest_desc: [
		"Gib 32 Stahlblatt ab."
	]
	quest.1BC3B0B7DBAA677C.title: "Abgabe: Stahlblatt"
	quest.1BC417CD47C56209.quest_desc: [
		"Ab hier geht es in Millionen: 1M, 4M, 16M, 64M und 256M. Damit ist Speicherplatz kein Thema mehr."
	]
	quest.1BC417CD47C56209.title: "MEGA-Zellen"
	quest.1BE545D34AEED331.quest_desc: [
		"Gib 64 Netherquarz ab und bekomm dafür eine seltene Kiste."
	]
	quest.1BE545D34AEED331.title: "Abgabe: Netherquarz"
	quest.1BF0DD5A6EEC8892.quest_desc: [
		"Der Speicherbus bindet eine Kiste, Schublade oder Tonne ins Netz ein. Die Schnittstelle hält Items vorrätig und reicht sie heraus."
	]
	quest.1BF0DD5A6EEC8892.title: "Speicherbus und Schnittstelle"
	quest.1C1A55D78CB34917.quest_desc: [
		"Der Wärmegenerator verbrennt Brennstoff oder nutzt Lava in der Nähe. Für den Anfang reicht das."
	]
	quest.1C1A55D78CB34917.title: "Erster Strom"
	quest.1C334A1A455B5364.quest_desc: [
		"Funk für Redstone: zwei Links mit denselben Items als Frequenz sind verbunden."
	]
	quest.1C334A1A455B5364.title: "Redstone-Verbindung"
	quest.1C5A4F3B970A2D6D.quest_desc: [
		"Eine Ablage für ein Item. Ideal unter der Presse oder für den Mechanischen Arm."
	]
	quest.1C5A4F3B970A2D6D.title: "Depot"
	quest.1C63D9F122E6846F.quest_desc: [
		"Im &eProgrammierer&r baust du das Programm für deine Drohne aus Puzzle-Teilen zusammen. Ausprobieren lohnt sich!"
		""
		"Damit hast du PneumaticCraft durch. Glückwunsch!"
	]
	quest.1C63D9F122E6846F.title: "Programmierer"
	quest.1C7435810EDA9579.quest_desc: [
		"Transistoren und Kondensatoren brauchst du für jede fertige Platine."
	]
	quest.1C7435810EDA9579.title: "Bauteile"
	quest.1C7999CDD98769BB.quest_desc: [
		"Dank Corpse bleibt bei deinem Tod ein Leichnam mit all deinen Items liegen. Rechtsklick darauf öffnet ihn."
		""
		"Lauf einfach zum Todes-Wegpunkt auf der Karte zurück."
	]
	quest.1C7999CDD98769BB.title: "Gestorben? Kein Drama"
	quest.1C79DC94AE450181.quest_desc: [
		"Rechtsklick mit Packband auf eine Truhe, dann kannst du sie samt Inhalt abbauen und mitnehmen."
	]
	quest.1C79DC94AE450181.title: "Packband"
	quest.1C83F978776BE561.quest_desc: [
		"Fast das Maximum. Netherit setzt du am Schmiedetisch obendrauf."
	]
	quest.1C83F978776BE561.title: "Diamantrucksack"
	quest.1C87AA0185D2E61D.quest_desc: [
		"Einfrieren macht Wasser zu Eis und verlangsamt Gegner, Kälteeinbruch richtet Schaden an."
	]
	quest.1C87AA0185D2E61D.title: "Frost-Glyphen"
	quest.1C8A1DFAD379DFE0.quest_desc: [
		"Mit Bohrkopf und Rotation fördert die Maschine Erz aus der Ader, sehr lange. Bessere Bohrköpfe gibt es aus Diamant und Netherit."
	]
	quest.1C8A1DFAD379DFE0.title: "Bohrmaschine"
	quest.1C8E616AFF579FE2.quest_desc: [
		"Mit Zugangspunkt und drahtloser Konsole greifst du aus der Ferne auf dein Netz zu. Konsole im Zugangspunkt verknüpfen nicht vergessen."
	]
	quest.1C8E616AFF579FE2.title: "Drahtloser Zugriff"
	quest.1CA745CD3E99720A.quest_desc: [
		"Ein Festmahl stellst du als Block auf den Tisch. Rechtsklick mit einer Schüssel nimmt dir eine Portion ab."
		""
		"Perfekt, wenn mehrere Leute mitessen."
	]
	quest.1CA745CD3E99720A.title: "Festmahl"
	quest.1CA7DCEAC7A781EF.quest_desc: [
		"Gib 32 Silberbarren ab."
	]
	quest.1CA7DCEAC7A781EF.title: "Abgabe: Silber"
	quest.1CB33146E5529A24.quest_desc: [
		"Verbrauchter Brennstoff kommt als Cyanit aus dem Zugangsport. Wirf es nicht weg, du brauchst es für die Turbine."
	]
	quest.1CB33146E5529A24.title: "Cyanit"
	quest.1CBE53EC1D152975.quest_desc: [
		"Zermahlt Erze, Kies und mehr. Rohe Erze werden zu zerkleinertem Erz, oft mit Bonus."
	]
	quest.1CBE53EC1D152975.title: "Mahlstein"
	quest.1CC1D6A8C9DBFAF2.quest_desc: [
		"Smaragde aufladen ergibt beseelte Kristalle. Ab hier wird es richtig stromhungrig."
	]
	quest.1CC1D6A8C9DBFAF2.title: "Beseelter Kristall"
	quest.1CC7D9062E1E24AA.quest_desc: [
		"Eisenbarren plus Feuerblut. Feuerwerkzeuge schmelzen abgebaute Erze sofort, die Feuerrüstung schützt vor Flammen."
	]
	quest.1CC7D9062E1E24AA.title: "Feuerbarren"
	quest.1CD962677669B77C.quest_desc: [
		"Addons setzt du direkt an Maschinen: Speed macht sie schneller, Efficiency sparsamer. Die Vorschau zeigt dir die freien Plätze."
	]
	quest.1CD962677669B77C.title: "Maschinen-Addons"
	quest.1CE814D9BF333219.quest_desc: [
		"Leitet Rotation um die Ecke, in alle vier Richtungen."
	]
	quest.1CE814D9BF333219.title: "Getriebe"
	quest.1CF1101E50137448.quest_desc: [
		"Mit dem &eBohrkern&r baust du den Bohrer, ein strombetriebenes Abbauwerkzeug mit Upgrades wie 3x3 oder Behutsamkeit."
	]
	quest.1CF1101E50137448.title: "Bohrer"
	quest.1CF1DCB1CC1D0A6D.quest_desc: [
		"Der Lich wohnt ganz oben in seinem Turm. Erst seine Schilde zerstören, dann kannst du ihn treffen. Er lässt mächtige Zepter fallen."
	]
	quest.1CF1DCB1CC1D0A6D.title: "Der Lich"
	quest.1D1F09CA11FC97B5.quest_desc: [
		"Ballonhüllen und ein Brenner darunter: So hebt dein Luftschiff ab."
	]
	quest.1D1F09CA11FC97B5.title: "Heißluftballon"
	quest.1D2236EF868ED48C.quest_desc: [
		"Der Oberste Knochenrufer ruft ständig Skelette herbei. Schalte ihn schnell aus, bevor es zu viele werden."
	]
	quest.1D2236EF868ED48C.title: "Oberster Knochenrufer"
	quest.1D26F72F6DBC19D7.quest_desc: [
		"Create: New Age erzeugt Strom über Magnete, die sich an Generatorspulen vorbeidrehen.\n\nDen genauen Aufbau zeigt das Ponder: Halte &eW&r über dem Item."
	]
	quest.1D26F72F6DBC19D7.title: "New Age: Generator"
	quest.1D2EAD14940A49AD.quest_desc: [
		"Der erste Generator: verbrennt alles, was auch im Ofen brennt."
	]
	quest.1D2EAD14940A49AD.title: "Furnator"
	quest.1D3581A9F2F34D8D.quest_desc: [
		"Die Zuchtkammer kreuzt Bienen aus Käfigen automatisch."
	]
	quest.1D3581A9F2F34D8D.title: "Zuchtkammer"
	quest.1D489855FBADB1AB.quest_desc: [
		"&cStrahlung ist in Mekanism echt&r und kann dich töten. Der Schutzanzug schützt, der Geigerzähler warnt."
	]
	quest.1D489855FBADB1AB.title: "Strahlenschutz"
	quest.1D503382AB21F5FB.quest_desc: [
		"Wähle ein Biom aus der Liste und der Kompass zeigt dir den Weg dorthin."
	]
	quest.1D503382AB21F5FB.title: "Kompass der Natur"
	quest.1D57D614AA2C996E.quest_desc: [
		"Für den Regler brauchst du Silikon, Soularium und einen Zombiekopf. Köpfe gibt es zum Beispiel mit \"Der Ender\"."
	]
	quest.1D57D614AA2C996E.title: "Z-Logik-Regler"
	quest.1D6E6C7067F13890.quest_desc: [
		"Weißkohl, Tomaten und Zwiebeln wachsen wild in der Welt. Abbauen, Samen bzw. die Frucht selbst wieder einpflanzen."
	]
	quest.1D6E6C7067F13890.title: "Wilde Pflanzen"
	quest.1D7F87AEDA928296.quest_desc: [
		"Gib 64 Kunststoff ab."
	]
	quest.1D7F87AEDA928296.title: "Abgabe: Kunststoff"
	quest.1D95054BA8C73FAB.quest_desc: [
		"Dieser Infusionskristall geht nie kaputt."
	]
	quest.1D95054BA8C73FAB.title: "Meister-Infusionskristall"
	quest.1DAFDACC4D290960.quest_desc: [
		"Mit Stufen-Upgrades wertest du eine schon platzierte Truhe auf, ohne sie auszuräumen. Einfach Rechtsklick auf die Truhe."
	]
	quest.1DAFDACC4D290960.title: "Aufwerten vor Ort"
	quest.1DB4B00CAF05C952.quest_desc: [
		"Ein Zauberturm wirkt einen Zauber, wenn er ein Redstone-Signal bekommt. Den Zauber gibst du ihm mit deinem Buch."
	]
	quest.1DB4B00CAF05C952.title: "Zauberturm"
	quest.1DBFAF957721B055.quest_desc: [
		"Mit einem Seelenedelstein fängst du ein Tier oder Monster ein und lässt es woanders wieder frei."
	]
	quest.1DBFAF957721B055.title: "Seelenedelstein"
	quest.1DC15E4D98B9576B.quest_desc: [
		"Der Invoker von Illager Invasion ist ein mächtiger Magier. Er beschwört Fangzähne und Helfer und kann sich schützen."
	]
	quest.1DC15E4D98B9576B.title: "Der Invoker"
	quest.1DC1B8F0F44B6685.quest_desc: [
		"Der &eLuftkompressor&r verbrennt Brennstoff wie ein Ofen und erzeugt Druckluft. Gib die Luft über Druckrohre an deine Maschinen weiter."
		""
		"Tipp: Ein Manometer zeigt dir den Druck an."
	]
	quest.1DC1B8F0F44B6685.title: "Luftkompressor"
	quest.1DE0998C17BA806E.quest_desc: [
		"Die Wyvern-Werkzeuge werden mit Erwachtem Draconium und Netherit zu &eDraconic-Werkzeugen&r: mehr Energie, mehr Modulplätze."
	]
	quest.1DE0998C17BA806E.title: "Draconic-Werkzeug"
	quest.1DF98BD3858BF0B7.quest_desc: [
		"Antiker Schrott liegt tief im Nether. Er widersteht Explosionen, Betten oder TNT helfen beim Suchen."
		""
		"Vier Netheritplatten und vier Gold ergeben einen Barren. Die Schmiedevorlage findest du in Bastionen."
	]
	quest.1DF98BD3858BF0B7.title: "Netherit"
	quest.1DFEE9707AC17678.quest_desc: [
		"Das &eBook of Shadows&r ist das Handbuch von Hexerei. Leg es auf einen Altar, dann schweben Kerzen drumherum."
	]
	quest.1DFEE9707AC17678.title: "Buch der Schatten"
	quest.1E0AAEDF3F6656A4.quest_desc: [
		"Die zweite Stufe. Vier Inferium-Essenzen um den Infusionskristall ergeben ein Prudentium."
	]
	quest.1E0AAEDF3F6656A4.title: "Prudentium"
	quest.1E32F5A22576B9FA.quest_desc: [
		"Kohle findest du überall im Stein. Sie ist Brennstoff für den Ofen und wird zu Fackeln."
		""
		"Fackeln halten Monster fern. Dunkle Stellen sind gefährlich. Notfalls tut es auch Holzkohle aus dem Ofen."
	]
	quest.1E32F5A22576B9FA.title: "Kohle"
	quest.1E36FFA16697E398.quest_desc: [
		"Nur damit kannst du Obsidian abbauen."
	]
	quest.1E36FFA16697E398.title: "Diamantspitzhacke"
	quest.1E39A0EDF93D44EC.quest_desc: [
		"Am Inschriftentisch schreibst du Schriftrollen in dein Zauberbuch."
	]
	quest.1E39A0EDF93D44EC.title: "Inschriftentisch"
	quest.1E55C50AEABD99DF.quest_desc: [
		"Der Clibano ist ein großer Ofen aus Darkstone. Bau ihn um den Kern und aktiviere ihn mit Mundabitur-Staub. Er schmilzt schneller und doppelt manche Erze."
	]
	quest.1E55C50AEABD99DF.title: "Clibano"
	quest.1E7224B5EF4D924C.quest_desc: [
		"Quarz, Glowstone und Obsidian ohne Nether-Ausflüge."
	]
	quest.1E7224B5EF4D924C.title: "Stufe 3: Nether"
	quest.1E7440CF5DCBCC53.quest_desc: [
		"Mit der &eOtherworld Goggles&r siehst du Anderswelt-Blöcke dauerhaft, ganz ohne Dämonentraum. Die Linsen stellt ein Foliot im Ritual her."
	]
	quest.1E7440CF5DCBCC53.title: "Anderswelt-Brille"
	quest.1E78EFD273E9ED92.quest_desc: [
		"Steam 'n' Rails: Damit kannst du Züge auf der Strecke automatisch kuppeln und trennen."
	]
	quest.1E78EFD273E9ED92.title: "Zugkuppler"
	quest.1E8370E3F18E32D3.quest_desc: [
		"Macht aus Barren Staub und aus Pflanzen Biobrennstoff."
	]
	quest.1E8370E3F18E32D3.title: "Zerkleinerer"
	quest.1EAC32C70D516D58.quest_desc: [
		"Eine Konsole mit eingebauter Werkbank. Rezepte greifen direkt auf das Netzwerk zu."
	]
	quest.1EAC32C70D516D58.title: "Fertigungskonsole"
	quest.1EC196EC8629D11F.quest_desc: [
		"Rahmen aus Obsidian (4 breit, 5 hoch), mit Feuerzeug anzünden, rein.\n\n&cGold-Rüstung tragen&r, sonst greifen dich die Piglins an. Betten explodieren hier!"
	]
	quest.1EC196EC8629D11F.title: "Ab in den Nether"
	quest.1EC4215438DB91EA.quest_desc: [
		"Supplementaries, Amendments und Quark bringen viele kleine Extras: Säcke, Seile, Gläser, Laternen an der Wand und mehr."
		""
		"Stöber einfach mal in EMI."
	]
	quest.1EC4215438DB91EA.title: "Kleinkram"
	quest.1EC673AA249703B5.quest_desc: [
		"Netherit-Spitzhacke, Vorlage und Barren in den Schmiedetisch. Damit baust du auch Vibranium ab."
	]
	quest.1EC673AA249703B5.title: "Allthemodium-Spitzhacke"
	quest.1ED6879F6E4AFA8C.quest_desc: [
		"Wolle plus Arkane Essenz. Für Bücher und Magier-Roben."
	]
	quest.1ED6879F6E4AFA8C.title: "Arkanes Tuch"
	quest.1EDC12F3B3E54499.quest_desc: [
		"Die Gravurmaschine presst mit den Drucken Schaltkreise. Oben Druck, Mitte Material, unten Druck."
	]
	quest.1EDC12F3B3E54499.title: "Gravurmaschine"
	quest.1EF8BE6697CB5F01.quest_desc: [
		"Die Wither-Maschine haust in der Alten Fabrik. Folge dem &eMechanischen Auge&r.\n\nPass auf seine Laser und Raketen auf und bleib in Bewegung."
	]
	quest.1EF8BE6697CB5F01.title: "Der Harbinger"
	quest.1EF97AFEAA13474C.quest_desc: [
		"Eine riesige Spinne mit vielen Kindern. Flächenschaden hilft gegen die Kleinen."
	]
	quest.1EF97AFEAA13474C.title: "Spinnenmutter"
	quest.1F136C42AC62937F.quest_desc: [
		"Der &eEmpowerer&r mit vier Displayständen drumherum lädt Kristalle auf. Die Zutaten kommen auf die Ständer."
	]
	quest.1F136C42AC62937F.title: "Empowerer"
	quest.1F1C042A7A40101C.quest_desc: [
		"Traveler's Backpack: ein Rucksack mit zwei Flüssigkeitstanks und eingebautem Schlafsack."
		""
		"Es gibt ihn in vielen Designs mit kleinen Spezialfähigkeiten. Schau in EMI."
	]
	quest.1F1C042A7A40101C.title: "Reiserucksack"
	quest.1F4BA91A5354A3E5.quest_desc: [
		"Mit Raumpylonen und dem IO-Raumport speicherst du einen ganzen Bereich der Welt in einer Zelle. Probier es erst mit 2³ aus."
	]
	quest.1F4BA91A5354A3E5.title: "Raumspeicher"
	quest.1F54F34B84AFEB20.quest_desc: [
		"Der Alpha-Yeti lässt Eisbomben fallen. Werfen, und Gegner frieren ein."
	]
	quest.1F54F34B84AFEB20.title: "Eisbomben"
	quest.1F599823FE146B2E.quest_desc: [
		"Logik (Gold), Kalkulation (Certus) und Konstruktion (Diamant). Gedruckter Schaltkreis + Redstone + Gedrucktes Silizium in der Gravurmaschine ergeben den fertigen Prozessor.\n\nAb jetzt steht dir AE2 offen."
	]
	quest.1F599823FE146B2E.title: "Drei Prozessoren"
	quest.1F5F44EF8CE2AD9D.quest_desc: [
		"Create: Power Loader. Angetrieben hält er Chunks geladen, damit deine Fabrik weiterläuft. Wie du den leeren Lader aktivierst, zeigt EMI."
	]
	quest.1F5F44EF8CE2AD9D.title: "Chunk-Lader"
	quest.1F7FD88943AE51EE.quest_desc: [
		"Am Bergungstisch zerlegst du Affix-Ausrüstung in Seltenheitsmaterial und Edelsteine in Staub."
	]
	quest.1F7FD88943AE51EE.title: "Bergungstisch"
	quest.1F868B8827B840D3.quest_desc: [
		"Der &eTome of Scrapping&r zieht im Amboss zufällige Verzauberungen von einem Gegenstand auf ein Buch. Der Gegenstand geht dabei kaputt."
	]
	quest.1F868B8827B840D3.title: "Wälzer"
	quest.1F8F5E949755C93F.quest_desc: [
		"&eArs Additions&r: Ein Quellglas, das mit anderen Ender-Quellgläsern verbunden ist."
	]
	quest.1F8F5E949755C93F.title: "Ender-Quellglas"
	quest.1F981F019E755E9B.quest_desc: [
		"Fischfilet kannst du roh essen, gebraten ist es aber deutlich besser."
	]
	quest.1F981F019E755E9B.title: "Fischfilet"
	quest.1FA2CFADA061BB61.quest_desc: [
		"Steam 'n' Rails bringt Schmal- und Breitspur sowie Gleise aus allen Holzarten. Schmalspur braucht eigene Drehgestelle."
	]
	quest.1FA2CFADA061BB61.title: "Andere Spurweiten"
	quest.1FAC05C1DB64153C.quest_desc: [
		"Fast jede Klassen-Rüstung lässt sich mit Netherit aufwerten. Hier am Beispiel der Berserker-Brust."
	]
	quest.1FAC05C1DB64153C.title: "Netherit-Berserker"
	quest.1FBBCB16921A24DA.quest_desc: [
		"Sechs Phantomritter in der Ritterfestung im Dunklen Wald. Vorher musst du den Weg dorthin freikämpfen."
	]
	quest.1FBBCB16921A24DA.title: "Die Phantomritter"
	quest.1FBD683FACBFFFFA.quest_desc: [
		"Die Sockel stellst du rund um die Schmiede. Darauf legst du die Zutaten für ein Ritual."
	]
	quest.1FBD683FACBFFFFA.title: "Darkstone-Sockel"
	quest.1FBF805FF643FE5E.quest_desc: [
		"Ein eisiger Planet in einem anderen Sternensystem. Mit Luft zum Atmen, aber bitterkalt."
	]
	quest.1FBF805FF643FE5E.title: "Glacio"
	quest.1FC7FED593FEA3E7.quest_desc: [
		"Mit dem Schraubenschlüssel drehst und baust du AE2-Blöcke ohne Verlust ab. Die Spitzhacke ist eher ein Andenken."
	]
	quest.1FC7FED593FEA3E7.title: "Quarzwerkzeug"
	quest.1FC8CFA4D67DB93B.quest_desc: [
		"&ePrometheum&r ist das Endgame-Material von Oritech, geschmiedet in der Atomschmiede."
		""
		"Daraus entstehen der Ultimative Maschinenkern und Prometheum-Werkzeuge. Glückwunsch!"
	]
	quest.1FC8CFA4D67DB93B.title: "Prometheum"
	quest.1FD95E8E6E9D6743.quest_desc: [
		"Mit dem &eErweckungsaltar&r erweckst du Supremium. Die vier Essenzurnen füllst du mit Element-Essenzen (Luft, Erde, Wasser, Feuer)."
	]
	quest.1FD95E8E6E9D6743.title: "Erweckungsaltar"
	quest.1FDE1E4FA0AD0A78.quest_desc: [
		"Die Vorlage ist die Basis für alle Schubladen-Upgrades."
	]
	quest.1FDE1E4FA0AD0A78.title: "Aufrüstungsvorlage"
	quest.1FDF9CAE6A7FC3AC.quest_desc: [
		"&eArs Creo&r: Ein Starbuncle rennt im Rad und treibt so Create-Maschinen an."
	]
	quest.1FDF9CAE6A7FC3AC.title: "Starbuncle-Rad"
	quest.3003D4F01D4C3FEC.quest_desc: [
		"Ein Luftschiff hoch über den Wolken. Elytra oder viele Blöcke helfen beim Hinkommen."
	]
	quest.3003D4F01D4C3FEC.title: "Himmlischer Eroberer"
	quest.30067A579304F035.quest_desc: [
		"Die beheizte Zentrifuge schmilzt Waben direkt ein und ist die schnellste. Du brauchst dafür ein inaktives Drachenei."
	]
	quest.30067A579304F035.title: "Beheizte Zentrifuge"
	quest.301C6DD472398C83.quest_desc: [
		"Eine 256M-Komponente von MEGA Cells. Damit ist Speicherplatz kein Thema mehr."
	]
	quest.301C6DD472398C83.title: "Datenspeicher ohne Ende"
	quest.30222622A574FD14.quest_desc: [
		"Den Miner legst du in den &eDimensional Mineshaft&r. Dort gräbt er in einer eigenen Dimension und spuckt Erze aus."
	]
	quest.30222622A574FD14.title: "Dimensionaler Schacht"
	quest.3026C84F88504228.quest_desc: [
		"An diesem Tisch baust du mit Blaupausen Formen, Patronen und Bauteile."
	]
	quest.3026C84F88504228.title: "Ingenieursarbeitstisch"
	quest.302A5D5ACDA0595F.quest_desc: [
		"Speichert Druckluft. Gesetzt und angetrieben füllt er sich auf. Er versorgt Taucherhelm, Kartoffelkanone und Jetpacks."
	]
	quest.302A5D5ACDA0595F.title: "Rückentank"
	quest.3033B791D8CE1E86.quest_desc: [
		"Die SAG-Mühle mahlt Erz zu Pulver, oft mit Bonus. Mit Mahlkugeln wird sie noch besser."
	]
	quest.3033B791D8CE1E86.title: "SAG-Mühle"
	quest.304646EF3627A574.quest_desc: [
		"Der Ur-Ghast weint Feuertränen. Sie ersetzen beim Feuerbarren das Feuerblut."
	]
	quest.304646EF3627A574.title: "Feuertränen"
	quest.304C3D6D1CD29642.quest_desc: [
		"Edelholz wächst nicht einfach so. Einen &eEdelholz-Setzling&r verkauft dir manchmal der fahrende Händler. Alternativ wendest du eine Corrupt Soul auf einen Eichensetzling an.\n\nAus dem Holz machst du Utrem-Gläser und Edelholz-Eimer."
	]
	quest.304C3D6D1CD29642.title: "Edelholz"
	quest.306D141C17CAB9C6.quest_desc: [
		"Die untote Piratenkapitänin ist der Boss von Aquamirae. Du rufst sie mit dem &eMuschelhorn&r.\n\nSie hat starke Ausrüstung dabei, also lohnt sich der Kampf."
	]
	quest.306D141C17CAB9C6.title: "Captain Cornelia"
	quest.3082E593D92C22AD.quest_desc: [
		"Der Bagger gräbt riesige unterirdische Mineraladern ab, ohne dass du selbst buddeln musst. Damit bist du ein echter Ingenieur."
	]
	quest.3082E593D92C22AD.title: "Bagger"
	quest.308A985C28677FE7.quest_desc: [
		"Der Frostmaw schläft in verschneiten Gebieten. Weck ihn nur, wenn du gut vorbereitet bist.\n\nEr lässt seinen &eEiskristall&r fallen."
	]
	quest.308A985C28677FE7.title: "Frostmaw"
	quest.308B3EC809F987CF.quest_desc: [
		"Der verzauberte Turm kann stärkere Zauber, der Timer-Turm feuert in festen Abständen. Gut für Farmen."
	]
	quest.308B3EC809F987CF.title: "Verzauberter Turm"
	quest.308BE00A58EBCB9A.quest_desc: [
		"Schön, dass du da bist! Dieses Buch führt dich durch das Pack: Create, Magie, Technik, Dimensionen und Bosse."
		""
		"Klick auf das Häkchen, um die Quest abzuschließen, und hol dir unten rechts die Belohnung ab."
	]
	quest.308BE00A58EBCB9A.title: "Willkommen!"
	quest.30B648C5D10F9569.quest_desc: [
		"Refined Storage ist ein Lagernetzwerk wie AE2, nur einfacher: keine Kanäle, und jedes Gerät hängt einfach am Kabel."
		""
		"Alles beginnt mit &eQuarzangereichertem Eisen&r aus Eisen und Netherquarz."
	]
	quest.30B648C5D10F9569.title: "Quarzeisen"
	quest.30DC01E8174B4862.quest_desc: [
		"Mithril, Arkaner Barren und Glut-Essenz. Mit einer Rune wird daraus eine Upgrade-Kugel für eine Schule."
	]
	quest.30DC01E8174B4862.title: "Leere Upgrade-Kugel"
	quest.30F6759816B60874.quest_desc: [
		"Das Herz der Küche. Stell ihn auf eine Hitzequelle (Herd, Lagerfeuer oder Feuer) und koche darin Suppen und Eintöpfe."
		""
		"Manche Gerichte brauchen eine Schüssel als Behälter."
	]
	quest.30F6759816B60874.title: "Kochtopf"
	quest.30FF0BBA0CC059EE.quest_desc: [
		"Du hast den Spawner gefunden? Dann farm ein bisschen und gib 16 Lohenruten ab."
	]
	quest.30FF0BBA0CC059EE.title: "Abgabe: Lohenruten"
	quest.3108B6FC84572873.quest_desc: [
		"Der Importbus zieht Items aus einer Kiste oder Maschine ins Netz, der Exportbus schiebt sie wieder hinaus."
	]
	quest.3108B6FC84572873.title: "Import und Export"
	quest.3126B360E8EDC249.quest_desc: [
		"Eine feurige Essenz für Kessel und Upgrade-Kugeln. Wo du sie bekommst, zeigt EMI."
	]
	quest.3126B360E8EDC249.title: "Glut-Essenz"
	quest.313057252DB3BB90.quest_desc: [
		"Ein großer Multiblock, der aus Dampf jede Menge Strom macht. Dazu gehören noch Spulen, Ventile und Lüftungen; Maße und Aufbau zeigt dir EMI."
	]
	quest.313057252DB3BB90.title: "Industrielle Turbine"
	quest.3150FABF8768263A.quest_desc: [
		"Dreht Blöcke und baut Create-Teile mit Schleichen + Rechtsklick sofort ab."
	]
	quest.3150FABF8768263A.title: "Schraubenschlüssel"
	quest.31510814E5284C5A.quest_desc: [
		"Die nächste Stufe fasst deutlich mehr Energie. Elite- und Ultimative Würfel folgen nach demselben Prinzip."
	]
	quest.31510814E5284C5A.title: "Besserer Würfel"
	quest.31639190C35AB60A.quest_desc: [
		"Der Kochtopf für Monster-Gerichte. Rezepte findest du in EMI."
	]
	quest.31639190C35AB60A.title: "Monstertopf"
	quest.3195E00CDDC74828.quest_desc: [
		"Aus diesen Teilen baust du den Reaktor. &cLies vorher das Ponder:&r Ein überhitzter Reaktor hinterlässt Corium."
	]
	quest.3195E00CDDC74828.title: "Reaktorteile"
	quest.3196EB95F6D8CE56.quest_desc: [
		"Rohes Eisen und Obsidian ergeben im Clibano &eObsidianstahl&r, ein sehr hartes Metall."
	]
	quest.3196EB95F6D8CE56.title: "Obsidianstahl"
	quest.319EAEAC402E339B.quest_desc: [
		"Upgrades machen Maschinen schneller oder sparsamer. Beides zusammen lohnt sich."
	]
	quest.319EAEAC402E339B.title: "Upgrades"
	quest.31A8390F2C2D4039.quest_desc: [
		"Mit legendärer Tinte schreibst du Schriftrollen auf höchster Stufe. Das Ziel jedes Magiers in Iron's Spells."
	]
	quest.31A8390F2C2D4039.title: "Legendäre Tinte"
	quest.31B4707D831488AC.quest_desc: [
		"Aus der Basis werden alle Upgrades für Bienenstöcke und Maschinen."
	]
	quest.31B4707D831488AC.title: "Upgrade-Basis"
	quest.31B7F7D27F7152D1.quest_desc: [
		"Im Ofen wird aus dem rohen Erz ein Barren. Mit Mekanism oder Create holst du mehr aus jedem Erz."
	]
	quest.31B7F7D27F7152D1.title: "Allthemodium-Barren"
	quest.31D1D372986491E1.quest_desc: [
		"Der Sculptor stellt dich auf eine Kletterprüfung. Wer ihn besiegt, bekommt den &eEarthrend Gauntlet&r."
	]
	quest.31D1D372986491E1.title: "Der Sculptor"
	quest.31D2D617B16F3BDF.quest_desc: [
		"Gib 64 Tomaten ab. Dafür gibt es eine seltene Kiste."
	]
	quest.31D2D617B16F3BDF.title: "Abgabe: Tomaten"
	quest.31D36BF564058348.quest_desc: [
		"Der Agronomische Quellenlink erzeugt Quelle, wenn in der Nähe Pflanzen wachsen. Stell ihn neben ein Feld und ein Quellglas."
	]
	quest.31D36BF564058348.title: "Quelle erzeugen"
	quest.31ECFB556A1AB8A0.quest_desc: [
		"Der Herr der Kürbisse ist deutlich stärker als sein Knappe. Nimm Feuerschutz mit."
	]
	quest.31ECFB556A1AB8A0.title: "Lord Pumpkinhead"
	quest.32156F811470D344.quest_desc: [
		"Die Königin der Walküren wohnt im Silber-Dungeon. Sie kämpft erst, wenn du genug &eSiegesmedaillen&r von ihren Walküren hast."
	]
	quest.32156F811470D344.title: "Walkürenkönigin"
	quest.322BE9EC53C9733F.quest_desc: [
		"Kupferdraht auf eine leere Spule gewickelt. Mit Spulen verbindest du Netzanschlüsse zu Stromleitungen."
	]
	quest.322BE9EC53C9733F.title: "Kupferspule"
	quest.32348094415F9EC9.quest_desc: [
		"Upgrades machen Maschinen schneller und vergrößern ihren Bereich."
	]
	quest.32348094415F9EC9.title: "Maschinen-Upgrades"
	quest.323D79A46F9B269E.quest_desc: [
		"Wie die Fabrikanzeige, aber für Flüssigkeiten."
	]
	quest.323D79A46F9B269E.title: "Flüssigkeits-Fabrikanzeige"
	quest.32542EDC850E666B.quest_desc: [
		"Advanced Technologies bringt Mündungsbremsen, Schalldämpfer, gezogene Läufe, Raketen und mehr."
	]
	quest.32542EDC850E666B.title: "Fortgeschrittene Kanonentechnik"
	quest.325D75ECEDF5C763.quest_desc: [
		"Der Bioreaktor macht aus Pflanzen Biokraftstoff, der Biogenerator daraus Strom."
	]
	quest.325D75ECEDF5C763.title: "Biogenerator"
	quest.32603CC8E1038928.quest_desc: [
		"Roben für Ender und Blut."
	]
	quest.32603CC8E1038928.title: "Schatten und Blut"
	quest.3273C2D05BB6E53D.quest_desc: [
		"Gib 64 Quelljuwelen ab und hol dir eine seltene Kiste."
	]
	quest.3273C2D05BB6E53D.title: "Abgabe: Quelljuwelen"
	quest.328BA37BFFEE7F65.quest_desc: [
		"Über einem Becken mischt er Zutaten, etwa Andesitlegierung oder Teig.\n\nManche Rezepte brauchen Hitze unter dem Becken."
	]
	quest.328BA37BFFEE7F65.title: "Mechanischer Mixer"
	quest.3299ADE6777E20B8.quest_desc: [
		"Die Verfallene Zitadelle im End ist eine der gefährlichsten Strukturen im Pack. Wer hier war, hat genug Abenteuer erlebt."
	]
	quest.3299ADE6777E20B8.title: "Verfallene Zitadelle"
	quest.329F70C574BC8504.quest_desc: [
		"Ein Lohenkuchen bringt den Lohenbrenner kurz auf &eÜberhitzt&r. Manche Mixer-Rezepte brauchen das.\n\nDie Basis bekommt im Ausguss Lava."
	]
	quest.329F70C574BC8504.title: "Lohenkuchen"
	quest.32A301062C41A82C.quest_desc: [
		"Insanium aus Mystical Agradditions ist die höchste Stufe der Essenzen."
	]
	quest.32A301062C41A82C.title: "Insanium"
	quest.32A9721AED23B895.quest_desc: [
		"Das &eEisengehäuse&r ist der Rahmen für fast alle Maschinen der Mod."
	]
	quest.32A9721AED23B895.title: "Eisengehäuse"
	quest.32B50C90FFB163B6.quest_desc: [
		"Für Ad Astra brauchst du viel Stahl, z. B. aus dem Etrionischen Hochofen (Eisen plus Kohle). Andere Stahlquellen gehen auch."
	]
	quest.32B50C90FFB163B6.title: "Weltraum-Stahl"
	quest.32B6D3A364BB574F.quest_desc: [
		"Dungeons and Taverns stellt Tavernen in viele Biome. Jede davon zählt. Drinnen kannst du dich ausruhen und handeln."
	]
	quest.32B6D3A364BB574F.title: "Taverne"
	quest.32BACAFCE3E9001E.quest_desc: [
		"Mit einem Upgrade-Ritual (Edelholzbretter, arkane Kristalle, Spawner-Schrott) hebst du die Schmiede auf Stufe 2. Die Anforderungen zeigt EMI unter \"Hephaestus Forge Upgrading\"."
	]
	quest.32BACAFCE3E9001E.title: "Schmiede Stufe 2"
	quest.32C298783B8AFEBE.quest_desc: [
		"Gibt ein Redstone-Signal, wenn ein Item über oder unter einer Menge liegt. Perfekt, um Maschinen nur bei Bedarf laufen zu lassen."
	]
	quest.32C298783B8AFEBE.title: "Füllstandsemitter"
	quest.32C2E5FB45DD0417.quest_desc: [
		"Lohenruten auf der Energiekugel werden zu Lohenkristallen."
	]
	quest.32C2E5FB45DD0417.title: "Lohenkristall"
	quest.32C898E05C3A718D.quest_desc: [
		"Zieht Items aus dem Block darüber und schiebt sie in den Block darunter, mit Filter."
	]
	quest.32C898E05C3A718D.title: "Trichter-Upgrade"
	quest.32CF2A748D16B44F.quest_desc: [
		"New Age kann auch mit Wärme arbeiten: Wärmerohre leiten sie, der Heizer heizt mit Strom."
	]
	quest.32CF2A748D16B44F.title: "Wärme"
	quest.32D3FD22C4EF5720.quest_desc: [
		"Fluix steckt in Kabeln, Kernen und Zellen. Gib 64 Stück ab."
	]
	quest.32D3FD22C4EF5720.title: "Abgabe: Fluix"
	quest.32F634412D508029.quest_desc: [
		"Der Wagen fährt an der Portalkranachse entlang. Mehrere Achsen quer gebaut ergeben einen 3D-Kran."
	]
	quest.32F634412D508029.title: "Portalkran"
	quest.331152F84D7A653A.quest_desc: [
		"Netherquarz mit Redstone ergibt Rosenquarz. Mit Schmirgelpapier in der Hand polierst du ihn."
	]
	quest.331152F84D7A653A.title: "Rosenquarz"
	quest.333283FDAAEDED0B.quest_desc: [
		"Ein seltenes Erz des Undergarden. Wofür du es brauchst, zeigt dir EMI."
	]
	quest.333283FDAAEDED0B.title: "Regalium"
	quest.3337EEE029332007.quest_desc: [
		"Bau die Metallpresse. Mit verschiedenen Formen presst sie Bleche, Stäbe, Drähte und Zahnräder, schneller und billiger als von Hand."
	]
	quest.3337EEE029332007.title: "Metallpresse"
	quest.333E70C6F5E82EEC.quest_desc: [
		"Helvar, der Ritter der Unterwelt, wartet hinter der Arenatür. Dafür brauchst du den &eArenaschlüssel der Unterwelt&r."
	]
	quest.333E70C6F5E82EEC.title: "Helvar"
	quest.334322FA709D1917.quest_desc: [
		"Lebenswurzel, Rohes Eisen und Goldklumpen ergeben Rohes Eisenholz, im Ofen wird es zum Barren."
	]
	quest.334322FA709D1917.title: "Eisenholz"
	quest.334B3D9ABA76E4E3.quest_desc: [
		"Notfall-Glyphen lösen einen Zauber automatisch aus, z. B. wenn du fällst. Pflügen macht Erde zu Ackerland."
	]
	quest.334B3D9ABA76E4E3.title: "Notfall-Glyphen"
	quest.335076F4716123BA.quest_desc: [
		"Enderstaub (aus Endererz) plus Eisenbarren ergibt Terminit. Daraus baust du gute Werkzeuge und Rüstung."
	]
	quest.335076F4716123BA.title: "Terminit"
	quest.33512249AA852B5E.quest_desc: [
		"Verbindet ein Lager mit dem Logistiknetz. Alle verbundenen Lager bilden zusammen deinen Bestand."
	]
	quest.33512249AA852B5E.title: "Lagerverbindung"
	quest.336EEF13C3A70C51.quest_desc: [
		"Supraleiter brauchst du für den Teilchenbeschleuniger."
	]
	quest.336EEF13C3A70C51.title: "Supraleiter"
	quest.33733C09E2E4855E.quest_desc: [
		"Das abgenutzte Notizbuch ist das Handbuch von Ars Nouveau. Alle Rezepte und Aufbauten stehen hier drin."
	]
	quest.33733C09E2E4855E.title: "Das Handbuch"
	quest.3386A0459B091AF8.quest_desc: [
		"Mit dem &eSigil of Socketing&r gibst du einem Gegenstand im Schmiedetisch einen zusätzlichen Sockel. Edelsteine setzt du ebenfalls im Schmiedetisch ein."
	]
	quest.3386A0459B091AF8.title: "Sockel einsetzen"
	quest.33A9D9E020217502.quest_desc: [
		"Lager setzen, Segel daran bauen und mit Rechtsklick auf das Lager starten. Mehr Segel = mehr Kraft.\n\nDie Segel müssen am Lager kleben, Segelrahmen halten automatisch zusammen."
	]
	quest.33A9D9E020217502.title: "Windmühle"
	quest.33AEAA5B7A29203D.quest_desc: [
		"Dreht alle angeklebten Blöcke. Damit beginnen &eContraptions&r: bewegliche Bauten aus Blöcken."
	]
	quest.33AEAA5B7A29203D.title: "Mechanisches Lager"
	quest.33CDCC9D95E6572A.quest_desc: [
		"Silbererz findest du unter Tage wie Eisen. Silber brauchst du für Linsen, Lampen und viele Rituale."
	]
	quest.33CDCC9D95E6572A.title: "Silber"
	quest.33D2643CF538E698.quest_desc: [
		"Froststahl gibt es in den eisigen Gebieten. Waffen daraus verlangsamen Gegner."
	]
	quest.33D2643CF538E698.title: "Froststahl"
	quest.33FF17E2C804695A.quest_desc: [
		"Rechtsklick auf eine Biene fängt sie im Käfig. So bringst du Bienen sicher nach Hause."
	]
	quest.33FF17E2C804695A.title: "Bienenkäfig"
	quest.34185C7A389A84D1.quest_desc: [
		"Liest Daten von einem Block (z. B. Lagerinhalt, Zugzeiten) und zeigt sie auf Tafeln oder Schildern an."
	]
	quest.34185C7A389A84D1.title: "Anzeige-Link"
	quest.3418B6C6668AA256.quest_desc: [
		"Der Rekonstruktor macht aus Redstone, Lapis, Eisen und Kohle (und Diamant, Smaragd) die sechs &eKristalle&r der Mod."
	]
	quest.3418B6C6668AA256.title: "Kristalle"
	quest.3419C3ACAFE3A8CE.quest_desc: [
		"Ein elektrischer Ofen, der mit Upgrades sehr schnell wird."
	]
	quest.3419C3ACAFE3A8CE.title: "Energieschmelzer"
	quest.342673CC37A60047.quest_desc: [
		"Der Wüstentempel hat jetzt Gänge, Rätsel und Fallen. Und ganz unten wartet ein Pharao."
	]
	quest.342673CC37A60047.title: "Wüstentempel"
	quest.3432B4B441E30C57.quest_desc: [
		"In diesem Pack warten jede Menge Bosse. Von links nach rechts werden sie härter.\n\nTipp: Gute Rüstung, Essen und ein paar Heiltränke gehören immer ins Gepäck. Mit dem &eBoss-Respawner&r von Cataclysm kannst du manche Bosse erneut rufen."
	]
	quest.3432B4B441E30C57.title: "Auf zur Jagd!"
	quest.344320C1FBB7D6C5.quest_desc: [
		"Der Warden aus der Tiefen Dunkelheit ist extrem stark. Meistens ist Schleichen klüger als Kämpfen.\n\nWenn du dich traust: Fernkampf und viel Abstand."
	]
	quest.344320C1FBB7D6C5.title: "Der Wärter"
	quest.34479697F7025A89.quest_desc: [
		"Pflanzen wachsen darauf schneller. Pilze darauf werden zu Pilzkolonien."
	]
	quest.34479697F7025A89.title: "Reichhaltige Erde"
	quest.34565F1B2BAE071A.quest_desc: [
		"Prudentium-Samen: Kohle, Nether und Farbstoff."
	]
	quest.34565F1B2BAE071A.title: "Stufe 2: Kohle und Co."
	quest.345E787FC0C604C6.quest_desc: [
		"Die Eldritch-Schule lernst du nicht über Schriftrollen, sondern über diese Manuskripte. Halt in alten, düsteren Orten Ausschau."
	]
	quest.345E787FC0C604C6.title: "Eldritch-Manuskript"
	quest.347BD9341EB2C96D.quest_desc: [
		"Gold, Arkane Essenz und Schweinsleder. Noch mehr Zauberplätze."
	]
	quest.347BD9341EB2C96D.title: "Lehrlingsbuch"
	quest.347DAC9269CA23B1.quest_desc: [
		"Verstärkte Legierung (mit Diamant infundiert) und der Elite-Schaltkreis."
	]
	quest.347DAC9269CA23B1.title: "Elite"
	quest.34902DFE5620A656.quest_desc: [
		"Zerbrochene Singularität und Quantenlegierung sind die Bausteine für alles Quanten-Zeug in AdvancedAE."
	]
	quest.34902DFE5620A656.title: "Quantenlegierung"
	quest.3490617E873AB567.quest_desc: [
		"Create Aeronautics mit Sable: Contraptions, die wirklich fliegen und physikalisch simuliert werden. Propeller geben Schub.\n\nRezepte stehen in EMI, Erklärungen im Ponder."
	]
	quest.3490617E873AB567.title: "Propeller"
	quest.3495740D288CDA80.quest_desc: [
		"&eNot Enough Glyphs&r: Die Mappe ergänzt dein Zauberbuch. Details stehen im Handbuch."
	]
	quest.3495740D288CDA80.title: "Zauber-Mappe"
	quest.34B77B5110F93758.quest_desc: [
		"Rituale brauchen eine &egoldene Ritualschale&r in der Mitte des Pentakels und normale Opferschalen drumherum für die Zutaten."
	]
	quest.34B77B5110F93758.title: "Opferschalen"
	quest.34BDE55C15494643.quest_desc: [
		"Kryomant und Nekromant zaubern zurück. Halt Abstand und unterbrich sie."
	]
	quest.34BDE55C15494643.title: "Magier-Duelle"
	quest.34C763F945B8B4E5.quest_desc: [
		"Eine große Burg mit Wachen und Schatzkammern."
	]
	quest.34C763F945B8B4E5.title: "Die Burg"
	quest.34DA89287D13C44F.quest_desc: [
		"Mit Wegsteinen teleportierst du dich zwischen Orten, die du schon besucht hast. In Dörfern stehen oft schon welche."
		""
		"Für den eigenen brauchst du einen Warpstein (Smaragd, Amethyst, Enderperle)."
	]
	quest.34DA89287D13C44F.title: "Wegsteine"
	quest.34F359AA5F1F314F.quest_desc: [
		"Bindet eine normale Truhe, Schublade oder Sophisticated-Truhe ins Netzwerk ein."
	]
	quest.34F359AA5F1F314F.title: "Externer Speicher"
	quest.3502E25F32F9B2BE.quest_desc: [
		"Der wichtigste Staub der Mod. Rechtsklick damit auf die richtigen Strukturen erschafft Hephaistos-Schmiede, Clibano und Obelisken. Damit lädst du sogar Creeper auf."
	]
	quest.3502E25F32F9B2BE.title: "Mundabitur-Staub"
	quest.35084D99145ED4E1.quest_desc: [
		"Ein Molekularassembler, der mehrere Rezepte gleichzeitig abarbeitet."
	]
	quest.35084D99145ED4E1.title: "Erweiterter Assembler"
	quest.353509356156F13F.quest_desc: [
		"Gold macht epische, Amethyst legendäre Tinte. Damit schmiedest du die stärksten Schriftrollen."
	]
	quest.353509356156F13F.title: "Epische Tinte"
	quest.3535F12B69977A30.quest_desc: [
		"Der große Umschmiedetisch kann auch epische und mythische Ausrüstung neu auswürfeln."
	]
	quest.3535F12B69977A30.title: "Umschmiedetisch"
	quest.353B1410B73EABD2.quest_desc: [
		"Die Legierungsschmelze ist das Herz von Ender IO: Hier entstehen alle Legierungen."
	]
	quest.353B1410B73EABD2.title: "Legierungsschmelze"
	quest.3542D064A1C614C4.quest_desc: [
		"Hohe Türme voller Banditen. Kämpf dich bis nach oben."
	]
	quest.3542D064A1C614C4.title: "Banditentürme"
	quest.35436BCDF787509B.quest_desc: [
		"Iss eine reife Dämonentraum-Frucht: Du bekommst das &eDritte Auge&r und siehst damit Blöcke aus der Anderswelt, die sonst wie normaler Stein oder Holz aussehen.\n\n&cAchtung:&r Die Frucht macht auch ein bisschen übel."
	]
	quest.35436BCDF787509B.title: "Das dritte Auge"
	quest.355779623D9E2FD8.quest_desc: [
		"Lässt alle Spieler in der Nähe fliegen, solange das Ritual Quelle hat."
	]
	quest.355779623D9E2FD8.title: "Ritual des Flugs"
	quest.357856974E2DBED8.quest_desc: [
		"Langsamer, aber deutlich stärker als das kleine Rad."
	]
	quest.357856974E2DBED8.title: "Großes Wasserrad"
	quest.358A7FF47A1314DE.quest_desc: [
		"Ein Kürbisritter auf seinem Höllenross. Hol ihn zuerst vom Pferd."
	]
	quest.358A7FF47A1314DE.title: "Sir Pumpkinhead"
	quest.359E78CA81853BCA.quest_desc: [
		"Bläst Items und Mobs weg oder saugt sie an. Richtig spannend wird er mit Wasser, Feuer oder Lava davor."
	]
	quest.359E78CA81853BCA.title: "Ummantelter Lüfter"
	quest.35A2589F9485ED25.quest_desc: [
		"Eine große CPU mit viel Speicher und mehreren Co-Prozessoren schafft auch lange Rezeptketten in kurzer Zeit.\n\nGlückwunsch, du beherrschst AE2! Weiter geht es mit den Addons."
	]
	quest.35A2589F9485ED25.title: "Autocrafting-Profi"
	quest.35A465A2063E94A0.quest_desc: [
		"Dank Grind Enchantments kannst du am Schleifstein Verzauberungen von einem Item auf ein leeres Buch übertragen."
		""
		"So rettest du gute Verzauberungen von alten Werkzeugen."
	]
	quest.35A465A2063E94A0.title: "Schleifstein"
	quest.35AD3D77F3445C5F.quest_desc: [
		"Diamanten, Smaragde und Netherit vom Feld. Supremium-Pflanzen wachsen langsam, also lohnt sich hier besseres Ackerland."
	]
	quest.35AD3D77F3445C5F.title: "Stufe 5: Edelsteine"
	quest.35B52DD2728FE2F7.quest_desc: [
		"Platzierter Kompost wird mit der Zeit von selbst zu reichhaltiger Erde."
	]
	quest.35B52DD2728FE2F7.title: "Organischer Kompost"
	quest.35C2928E5D5A3915.quest_desc: [
		"Signale teilen die Strecke in Abschnitte, damit Züge nicht ineinander fahren."
	]
	quest.35C2928E5D5A3915.title: "Zugsignal"
	quest.35C6B752935CF325.quest_desc: [
		"Flache Lampen aus Plastik und Glowstone, in allen Farben."
	]
	quest.35C6B752935CF325.title: "Leuchtplatten"
	quest.35DD912913F6B05C.quest_desc: [
		"Ein stärkerer Lüfter. Mit Katalysator-Segeln verarbeitet er Items auch ohne Wasser oder Feuer davor."
	]
	quest.35DD912913F6B05C.title: "Industrielüfter"
	quest.35DFCB25040E354C.quest_desc: [
		"Aus Paste und Eisengittern werden Stäbe, daraus das Gehäuse. Das ist der Rahmen für alle Maschinen."
	]
	quest.35DFCB25040E354C.title: "Dielektrisches Gehäuse"
	quest.35F277BF013F02F4.quest_desc: [
		"Verstärkt Wasser- und Frostzauber."
	]
	quest.35F277BF013F02F4.title: "Wasser-Fokus"
	quest.36083AA2F16940B5.quest_desc: [
		"Hier bringst du Edelsteine auf eine höhere Reinheit. Dafür brauchst du Edelsteinstaub und Material."
	]
	quest.36083AA2F16940B5.title: "Edelsteinschleiftisch"
	quest.360952FC4E81F224.quest_desc: [
		"Gelée Royale ist selten und wertvoll. Erkunde die Bumblezone gründlich."
	]
	quest.360952FC4E81F224.title: "Gelée Royale"
	quest.3611554E6E32C33E.quest_desc: [
		"In der Pfanne brätst du Essen auf einer Hitzequelle. Notfalls taugt sie auch als Waffe."
	]
	quest.3611554E6E32C33E.title: "Bratpfanne"
	quest.361C88793F85C32E.quest_desc: [
		"Quelljuwelen sind die Grundzutat für fast alles in Ars Nouveau. Mach dir gleich einen kleinen Vorrat."
	]
	quest.361C88793F85C32E.title: "Quelljuwelen"
	quest.361D3B5F14C6969A.quest_desc: [
		"Lädt die Items in deinem Inventar kabellos auf. Mit der Bindungskarte verknüpfst du ihn mit dir."
	]
	quest.361D3B5F14C6969A.title: "Spieler-Transmitter"
	quest.3629EF42FBA2B6A6.quest_desc: [
		"Ein normaler Kompass ist die Grundlage für zwei viel bessere Kompasse."
	]
	quest.3629EF42FBA2B6A6.title: "Kompass"
	quest.363FCF5B50A65FF6.quest_desc: [
		"Ein Illager, der mit Eisbrocken wirft. Er taucht in kalten Gegenden auf."
	]
	quest.363FCF5B50A65FF6.title: "Iceologer"
	quest.36406D66A049744E.quest_desc: [
		"Der Apparat steht auf dem Arkanen Kern, Podeste drumherum. Hier entstehen Rüstungen, Schmuck, Bücher und vieles mehr.\n\nDen Aufbau zeigt dir das Handbuch."
	]
	quest.36406D66A049744E.title: "Verzauberungsapparat"
	quest.36503D470E6FC1E4.quest_desc: [
		"PneumaticCraft beginnt mit einem Knall: Leg Eisenbarren oder Eisenblöcke auf den Boden und spreng sie mit &eTNT&r. Ein Teil wird zu &eKomprimiertem Eisen&r, ein Teil geht verloren."
		""
		"Später geht das verlustfrei in der Druckkammer."
	]
	quest.36503D470E6FC1E4.title: "Komprimiertes Eisen"
	quest.36525D334E1A76C6.quest_desc: [
		"Zutat für bessere Bücher. Wie du es bekommst, zeigt EMI."
	]
	quest.36525D334E1A76C6.title: "Schweinsleder"
	quest.365E676BD0617FBC.quest_desc: [
		"&eArs Technica&r verbindet Ars mit Create. Alles beginnt mit dem Präzisionsmechanismus, aufgeladen mit Quelljuwel und Amethyst."
	]
	quest.365E676BD0617FBC.title: "Kalibrierter Mechanismus"
	quest.3663A71FFF40DCCB.quest_desc: [
		"Rogues & Warriors bringt Dolche, Doppeläxte, Glefen und Sicheln. Die Werkbank ist der Arbeitsplatz des Waffenschmieds."
	]
	quest.3663A71FFF40DCCB.title: "Waffenschmied"
	quest.369DE74EDF18E6BD.quest_desc: [
		"YUNG's Bridges baut Brücken über Flüsse. Hak ab, sobald du über eine gelaufen bist."
	]
	quest.369DE74EDF18E6BD.title: "Brücken"
	quest.36B129125051676C.quest_desc: [
		"Das seltenste Material in Mekanism. Damit kannst du den Antiprotonischen Nukleosynthetisierer bauen.\n\nDu hast Mekanism durchgespielt!"
	]
	quest.36B129125051676C.title: "Antimaterie"
	quest.36C48E0A787EFBF9.quest_desc: [
		"Der &eZusammenfüger&r (Assembler) baut komplexe Bauteile wie Verarbeitungseinheiten."
		""
		"Für ihn brauchst du &eAdamant&r (Diamant plus Nickel)."
	]
	quest.36C48E0A787EFBF9.title: "Zusammenfüger"
	quest.36C6CDD3A4980BFB.quest_desc: [
		"Für den Djinni brauchst du hellgraue und hellgrüne Kreide. Den Forschungsstaub für die grüne Kreide stellt ein Foliot im Ritual her."
	]
	quest.36C6CDD3A4980BFB.title: "Kreide für Djinnis"
	quest.36C7C5F1168EB239.quest_desc: [
		"Dungeon's Delight macht aus Monstern Zutaten. Das Hackbeil ist eine schwere Klinge aus dieser Mod, was es genau kann, steht im Tooltip und in EMI."
	]
	quest.36C7C5F1168EB239.title: "Hackbeil"
	quest.36D26F58E6B43610.quest_desc: [
		"Mit &eShift + Rechtsklick&r und leeren Händen kannst du Kisten samt Inhalt und auch Tiere hochheben und woanders hinstellen."
		""
		"Sehr praktisch beim Umziehen!"
	]
	quest.36D26F58E6B43610.title: "Carry On"
	quest.36D796FDC8839F76.quest_desc: [
		"Die Hydra lässt Feuerblut fallen."
	]
	quest.36D796FDC8839F76.title: "Feuerblut"
	quest.36E0ADB6560742D8.quest_desc: [
		"Create: Metallurgy bringt eine Gießerei. Der Mörtel ist das Grundmaterial dafür."
	]
	quest.36E0ADB6560742D8.title: "Feuerfester Mörtel"
	quest.36E9987C426115FC.quest_desc: [
		"Der &eTeilchenbeschleuniger&r schießt Items im Kreis herum und lässt sie kollidieren. So entstehen exotische Materialien wie Überladene Kristalle."
		""
		"Aufbau und Größe zeigt das Oritech-Handbuch."
	]
	quest.36E9987C426115FC.title: "Teilchenbeschleuniger"
	quest.3704424182CC62FB.quest_desc: [
		"Die Diamantstufe."
	]
	quest.3704424182CC62FB.title: "Diamant-Angel"
	quest.37592CBD4C8521A4.quest_desc: [
		"Zinkerz findest du vor allem in mittleren Höhen. Zink brauchst du für Messing."
	]
	quest.37592CBD4C8521A4.title: "Zink"
	quest.37616ECBB50875A4.quest_desc: [
		"Die Wünschelrute findet Anderswelt-Blöcke für dich. Halte sie auf einen Block, um ihn einzustellen, und benutze sie dann."
	]
	quest.37616ECBB50875A4.title: "Wünschelrute"
	quest.3776F194F2597E04.quest_desc: [
		"Ein Eisen- oder Kupferbarren, aufgeladen mit Arkaner Essenz."
	]
	quest.3776F194F2597E04.title: "Arkaner Barren"
	quest.378DFCB650105DFC.quest_desc: [
		"Bringt dich einmalig zu deinem letzten aktivierten Wegstein zurück. Gut als Notfall-Ticket."
	]
	quest.378DFCB650105DFC.title: "Rückkehr-Schriftrolle"
	quest.378EFE55EBF69499.quest_desc: [
		"Lohenrute für Feuer, Gefrorener Knochen für Eis, Blitzflasche für Blitz."
	]
	quest.378EFE55EBF69499.title: "Feuer, Eis, Blitz"
	quest.3791E355D0960958.quest_desc: [
		"27 Koksziegel als 3x3x3-Würfel, Hammer auf die Mitte einer Seite. Aus Kohle wird Koks, dabei fällt Kreosotöl ab."
	]
	quest.3791E355D0960958.title: "Koksofen"
	quest.3798A8DF9E773CF1.quest_desc: [
		"Der Reaktor ist ein 3x3x4-Multiblock aus 36 gleichen Blöcken und verbrennt Uraninit. Vorsicht mit der Hitze, kühl ihn mit Wasser oder Eis."
	]
	quest.3798A8DF9E773CF1.title: "Powah-Reaktor"
	quest.37AFEE843D6FE3F3.quest_desc: [
		"Rote Wüsten und Canyons. Auf dem Mars gibt es &eOstrum&r."
	]
	quest.37AFEE843D6FE3F3.title: "Der Mars"
	quest.37B2A11498141778.quest_desc: [
		"Bau den Rohprozessor und schmelz ihn im Ofen. So entstehen alle drei Prozessoren."
	]
	quest.37B2A11498141778.title: "Basisprozessor"
	quest.37C1A1A841087814.quest_desc: [
		"Silizium bekommst du aus Certus-Staub im Ofen. Mit dem Siliziumdruck wird daraus Gedrucktes Silizium für jeden Prozessor."
	]
	quest.37C1A1A841087814.title: "Silizium"
	quest.37C463E562E04F65.quest_desc: [
		"Das Dunkelstahlschwert heißt \"Der Ender\" und lässt Endermen und andere Mobs öfter ihre Köpfe fallen."
	]
	quest.37C463E562E04F65.title: "Der Ender"
	quest.37D06C5176C2C4B8.quest_desc: [
		"Allthemodium ist das erste von drei Endgame-Erzen. Abbauen kannst du es nur mit Netherit-Werkzeug.\n\nIn der Oberwelt findest du es tief unten in &eAntiken Städten&r."
	]
	quest.37D06C5176C2C4B8.title: "Allthemodium"
	quest.37D2923A3AAD4A10.quest_desc: [
		"Kupfer mit Redstone infundiert. Steckt in sehr vielen Rezepten."
	]
	quest.37D2923A3AAD4A10.title: "Infundierte Legierung"
	quest.37D6E8C279EFAFB7.quest_desc: [
		"Ein Lohenbrenner wird zum Verzauberer. Gefüttert mit flüssiger Erfahrung und einer Verzauberungsvorlage verzaubert er Items automatisch."
	]
	quest.37D6E8C279EFAFB7.title: "Lohen-Verzauberer"
	quest.37FE54162ACDF493.quest_desc: [
		"Create: Teleporters. Die Redstone-Perle ist das erste Bauteil."
	]
	quest.37FE54162ACDF493.title: "Redstone-Perle"
	quest.3801F5F81ADF81F8.quest_desc: [
		"Das erste Rezept der &eSequenziellen Montage&r: Goldblech auf ein Band, dann im Wechsel Zahnrad, großes Zahnrad und Eisenklumpen per Deployer, mehrmals hintereinander.\n\nManchmal kommt Schrott heraus. Mehrere Deployer und eine Presse am Band machen das automatisch."
	]
	quest.3801F5F81ADF81F8.title: "Präzisionsgetriebe"
	quest.380E29A7F20A7A5A.quest_desc: [
		"Der Kern steckt in fast allen Maschinen von EvilCraft."
	]
	quest.380E29A7F20A7A5A.title: "Blutinfusionskern"
	quest.3814FBC42F865961.quest_desc: [
		"Jede Stufe bringt mehr Platz und mehr Upgrade-Slots. Kupfer ist die erste."
	]
	quest.3814FBC42F865961.title: "Kupfertruhe"
	quest.381BCC5138AB61E8.quest_desc: [
		"Der &eAugmentiertisch&r verbessert einzelne Affixe auf mythischer Ausrüstung. Dafür brauchst du eine Gottgeschmiedete Perle und einen Netherstern."
	]
	quest.381BCC5138AB61E8.title: "Augmentiertisch"
	quest.3824C8B23FCA0AE4.quest_desc: [
		"Ein Motor aus New Age, der Strom in Rotation umwandelt. Er braucht Magnetit, wie du das bekommst, zeigt EMI."
	]
	quest.3824C8B23FCA0AE4.title: "New-Age-Motor"
	quest.382806C45C0F4EE2.quest_desc: [
		"Eine tragbare Werkbank mit eigenem Zwischenspeicher."
	]
	quest.382806C45C0F4EE2.title: "Erhabener Handwerker"
	quest.383F779B96C6BDF7.quest_desc: [
		"Hebt einen Edelstein auf die nächste Reinheit, ohne Schleiftisch."
	]
	quest.383F779B96C6BDF7.title: "Siegel der Verstärkung"
	quest.3849C5225F5998CF.quest_desc: [
		"Du hast Create bis zum Ende gespielt. Deine Fabrik läuft von allein."
	]
	quest.3849C5225F5998CF.title: "Meister der Zahnräder"
	quest.38561DDA6E4E1933.quest_desc: [
		"Mit Augmenten verbesserst du &edich selbst&r: In der Forschungsstation erforschst du sie, im Augmentation Center baust du sie ein."
		""
		"Was es gibt, siehst du in der Station."
	]
	quest.38561DDA6E4E1933.title: "Augmente"
	quest.385C43D1D96BD901.quest_desc: [
		"Bienen sind in diesem Pack viel mehr als Honiglieferanten. Mit &eProductive Bees&r züchtest du Bienen, die Erze, Edelsteine und vieles mehr sammeln.\n\nSchere zuerst ein paar Honigwaben von einem Bienennest."
	]
	quest.385C43D1D96BD901.title: "Summ, summ"
	quest.387B988B2DB07503.quest_desc: [
		"Stell dich auf einen Reiseanker und schau zu einem anderen, dann springst du direkt dorthin. Wie genau, steht im Tooltip."
	]
	quest.387B988B2DB07503.title: "Reiseanker"
	quest.3888BFD9EFCB6AB4.quest_desc: [
		"Ab hier kommt &cL_Ender's Cataclysm&r. Die Monstrosität bewacht die Seelenschmiede im Nether.\n\nDie Augen von Cataclysm funktionieren wie ein Enderauge: werfen, folgen, Struktur finden. Hier brauchst du das &eAuge der Monstrosität&r."
	]
	quest.3888BFD9EFCB6AB4.title: "Netherit-Monstrosität"
	quest.3889D12F27E7285A.quest_desc: [
		"Create: Enchantment Industry startet hier. Der Schleifstein wird von einer Welle angetrieben."
	]
	quest.3889D12F27E7285A.title: "Mechanischer Schleifstein"
	quest.38A75247B19A697D.quest_desc: [
		"27 Sprengziegel als 3x3x3-Würfel. Eisen plus Koks wird darin zu Stahl. Stahl ist das Rückgrat von allem, was jetzt kommt."
	]
	quest.38A75247B19A697D.title: "Roh-Hochofen und Stahl"
	quest.38AB2AA07CA866F0.quest_desc: [
		"Der Schlachter verwandelt Mobs in flüssiges Fleisch und pinken Schleim. Den Schleim brauchst du gleich."
	]
	quest.38AB2AA07CA866F0.title: "Industrieller Schlachter"
	quest.38C05F5E95F7B892.quest_desc: [
		"&eSprung&r und &eSchleudern&r werfen dich durch die Luft, &eBlinzeln&r teleportiert dich ein Stück nach vorn."
	]
	quest.38C05F5E95F7B892.title: "Bewegungs-Glyphen"
	quest.38EFFD4AB9482699.quest_desc: [
		"Ein Anhänger, der mit Blut schlechte Effekte von dir nimmt."
	]
	quest.38EFFD4AB9482699.title: "Belebender Anhänger"
	quest.3901F6F1D374C27D.quest_desc: [
		"Die Abfüllanlage füllt Flüssigkeiten in Items, zum Beispiel Eimer oder Kanister."
	]
	quest.3901F6F1D374C27D.title: "Abfüllanlage"
	quest.3903F54E4148AB26.quest_desc: [
		"Der Ausguss füllt Flüssigkeit in Items (Eimer, Flaschen, Rezepte). Der Abfluss leert Items aus."
	]
	quest.3903F54E4148AB26.title: "Ausguss und Abfluss"
	quest.39059EA5EA3B8911.quest_desc: [
		"Nur mit dieser Spitzhacke kannst du &eIesnium&r abbauen. Den Kopf machst du aus einem Spirit Attuned Gem, den Rest erledigt ein Djinni im Ritual."
	]
	quest.39059EA5EA3B8911.title: "Durchdrungene Spitzhacke"
	quest.391816F04B5AF8AD.quest_desc: [
		"Eine riesige Fabrik voller Gegner, mit sehr guter Beute."
	]
	quest.391816F04B5AF8AD.title: "Gießerei"
	quest.39199A3CA1D33D1A.quest_desc: [
		"Integrated Dungeons and Structures baut neue Orte, vom Gasthaus bis zur Burg."
	]
	quest.39199A3CA1D33D1A.title: "Gasthaus Bärenklaue"
	quest.3922D813140FF29B.quest_desc: [
		"Mekanism Additions bringt Ballons, Plastikblöcke und Leuchtplatten. Reine Deko, aber lustig."
	]
	quest.3922D813140FF29B.title: "Ballons!"
	quest.392F8A297D909754.quest_desc: [
		"Manipulation und Abschwörung brauchst du für Rüstungs-Upgrades, Stäbe und viele Glyphen."
	]
	quest.392F8A297D909754.title: "Weitere Essenzen"
	quest.393E3D4683D21789.quest_desc: [
		"Unbestückte Platine plus Transistoren und Kondensatoren ergibt die &eFertige Platine&r. Damit öffnet sich die ganze späte Mod."
	]
	quest.393E3D4683D21789.title: "Fertige Platine"
	quest.3944FA102C49DD02.quest_desc: [
		"Der Härteste der Mutanten. Er wirft Blöcke und teleportiert sich.\n\nEr lässt die &eEnderseelenhand&r fallen."
	]
	quest.3944FA102C49DD02.title: "Mutantenenderman"
	quest.394DD1E06176CD3B.quest_desc: [
		"Der Seelenbinder bindet die Seele aus einer Ampulle an ein Item. So entstehen Enderkristalle und kaputte Spawner bekommen einen Mob."
	]
	quest.394DD1E06176CD3B.title: "Seelenbinder"
	quest.396632BA604B18BC.quest_desc: [
		"Willkommen im Twilight Forest! Die Bosse haben eine feste Reihenfolge: Gebiete bleiben mit Flüchen (z. B. Dunkelheit, Hitze, Kälte) gesperrt, bis du den Boss davor besiegt hast.\n\nFolge den Quests von links nach rechts."
	]
	quest.396632BA604B18BC.title: "Ewige Dämmerung"
	quest.3970EE61195CA2B4.quest_desc: [
		"Die Wixie craftet für dich und braut Tränke im Wixie-Kessel."
	]
	quest.3970EE61195CA2B4.title: "Wixie"
	quest.3986167DB4E1381E.quest_desc: [
		"Die Assembler-Matrix ist ein Multiblock, der viele Assembler und Provider in einem ersetzt. Rahmen außen, Kerne innen, Aufbau steht im Handbuch."
	]
	quest.3986167DB4E1381E.title: "Assembler-Matrix"
	quest.398F7E3ED2DE48E1.quest_desc: [
		"Größere Speicherkerne baust du aus mehreren kleineren. Die Rezepte zeigt dir EMI."
	]
	quest.398F7E3ED2DE48E1.title: "Mehr Platz"
	quest.39B72742553972A7.quest_desc: [
		"Der Elektrolyseur spaltet Wasser in Wasserstoff und Sauerstoff. Beides brauchst du noch oft."
	]
	quest.39B72742553972A7.title: "Elektrolyse"
	quest.39CBA273B2F8F949.quest_desc: [
		"Im Ingenieurshandbuch stehen alle Baupläne der Multiblöcke, Schicht für Schicht. Schau da rein, bevor du etwas baust."
	]
	quest.39CBA273B2F8F949.title: "Das Handbuch"
	quest.39CF4CED6C7FD1D4.quest_desc: [
		"Manche Quests belohnen dich mit einer Loot-Kiste. Nimm sie in die Hand und mach Rechtsklick, um sie zu öffnen."
		""
		"Es gibt vier Stufen: &fGewöhnlich&r, &aSelten&r, &5Episch&r und &6Legendär&r."
	]
	quest.39CF4CED6C7FD1D4.title: "Loot-Kisten"
	quest.39D7FDF3682E254F.quest_desc: [
		"Wirf eine Dämonentraum-Frucht in ein Feuer, dann wird es zu &eGeisterfeuer&r. Items, die du hineinwirfst, verwandeln sich.\n\nAndesit wird so zu &eOtherstone&r, dem Grundstein für Ritualschalen und Kreide."
	]
	quest.39D7FDF3682E254F.title: "Geisterfeuer"
	quest.39D8CB377301B2E9.quest_desc: [
		"Im Reagenzglas sammelst du Blut-Essenz für die Schmiede."
	]
	quest.39D8CB377301B2E9.title: "Reagenzglas"
	quest.39EE5E23CC207EC9.quest_desc: [
		"Aquamirae bringt das Eislabyrinth in gefrorene Ozeane. Der riesige Aal lauert unter dem Eis."
	]
	quest.39EE5E23CC207EC9.title: "Der Aal"
	quest.3A0CDE4A0211BF92.quest_desc: [
		"Der &eDraconic-Reaktor&r erzeugt unglaublich viel Strom. Er braucht Kern, Stabilisatoren und Injektor, dazu einen Energiekern und Flux Gates zur Steuerung."
		""
		"&cWarnung: Wenn er überhitzt oder das Feld zusammenbricht, explodiert er und reißt ein riesiges Loch. Weit weg von der Basis bauen und vorher gut einlesen!"
	]
	quest.3A0CDE4A0211BF92.title: "Draconic-Reaktor"
	quest.3A1B4B9BD6C7648F.quest_desc: [
		"Für Flüssigkeiten und Strom gibt es eigene Rohre. Das Universalrohr kann alles auf einmal."
	]
	quest.3A1B4B9BD6C7648F.title: "Mehr Rohre"
	quest.3A2A0EE84EA56DEB.quest_desc: [
		"Die &eLadestation&r füllt Luft in Werkzeuge, Rüstung und Drohnen, die du hineinlegst."
	]
	quest.3A2A0EE84EA56DEB.title: "Ladestation"
	quest.3A2B8565006580F9.quest_desc: [
		"Die Blut-Variante des Akkumulators. Wer den baut, beherrscht EvilCraft."
	]
	quest.3A2B8565006580F9.title: "Blutiger Akkumulator"
	quest.3A3A6B96E167B587.quest_desc: [
		"AE2 Wireless Terminals fasst mehrere drahtlose Konsolen in einer zusammen. Kombiniere sie in der Werkbank."
	]
	quest.3A3A6B96E167B587.title: "Universalkonsole"
	quest.3A3C54B5EDE6D6DB.quest_desc: [
		"Die Erzlaserbasis bohrt Erze aus dem Nichts, die Laserbohrer drumherum liefern die Energie. Mit Linsen bestimmst du, welche Erze bevorzugt kommen."
	]
	quest.3A3C54B5EDE6D6DB.title: "Laserbohrer"
	quest.3A41EBE6808A6750.quest_desc: [
		"Karminit bekommst du von den Gegnern im Dunklen Turm. Damit baust du z. B. eigene Turm-Mechanismen."
	]
	quest.3A41EBE6808A6750.title: "Karminit"
	quest.3A48E312FE17C7BE.quest_desc: [
		"Zyklopen wohnen in Höhlen an der Küste, oft mit einer Schafherde. Er lässt sein &eZyklopenauge&r fallen."
	]
	quest.3A48E312FE17C7BE.title: "Zyklop"
	quest.3A4D976F64301877.quest_desc: [
		"Pipez: einfache Rohre für Items, Flüssigkeiten, Energie und Gas. Das Item-Rohr transportiert Items von einer Truhe oder Maschine zur nächsten."
		""
		"In den Einstellungen des Rohrs legst du fest, wo Items herausgezogen werden. Mit dem Schraubenschlüssel trennst und verbindest du Anschlüsse."
	]
	quest.3A4D976F64301877.title: "Rohre"
	quest.3A68281AB0E6EA83.quest_desc: [
		"Die Werkbank ist der Arbeitsplatz des Bogenmacher-Dorfbewohners. Bögen und Rüstung kannst du aber auch selbst bauen."
	]
	quest.3A68281AB0E6EA83.title: "Bogenbauer"
	quest.3A7A3090106F7818.quest_desc: [
		"Für Drachenei-Samen brauchst du Drachenschuppen vom Enderdrachen."
	]
	quest.3A7A3090106F7818.title: "Drachenei-Crux"
	quest.3A7B3B34032165C3.quest_desc: [
		"Rohre leiten Flüssigkeiten, die Pumpe bewegt sie. Die Pumprichtung folgt der Drehrichtung."
	]
	quest.3A7B3B34032165C3.title: "Rohre und Pumpe"
	quest.3A81F4D9C29393AA.quest_desc: [
		"Netherquarz im Ofen schmelzen ergibt Silizium. Das steckt in jedem Prozessor."
	]
	quest.3A81F4D9C29393AA.title: "Silizium"
	quest.3A96BD3C01F19278.quest_desc: [
		"Die Grundlage für alle Truhen-Upgrades."
	]
	quest.3A96BD3C01F19278.title: "Upgrade-Basis"
	quest.3AA297B878CEE275.quest_desc: [
		"Create Railways Navigator: Plant Verbindungen über dein Zugnetz, mit Umstiegen, wie eine Bahn-App."
	]
	quest.3AA297B878CEE275.title: "Navigator"
	quest.3AAE5319977106BC.quest_desc: [
		"Der Altar verzaubert Aether-Sachen mit Ambrosium als Brennstoff, z. B. Gravitit-Erz zu Verzaubertem Gravitit."
	]
	quest.3AAE5319977106BC.title: "Der Altar"
	quest.3AC3A2CB0181835D.quest_desc: [
		"Die Hexenhütten stehen im Sumpf und sind jetzt richtig unheimlich."
	]
	quest.3AC3A2CB0181835D.title: "Hexenhütte"
	quest.3AC911807E49C2E5.quest_desc: [
		"Lava-Generator und Dampfmaschine liefern mehr Strom als der einfache Generator."
	]
	quest.3AC911807E49C2E5.title: "Mehr Generatoren"
	quest.3ACA3396E8E406D1.quest_desc: [
		"Der Wärter lässt mit Deeper and Darker das Herz der Tiefen fallen. Ein harter Kampf, also gut vorbereiten."
	]
	quest.3ACA3396E8E406D1.title: "Herz der Tiefen"
	quest.3ACF79C17AA257E6.quest_desc: [
		"Die Grundzutat für fast alles. Sie liegt in Truhen und fällt bei magischen Gegnern; weitere Wege zeigt EMI."
	]
	quest.3ACF79C17AA257E6.title: "Arkane Essenz"
	quest.3AD805849B980BFA.quest_desc: [
		"Allthemodium-Erz steckt in Wänden und Decken der Höhlen im Tiefen Dunkel. Abbauen nur von Hand und mit &eNetherit-Spitzhacke&r."
	]
	quest.3AD805849B980BFA.title: "Allthemodium"
	quest.3AFC6E956E6E67D4.quest_desc: [
		"Erwecktes Supremium ist das beste Material von Mystical Agriculture selbst. Daraus werden die stärksten Werkzeuge und Upgrades."
	]
	quest.3AFC6E956E6E67D4.title: "Erwecktes Supremium"
	quest.3B0C472DBEB4A89A.quest_desc: [
		"Der fortgeschrittene Bienenstock fasst mehr Bienen und sammelt ihre Waben in einem Inventar. Hier kommen auch Upgrades rein."
	]
	quest.3B0C472DBEB4A89A.title: "Fortgeschrittener Bienenstock"
	quest.3B0CE1F24865E907.quest_desc: [
		"Wirf geladenen Certus-Quarz, Netherquarz und Redstone zusammen ins Wasser. Nach kurzer Zeit entsteht &eFluix&r."
	]
	quest.3B0CE1F24865E907.title: "Fluix"
	quest.3B1B379C65EA77BC.quest_desc: [
		"Belichtete Platinen kommen in den &eÄtztank&r mit &eÄtzsäure&r. Heraus kommen unbestückte Platinen. Fehlschläge lassen sich wiederverwerten."
	]
	quest.3B1B379C65EA77BC.title: "Ätzen"
	quest.3B26A376303852C9.quest_desc: [
		"Der Lagerkern verbindet alle angrenzenden Truhen und Fässer zu einem Lager. Items, die du hineinschiebst, landen automatisch dort, wo schon dasselbe liegt."
		""
		"Für den Komparator brauchst du Netherquarz."
	]
	quest.3B26A376303852C9.title: "Lagerkern"
	quest.3B3ACED54775C24A.quest_desc: [
		"Mit dem Kabelschneider machst du aus Blechen Drähte und kappst später verlegte Leitungen."
	]
	quest.3B3ACED54775C24A.title: "Kabelschneider"
	quest.3B3E9F8F10930226.quest_desc: [
		"Lädt Items mit Strom auf und kann für Rezepte Items elektrisch \"aufladen\". Schau in EMI."
	]
	quest.3B3E9F8F10930226.title: "Teslaspule"
	quest.3B428436E79A474A.quest_desc: [
		"Ein großes Kriegsschiff. Die Besatzung ist nicht erfreut über Besuch."
	]
	quest.3B428436E79A474A.title: "Fregatte"
	quest.3B49EAFAD7DB8385.quest_desc: [
		"Die Verdampfungsanlage macht aus Wasser Sole und aus Sole Lithium. Im Kristallisierer wird daraus Lithiumstaub."
	]
	quest.3B49EAFAD7DB8385.title: "Thermische Verdampfung"
	quest.3B4DAD7E75DA8E73.quest_desc: [
		"Blitzdrachen leben in warmen, trockenen Gegenden. Sie greifen mit Blitzen an."
	]
	quest.3B4DAD7E75DA8E73.title: "Blitzdrache"
	quest.3B51228560C837A0.quest_desc: [
		"Der &eFlüssigkompressor&r verbrennt flüssigen Treibstoff statt Kohle und macht deutlich mehr Luft daraus."
	]
	quest.3B51228560C837A0.title: "Flüssigkompressor"
	quest.3B5C03AA49E84EE4.quest_desc: [
		"Iesnium-Erz liegt im Nether und ist nur mit Drittem Auge oder Brille sichtbar. Daraus werden Werkzeuge, Geisterlampen und die Bergbau-Dimension."
	]
	quest.3B5C03AA49E84EE4.title: "Iesnium"
	quest.3B81A7DEFCB66A60.quest_desc: [
		"Ein Turm voller Ars-Nouveau-Magie. Für Zauberer ein Pflichtbesuch."
	]
	quest.3B81A7DEFCB66A60.title: "Erzmagier-Turm"
	quest.3B932DE79459D26C.quest_desc: [
		"Die stärkste Rakete. Mit ihr verlässt du sogar das Sonnensystem."
	]
	quest.3B932DE79459D26C.title: "Rakete Stufe 4"
	quest.3BC7DA9DB8EC0371.quest_desc: [
		"Herz aller Teleporter. Braucht Robustes Blech und Diamant."
	]
	quest.3BC7DA9DB8EC0371.title: "Quantenmechanismus"
	quest.3BCF00F1A63DD4BB.quest_desc: [
		"Mit der Flugkarte in der Quantenrüstung kannst du fliegen wie im Kreativmodus."
	]
	quest.3BCF00F1A63DD4BB.title: "Fliegen!"
	quest.3BD0AA56234869AA.quest_desc: [
		"Ab jetzt kannst du Gold, Redstone und Diamanten abbauen."
	]
	quest.3BD0AA56234869AA.title: "Eisenspitzhacke"
	quest.3BE179282E83BB4A.quest_desc: [
		"Die stärkste Rüstung im Pack. Jede Stufe baut auf der vorherigen auf: Netherit, Allthemodium, Vibranium, Unobtainium."
	]
	quest.3BE179282E83BB4A.title: "Unobtainium-Rüstung"
	quest.3BE74E9F94C3F952.quest_desc: [
		"Ein gebundener Starbuncle folgt dir als Vertrauter und gibt dir einen Bonus. Es gibt auch Wixie, Drygmy, Bücherwurm und andere."
	]
	quest.3BE74E9F94C3F952.title: "Ein Vertrauter"
	quest.3BF041075C293E4B.quest_desc: [
		"Osmiumerz findest du überall im Untergrund. Schmelz es zu Barren, damit fängt Mekanism an."
	]
	quest.3BF041075C293E4B.title: "Osmium"
	quest.3C085CAC39D2AFB3.quest_desc: [
		"Die passende Hitzequelle zum Monstertopf."
	]
	quest.3C085CAC39D2AFB3.title: "Dungeon-Herd"
	quest.3C1162B088EEB460.quest_desc: [
		"Ackerland der höchsten Stufe. Der Insanium-Apfel gibt dir gleich mehrere starke Effekte."
	]
	quest.3C1162B088EEB460.title: "Insanium-Ackerland"
	quest.3C26EA07BE8883A4.quest_desc: [
		"Im beheizten Gießerei-Becken schmilzt Metall. Über den Hahn fließt es auf den Gießtisch."
	]
	quest.3C26EA07BE8883A4.title: "Gießerei"
	quest.3C3295E09A8925B9.quest_desc: [
		"Obsidianstaub mit Diamant infundieren und im Kompressor zu Barren pressen. Glowstone geht ähnlich."
	]
	quest.3C3295E09A8925B9.title: "Raffiniertes Obsidian"
	quest.3C37028356A051C9.quest_desc: [
		"Die Wilden sind feindliche Ars-Mobs, die auch in eigenen Höhlen hausen. Ihre Drops (Horn, Stachel, Flügel) brauchst du für Essenzen, Glyphen und Rituale."
	]
	quest.3C37028356A051C9.title: "Wilden jagen"
	quest.3C4077940114F060.quest_desc: [
		"Create Stuff 'N Additions: Diese Mechanismen sind Bauteile für Jetpacks, Exoskelette und Werkzeuge."
	]
	quest.3C4077940114F060.title: "Mechanismen"
	quest.3C41F6DB7195AC5A.quest_desc: [
		"Der &eAdvanced Dislocator&r speichert viele Orte und teleportiert dich per Klick. Mit Enderperlen auffüllen."
	]
	quest.3C41F6DB7195AC5A.title: "Advanced Dislocator"
	quest.3C4457914CC4BDD2.quest_desc: [
		"Die Wiederaufbereitungsanlage verwandelt Cyanit mit Wasser in Blutonium, einen besseren Brennstoff."
	]
	quest.3C4457914CC4BDD2.title: "Wiederaufbereitung"
	quest.3C4FE5182204583E.quest_desc: [
		"Die stabile Version geht nicht kaputt. Praktisch für die Heimreise."
	]
	quest.3C4FE5182204583E.title: "Stabile Warp-Rolle"
	quest.3C516614CEBF6DDF.quest_desc: [
		"Mit dieser Rune spawnen Mobs unabhängig vom Licht."
	]
	quest.3C516614CEBF6DDF.title: "Ewige Dämmerung"
	quest.3C5F224823085623.quest_desc: [
		"Ein Schild aus Honigkristallsplittern."
	]
	quest.3C5F224823085623.title: "Honigkristallschild"
	quest.3C70BEFB8CC31396.quest_desc: [
		"Uraninit-Erz liegt tief in der Oberwelt. Du brauchst es für den Reaktor."
	]
	quest.3C70BEFB8CC31396.title: "Uraninit"
	quest.3C74D08336615130.quest_desc: [
		"Der Ernter erntet reife Pflanzen in seinem Bereich automatisch und pflanzt neu."
	]
	quest.3C74D08336615130.title: "Ernter"
	quest.3C78053C411E94B4.quest_desc: [
		"Mekanism Tools bringt Werkzeug und Rüstung aus vielen Metallen. Der Paxel ist Spitzhacke, Axt und Schaufel in einem."
	]
	quest.3C78053C411E94B4.title: "Osmiumwerkzeug"
	quest.3C89FFDDA6B19AA9.quest_desc: [
		"Gib 128 Inferium-Essenzen ab."
	]
	quest.3C89FFDDA6B19AA9.title: "Abgabe: Inferium"
	quest.3C8B2FB330A91FFE.quest_desc: [
		"Ein Curio-Amulett aus Mithril mit Zauber-Bonus."
	]
	quest.3C8B2FB330A91FFE.title: "Amulett der Konzentration"
	quest.3CB2613A51660671.quest_desc: [
		"Grab ein 2x2-Loch, füll es mit Wasser und umrande es mit Blumen oder Gras. Dann wirfst du einen &eDiamanten&r hinein, ein Blitz schlägt ein und das Portal öffnet sich."
	]
	quest.3CB2613A51660671.title: "Das Portal"
	quest.3CC72622D578956D.quest_desc: [
		"Kettenflaschenzug, Lampen, Nixie-Tafeln und Flansch-Zahnräder: kleine Extras für deine Fabrik."
	]
	quest.3CC72622D578956D.title: "Bits 'n' Bobs"
	quest.3CD4443199315821.quest_desc: [
		"Verbrennt Brennstoff zu Strom. Damit laufen deine ersten Maschinen."
	]
	quest.3CD4443199315821.title: "Stirling-Generator"
	quest.3CECD1A4E2A7104D.quest_desc: [
		"Aus der Samenbasis wird jeder Ressourcen-Samen."
	]
	quest.3CECD1A4E2A7104D.title: "Prosperity-Samenbasis"
	quest.3CF8E201BC98D6EE.quest_desc: [
		"Eine Konsole mit eingebauter Werkbank. Zutaten werden direkt aus dem Netzwerk genommen."
	]
	quest.3CF8E201BC98D6EE.title: "Herstellungskonsole"
	quest.3CFB69ACE763C87C.quest_desc: [
		"Die Railgun schießt Stäbe mit Strom. Laut, teuer und sehr stark."
	]
	quest.3CFB69ACE763C87C.title: "Railgun"
	quest.3D0886FD0A32E223.quest_desc: [
		"Stufe 5: Diamanten, Smaragde und Netherit."
	]
	quest.3D0886FD0A32E223.title: "Supremium"
	quest.3D16E9D7F9136DE9.quest_desc: [
		"Die &eMinigun&r läuft mit Luft und Munition. Vorher in der Ladestation füllen, dann dreht sie hoch und schießt sehr schnell."
	]
	quest.3D16E9D7F9136DE9.title: "Minigun"
	quest.3D18AD94830CA1AC.quest_desc: [
		"An der NASA-Werkbank baust du Raketen und Rover. Stahlplatten presst du im Kompressor."
	]
	quest.3D18AD94830CA1AC.title: "NASA-Werkbank"
	quest.3D1B2307F59D2410.quest_desc: [
		"Der Extended Pattern Provider hält deutlich mehr Schablonen als der normale."
	]
	quest.3D1B2307F59D2410.title: "Erweiterter Provider"
	quest.3D463DDBBAFF79DD.quest_desc: [
		"Gib 64 Arkane Essenz ab."
	]
	quest.3D463DDBBAFF79DD.title: "Abgabe: Arkane Essenz"
	quest.3D4DEDD644DB4EC2.quest_desc: [
		"Mit dem Kernprobenbohrer findest du heraus, welche Mineralader unter einem Chunk liegt. Die Probe zeigt dir, ob sich ein Bagger lohnt."
	]
	quest.3D4DEDD644DB4EC2.title: "Kernproben"
	quest.3D6FB25BBBAA7E33.quest_desc: [
		"Create Factory Logistics: Füllt Flüssigkeiten in Gläser, damit sie wie Pakete durchs Netz reisen."
	]
	quest.3D6FB25BBBAA7E33.title: "Flüssigkeiten verpacken"
	quest.3D75E6C11F209276.quest_desc: [
		"Der verbesserte Hochofen aus verstärkten Sprengziegeln ist schneller. Mit Vorwärmern an der Seite geht es noch flotter, die brauchen Strom."
	]
	quest.3D75E6C11F209276.title: "Verbesserter Hochofen"
	quest.3D91C1CCA25996F3.quest_desc: [
		"Gleise können in Kurven und Steigungen verlegt werden. Erst einen Punkt anklicken, dann den Zielpunkt.\n\nIn großen Mengen lohnt sich die Sequenzielle Montage."
	]
	quest.3D91C1CCA25996F3.title: "Gleise"
	quest.3D93EBED9447D1C9.quest_desc: [
		"Stufe 3. Ab jetzt wird es richtig nützlich: Eisen, Kupfer und Redstone."
	]
	quest.3D93EBED9447D1C9.title: "Tertium"
	quest.3D9F3ABDBED0C263.quest_desc: [
		"Sophisticated Storage: Truhen und Fässer, die sich aufwerten und mit Upgrades ausstatten lassen."
		""
		"Eine normale Truhe (oder Bretter) plus Hebel ergibt die Holztruhe."
	]
	quest.3D9F3ABDBED0C263.title: "Bessere Truhen"
	quest.3DB66BE0B9F99810.quest_desc: [
		"Edelsteine bestimmen den Bonus deines Schmucks. Wo es sie gibt, zeigt EMI."
	]
	quest.3DB66BE0B9F99810.title: "Edelsteine"
	quest.3DB6BB309B2C16D1.quest_desc: [
		"Stufe 5. Nie wieder in Netherfestungen nach Schädeln suchen."
	]
	quest.3DB6BB309B2C16D1.title: "Witherskelett-Samen"
	quest.3DBB6672FD6FDF6A.quest_desc: [
		"Aus Tiefenschiefer gebaut und dann infundiert. Tiefenregale heben Eterna weit nach oben."
	]
	quest.3DBB6672FD6FDF6A.title: "Tiefenregal"
	quest.3DD23B3529E4A781.quest_desc: [
		"Stufe-6-Samen wachsen nur, wenn der passende &eCrux&r-Block unter dem Ackerland liegt. Für den Netherstern-Crux brauchst du eine Seele des Withers."
	]
	quest.3DD23B3529E4A781.title: "Netherstern-Crux"
	quest.3DE2CF269CEE9D56.quest_desc: [
		"Kettenförderer verbinden Punkte über weite Strecken, auch schräg. Frösche hängen sich daran."
	]
	quest.3DE2CF269CEE9D56.title: "Kettenförderer"
	quest.3DF1C3E3A3F87F66.quest_desc: [
		"Ein Teleport-Pad im End führt nach &eThe Beyond&r. Hier wartet das seltenste Erz: Unobtainium."
	]
	quest.3DF1C3E3A3F87F66.title: "The Beyond"
	quest.3DF264E807652FCA.quest_desc: [
		"Noch eine Presse, noch ein Prozessor. Diesmal für die stärksten Geräte."
	]
	quest.3DF264E807652FCA.title: "Quantenprozessor"
	quest.3DF368E0579A9494.quest_desc: [
		"Der neue Prozessor von MEGA Cells. Für die Presse brauchst du eine Singularität."
	]
	quest.3DF368E0579A9494.title: "Akkumulationsprozessor"
	quest.3DF618E84FA965AE.quest_desc: [
		"Die höchste Stufe, mit Diamant. Die brauchst du für Controller und Laufwerk."
	]
	quest.3DF618E84FA965AE.title: "Fortschrittlicher Prozessor"
	quest.3DFDB1DEA868495B.quest_desc: [
		"Du hast alles erreicht, was dieses Pack zu bieten hat. Glückwunsch!\n\nZeit für eine neue Welt? Oder einfach eine riesige Basis bauen."
	]
	quest.3DFDB1DEA868495B.title: "Pack geschafft!"
	quest.3E041442747DF14B.quest_desc: [
		"Wirft Items über eine einstellbare Strecke. Ziel festlegen, indem du mit dem Werfer in der Hand auf den Zielblock klickst."
	]
	quest.3E041442747DF14B.title: "Gewichteter Werfer"
	quest.3E1FAD93F81B5307.quest_desc: [
		"Stein plus Komprimiertes Eisen ergibt &eVerstärkten Stein&r, daraus werden Ziegel. Das ist das Baumaterial für Kompressoren und die Druckkammer."
	]
	quest.3E1FAD93F81B5307.title: "Verstärkter Stein"
	quest.3E2C5AC4B07DA4F9.quest_desc: [
		"Das Gehäuse ist die Basis aller Maschinen von Mystical Agriculture."
	]
	quest.3E2C5AC4B07DA4F9.title: "Maschinengehäuse"
	quest.3E35E074DA8BB04C.quest_desc: [
		"Wirf einen Certus-Quarzblock mit geladenem Certus ins Wasser, dann bekommst du einen knospenden Block. Daran wachsen neue Kristalle. Abbauen verschlechtert den Block, also lass ihn am besten stehen."
	]
	quest.3E35E074DA8BB04C.title: "Certus züchten"
	quest.3E3D573F7C12ED85.quest_desc: [
		"Der eiserne Ritter von Mowzie's Mobs schläft in einer Kammer unter der Erde.\n\nVon vorne ist er kaum zu verletzen. Weich seinen Schlägen aus und greif ihn von &ehinten&r an."
	]
	quest.3E3D573F7C12ED85.title: "Ferrous Wroughtnaut"
	quest.3E48A0A8DF2827F0.quest_desc: [
		"Unreine weiße Kreide machst du aus Otherstone- und Anderswelt-Holz-Staub. Im Geisterfeuer wird sie rein. Mit Kreide zeichnest du die Pentakel auf den Boden."
	]
	quest.3E48A0A8DF2827F0.title: "Weiße Kreide"
	quest.3E4D42A8A5946FB6.quest_desc: [
		"Damit sammelst du Blut. Wie genau, steht im Handbuch."
	]
	quest.3E4D42A8A5946FB6.title: "Blutextraktor"
	quest.3E54C0C2B080EB27.quest_desc: [
		"Das schwerere Set für Bogenschützen. Es braucht Netheritschrott."
	]
	quest.3E54C0C2B080EB27.title: "Kriegsbogner-Rüstung"
	quest.3E6BB1FFBA712E40.quest_desc: [
		"Der Dynamo macht aus Drehbewegung Strom. Davor gehört ein Windrad oder ein Wasserrad."
	]
	quest.3E6BB1FFBA712E40.title: "Kinetischer Dynamo"
	quest.3E78CE6AF6D12441.quest_desc: [
		"Der Djinni-Miner gräbt schneller und findet nur Erze statt Steinen."
	]
	quest.3E78CE6AF6D12441.title: "Erz-Djinni"
	quest.3E7B8C9835E098F1.quest_desc: [
		"Lager für Zutaten. Was darin liegt, kann der Kochtisch direkt benutzen."
	]
	quest.3E7B8C9835E098F1.title: "Kühlschrank"
	quest.3E7DA96A7C831B00.quest_desc: [
		"Robustes Blech auf einen Messingrahmen. Aus diesem Rahmen baust du alles rund um Züge."
	]
	quest.3E7DA96A7C831B00.title: "Zugrahmen"
	quest.3E7F08C454BEF363.quest_desc: [
		"Goldgelbes Erz im Nether. Mit Netherziegeln wird daraus die Cincinnasit-Schmiede, ein Ofen aus BetterNether."
	]
	quest.3E7F08C454BEF363.title: "Cincinnasit"
	quest.3E878362E1F67252.quest_desc: [
		"Zahnräder geben Rotation seitlich weiter. Klein auf groß halbiert die Drehzahl, groß auf klein verdoppelt sie."
	]
	quest.3E878362E1F67252.title: "Zahnräder"
	quest.3E9F2F5CEE33634E.quest_desc: [
		"Flüssigkeitszellen speichern Wasser, Lava und Co. direkt im Netzwerk."
	]
	quest.3E9F2F5CEE33634E.title: "Flüssigkeiten speichern"
	quest.3EA582ECEB7CA600.quest_desc: [
		"Der &eEnergiekern&r ist ein riesiger Multiblock-Stromspeicher. Die vier &eStabilisatoren&r stehen im Abstand um ihn herum."
		""
		"Für jede höhere Stufe braucht er mehr Blöcke. Aufbau zeigt dir die Vorschau im Kern."
	]
	quest.3EA582ECEB7CA600.title: "Energiekern"
	quest.3ECDA126A0A76789.quest_desc: [
		"Der &eDislocator&r ist ein Teleporter für einen Ort. Später bekommst du die bessere Version mit vielen Orten."
	]
	quest.3ECDA126A0A76789.title: "Dislocator"
	quest.3EE283F027BBD1FE.quest_desc: [
		"Der Anführer der Umvuthana lebt in einem Hain in der Savanne. Seine Krieger beschützen ihn.\n\nZur Belohnung gibt es das &eSol Visage&r."
	]
	quest.3EE283F027BBD1FE.title: "Umvuthi"
	quest.3EE55C555AFA1CFF.quest_desc: [
		"Obsidian entsteht, wenn Wasser auf stehende Lava trifft. Für einen Zaubertisch und ein Netherportal brauchst du einiges davon."
	]
	quest.3EE55C555AFA1CFF.title: "Obsidian"
	quest.3EE9AEF93439A0A6.quest_desc: [
		"Eine Schmiede im Nether, bewacht von einem feurigen Boss."
	]
	quest.3EE9AEF93439A0A6.title: "Seelenschmiede"
	quest.3EEAE7329C5B6421.quest_desc: [
		"Die stärkste Reaktor-Stufe von Powah. Mehr Strom geht kaum."
	]
	quest.3EEAE7329C5B6421.title: "Nitro-Reaktor"
	quest.3EEC59BA274383E5.quest_desc: [
		"Create Crafts & Additions bringt Strom (FE) zu Create. Das Walzwerk macht aus Barren Stangen und aus Blechen Drähte."
	]
	quest.3EEC59BA274383E5.title: "Walzwerk"
	quest.3EEDEF3CD8C7C6F8.quest_desc: [
		"Simply Swords: Cataclysm wertet Netheritwaffen mit Cataclysm-Material auf. Für Ignitium brauchst du Barren von Ignis und die Ignitium-Schmiedevorlage."
	]
	quest.3EEDEF3CD8C7C6F8.title: "Klinge der Flamme"
	quest.3EEDF0DF07DA1CFB.quest_desc: [
		"Die &eVerarbeitungseinheit&r baut der Zusammenfüger aus Kohlefaser, Elektrum, Redstone und Plastik."
	]
	quest.3EEDF0DF07DA1CFB.title: "Verarbeitungseinheit"
	quest.3EFD5FA88E1AAA10.quest_desc: [
		"Beim Angeln fängst du manchmal Neptune's Kopfgeld. Darin steckt Neptunium."
		""
		"Daraus baust du die beste Angel und Werkzeuge, die unter Wasser stark sind."
	]
	quest.3EFD5FA88E1AAA10.title: "Neptunium"
	quest.3F00796294373357.quest_desc: [
		"Der &eDraconic-Energiekern&r steckt in allen Draconic-Werkzeugen."
	]
	quest.3F00796294373357.title: "Draconic-Energiekern"
	quest.3F04F69F9F1ABFA4.quest_desc: [
		"Kabel spannst du zwischen Anschlüssen, einfach mit der Drahtspule beide Anschlüsse anklicken. LV ist für kleine Maschinen."
	]
	quest.3F04F69F9F1ABFA4.title: "Kupferkabel (LV)"
	quest.3F1E4D366B3FBB15.quest_desc: [
		"Der Anforderer hält eine Menge von Items immer vorrätig und gibt dafür selbst Aufträge an die CPU. So hast du immer genug Platten, Schaltkreise und Co."
	]
	quest.3F1E4D366B3FBB15.title: "ME Anforderer"
	quest.3F33638E01AF670E.quest_desc: [
		"Die infundierte Bibliothek speichert Verzauberungen bis zur höchsten Stufe."
	]
	quest.3F33638E01AF670E.title: "Bibliothek von Alexandria"
	quest.3F3A438B6BAD74DA.quest_desc: [
		"Ars Elemental bringt Elementar-Fokusse, neue Rüstungen und Wesen. Fang mit dem &eSchmuckbeutel&r an: Er hält deine Ringe und Amulette."
	]
	quest.3F3A438B6BAD74DA.title: "Ars Elemental"
	quest.3F4F7B18959C414F.quest_desc: [
		"Supremium-Ackerland gibt Supremium-Pflanzen die beste Ernte."
	]
	quest.3F4F7B18959C414F.title: "Supremium-Ackerland"
	quest.3F50936509DD62AD.quest_desc: [
		"Ein riesiger Wurm, der aus dem Sand bricht. Bleib in Bewegung."
	]
	quest.3F50936509DD62AD.title: "Sirok, der Sandwurm"
	quest.3F610A9137CB0820.quest_desc: [
		"Gravitit-Erz liegt tief auf den Inseln. Im Altar verzaubert, wird daraus das beste Aether-Material. Gravitit-Werkzeuge können Blöcke schweben lassen."
	]
	quest.3F610A9137CB0820.title: "Gravitit"
	quest.3F6463A66507FE48.quest_desc: [
		"Der &eCelestial Manipulator&r ändert Wetter und Tageszeit. Braucht ein Drachenei."
	]
	quest.3F6463A66507FE48.title: "Wetter und Zeit"
	quest.3F79C0D11D560619.quest_desc: [
		"Goblin-Ritter lassen Rüstungsscherben fallen. Daraus werden Scherbencluster und im Ofen Rittermetall."
	]
	quest.3F79C0D11D560619.title: "Rittermetall"
	quest.3F7B74812FA43CDE.quest_desc: [
		"Dörfer, Händler und Tavernen: Gib 32 Smaragde ab."
	]
	quest.3F7B74812FA43CDE.title: "Abgabe: Smaragde"
	quest.3F7C592F2E7E087A.quest_desc: [
		"Unter Wasser, mit Wächtern. Nimm Atemtränke mit. Drinnen gibt es mehr zu holen als früher."
	]
	quest.3F7C592F2E7E087A.title: "Ozeanmonument"
	quest.3F86E88A0B9A1F94.quest_desc: [
		"Der &eEnderische Laser&r baut aus der Ferne Blöcke ab und lädt Maschinen auf. Auf Amethyst-Cluster gerichtet liefert er &eFluxit&r."
	]
	quest.3F86E88A0B9A1F94.title: "Enderischer Laser"
	quest.3F90BFD5E954802F.quest_desc: [
		"Die Ostrum-Rakete fliegt zu Venus und Merkur."
	]
	quest.3F90BFD5E954802F.title: "Rakete Stufe 3"
	quest.3F9CA97D6CA7CFF0.quest_desc: [
		"Copycat-Blöcke übernehmen das Aussehen jedes Blocks, den du hineinsetzt. Perfekt für Schrägen und Details."
	]
	quest.3F9CA97D6CA7CFF0.title: "Copycats+"
	quest.3FA0258302E9D77D.quest_desc: [
		"Iron's Spells arbeitet mit &eSchriftrollen&r, die du in Zauberbücher einträgst. Das einfachste Buch ist das Notizbuch aus Kupfer, Papier und Faden.\n\nRüste das Buch aus und wähl Zauber über das Zauberrad. Die Tasten stehen in den Steuerungs-Einstellungen."
	]
	quest.3FA0258302E9D77D.title: "Das erste Notizbuch"
	quest.3FC2E79AAA27DEE3.quest_desc: [
		"Fast alle Samen entstehen im &eInfusionsaltar&r: Samenbasis auf den Altar, Zutaten auf die 8 Sockel drumherum, dann mit Redstone-Signal oder Zauberstab starten."
	]
	quest.3FC2E79AAA27DEE3.title: "Infusionsaltar"
	quest.3FCA9D21D5317F28.quest_desc: [
		"Macht aus Lava Strom. Mit einer Pumpe aus einem Lavasee kaum zu schlagen."
	]
	quest.3FCA9D21D5317F28.title: "Magmator"
	quest.3FD3797A0A7FAF9E.quest_desc: [
		"Der Flux Accessor gibt Energie aus dem Netz an angrenzende Maschinen ab und nimmt welche auf."
	]
	quest.3FD3797A0A7FAF9E.title: "Flux Accessor"
	quest.3FE0DF4BB235F90E.quest_desc: [
		"Stahl ist überall drin, von Kabeln bis Reaktoren. Gib 64 Barren ab."
	]
	quest.3FE0DF4BB235F90E.title: "Abgabe: Stahl"
	quest.3FE7A841227439E3.quest_desc: [
		"In diesem Kapitel gibt es zwei Wege: &eForbidden & Arcanus&r (Hephaistos-Schmiede, Rituale, mächtige Ausrüstung) und &eHexerei&r (Kräuter, Mischkessel, Hexenbesen).\n\nDu kannst beide parallel angehen."
	]
	quest.3FE7A841227439E3.title: "Zwei dunkle Künste"
	quest.5012B39CCC4CDE00.quest_desc: [
		"FE-Speicherzellen kommen ins Laufwerk wie normale Zellen und speichern Strom."
	]
	quest.5012B39CCC4CDE00.title: "Energie-Zellen"
	quest.50290344954AE7D3.quest_desc: [
		"Die Krönung der Logistik: Die Fabrikanzeige hält Bestände auf einer Zielmenge und bestellt fehlende Zutaten selbst nach.\n\nDamit baust du vollautomatische Fabriken. Glückwunsch!"
	]
	quest.50290344954AE7D3.title: "Fabrikanzeige"
	quest.5036EB41C6E29624.quest_desc: [
		"Logistiktransporter bewegen Items zwischen Maschinen und Kisten."
	]
	quest.5036EB41C6E29624.title: "Logistik"
	quest.504741EBFA526ACB.quest_desc: [
		"Mit dem TP-Link verbindest du Teleporter. Wie genau, steht im Ponder."
	]
	quest.504741EBFA526ACB.title: "Teleporter"
	quest.505F78FCC8CB2681.quest_desc: [
		"Gib 32 Yellorium-Barren ab."
	]
	quest.505F78FCC8CB2681.title: "Abgabe: Yellorium"
	quest.50821113BF0AD456.quest_desc: [
		"Das Drachen-Endregal braucht einen Drachenkopf und hebt die maximale Stufe auf das Höchste."
	]
	quest.50821113BF0AD456.title: "Perle und Drache"
	quest.5098D991BEFCBF06.quest_desc: [
		"Die höchste Stufe. Mehr passt in keine Truhe."
	]
	quest.5098D991BEFCBF06.title: "Netherittruhe"
	quest.509B69003A10EB4E.quest_desc: [
		"Lohen spawnen an ihren Spawnern in der Festung. Ihre Ruten brauchst du für Braustand und Enderaugen."
	]
	quest.509B69003A10EB4E.title: "Lohenruten"
	quest.509DCAB5A030436D.quest_desc: [
		"When Dungeons Arise baut riesige Dungeons. Gesucht ist hier die &eIllager-Windmühle&r (Illager Windmill) in den Ebenen, ein guter Einstieg."
	]
	quest.509DCAB5A030436D.title: "When Dungeons Arise"
	quest.50CF667663A82826.quest_desc: [
		"Kugel plus Rune ergibt eine Upgrade-Kugel. Am Arkanen Amboss setzt du sie in Rüstung ein: mehr Mana oder mehr Kraft für eine Schule."
	]
	quest.50CF667663A82826.title: "Upgrade-Kugeln"
	quest.50DC05F5CADA6E63.quest_desc: [
		"Mit diesem Ritual im Kohlenbecken rufst du Wilden herbei. Mit den richtigen Zutaten erscheint der Boss. Lies im Handbuch nach, bevor du es zündest."
	]
	quest.50DC05F5CADA6E63.title: "Wilden beschwören"
	quest.50E8691B34B8D316.quest_desc: [
		"Redstone findest du tief unten. Es ist der Strom von Minecraft und steckt in vielen Rezepten."
	]
	quest.50E8691B34B8D316.title: "Redstone"
	quest.50FE1C5C54F67A0D.quest_desc: [
		"Der Ring der Erholung senkt Abklingzeiten, der Affinitätsring stärkt einen bestimmten Zauber."
	]
	quest.50FE1C5C54F67A0D.title: "Mithril-Ringe"
	quest.511EF995ECE52051.quest_desc: [
		"Die größten Zellen in Basis-AE2. Für 256k brauchst du Himmelssteinstaub, noch größer geht es mit MEGA Cells."
	]
	quest.511EF995ECE52051.title: "Große Zellen"
	quest.5121871558184D56.quest_desc: [
		"Kondensatoren bestimmen die Stufe einer Maschine. Starter-Geräte brauchen den kleinen, Basic-Geräte den normalen."
	]
	quest.5121871558184D56.title: "Kondensatoren"
	quest.5122D4BA6B16C1E2.quest_desc: [
		"Lagererweiterungen vervielfachen den Platz einer Schublade. Je wertvoller das Material, desto mehr passt rein."
	]
	quest.5122D4BA6B16C1E2.title: "Größere Schubladen"
	quest.513043436901FC89.quest_desc: [
		"Die wichtigste frühe Maschine. Sie infundiert Metalle mit Kohle, Redstone, Diamant und mehr."
	]
	quest.513043436901FC89.title: "Metallurgische Infusion"
	quest.513B6021C17F65C4.quest_desc: [
		"Er springt dich an und explodiert mit Wucht. Halte Abstand und kämpfe nicht neben deiner Basis."
	]
	quest.513B6021C17F65C4.title: "Mutantencreeper"
	quest.516522DF93B7D6D9.quest_desc: [
		"Der &eDraconium-Kern&r ist die erste Stufe. Davon brauchst du später viele."
	]
	quest.516522DF93B7D6D9.title: "Draconium-Kern"
	quest.516A479A281A3835.quest_desc: [
		"Aquaculture bringt viele neue Fische und bessere Angeln. Was du fängst, hängt vom Biom ab."
		""
		"Haken, Köder und Angelschnur lassen sich in die Angel einsetzen. Schau in EMI."
	]
	quest.516A479A281A3835.title: "Eisen-Angel"
	quest.518665CD886E2345.quest_desc: [
		"Der Provider hält deine Schablonen und schickt die Zutaten an angrenzende Maschinen oder Assembler."
	]
	quest.518665CD886E2345.title: "Schablonen-Provider"
	quest.518978ACFC21C8F0.quest_desc: [
		"Der Fusionsreaktor erzeugt riesige Mengen Strom aus Deuterium und Tritium. Gezündet wird er mit einem Laser auf einen gefüllten Hohlraum."
	]
	quest.518978ACFC21C8F0.title: "Fusionsreaktor"
	quest.51A1B01C59E4D964.quest_desc: [
		"&eIron's Gems 'n Jewelry&r: Am Tisch fertigst du Ringe und Ketten mit Zauber-Boni. Das Handbuch erklärt die Muster."
	]
	quest.51A1B01C59E4D964.title: "Juwelier-Tisch"
	quest.51DEC18387EE0565.quest_desc: [
		"Lässt Items senkrecht fallen. Mit einem Lüfter darunter oder darüber geht es auch nach oben."
	]
	quest.51DEC18387EE0565.title: "Schacht"
	quest.51E01F3C8CED2872.quest_desc: [
		"Rote Kristalle, besonders stark gegen die Rotlinge (die Untoten des Undergarden)."
	]
	quest.51E01F3C8CED2872.title: "Utherium"
	quest.51E4D21A6312C705.quest_desc: [
		"Mit dem Schild in der Zweithand blockst du Pfeile und Creeper-Explosionen."
	]
	quest.51E4D21A6312C705.title: "Schild"
	quest.51E7BB7F837D0968.quest_desc: [
		"Das Amulett gibt mehr Mana, der Ring senkt die Zauberkosten."
	]
	quest.51E7BB7F837D0968.title: "Mana-Schmuck"
	quest.51EFFA8AFB7962C6.quest_desc: [
		"Bessere Tinte entsteht aus schlechterer plus Kupfer, dann Eisen."
	]
	quest.51EFFA8AFB7962C6.title: "Bessere Tinte"
	quest.520BFC98D63BDCF4.quest_desc: [
		"Ein elektrisches Werkzeug, das alles abbaut und mehrere Modi hat. Später Basis für das Meka-Tool."
	]
	quest.520BFC98D63BDCF4.title: "Atomarer Zerleger"
	quest.52131F74DCFDC6BC.quest_desc: [
		"YUNG's Better Nether Fortresses baut die Festungen komplett neu: größer, verwinkelter und mit mehr Beute.\n\nHier wachsen Netherwarzen und hier spawnen Lohen und Witherskelette."
	]
	quest.52131F74DCFDC6BC.title: "Netherfestung"
	quest.5216BF7A7ADDF655.quest_desc: [
		"Der Kraken greift mit seinen Tentakeln aus dem Wasser an."
	]
	quest.5216BF7A7ADDF655.title: "Nerakyss, der Kraken"
	quest.522419020433C05A.quest_desc: [
		"Ein Turm aus Flüssigkeitstanks mit Steuerung trennt Rohöl in verschiedene Treibstoffe."
	]
	quest.522419020433C05A.title: "Destillation"
	quest.522B1AB052C3313E.quest_desc: [
		"Bonus-Biom: eine Höhle aus Süßigkeiten. Lecker, aber nicht ungefährlich."
	]
	quest.522B1AB052C3313E.title: "Süße Höhle"
	quest.522B7A7AE31C231F.quest_desc: [
		"Schleim und Faden ergeben das Bindemittel für die Prozessoren."
	]
	quest.522B7A7AE31C231F.title: "Prozessor-Rohmaterial"
	quest.52330B932957B85D.quest_desc: [
		"Die nächste Stufe."
	]
	quest.52330B932957B85D.title: "Eisenrucksack"
	quest.52372F821CACBAE3.quest_desc: [
		"Ein Diamant im Geisterfeuer wird zum &eSpirit Attuned Gem&r. Er steckt in Lampen, Linsen, der Wünschelrute und vielem mehr."
	]
	quest.52372F821CACBAE3.title: "Geistergebundener Edelstein"
	quest.5238F7F69B050C3D.quest_desc: [
		"Ein ME-P2P-Tunnel schickt bis zu 32 Kanäle über ein einziges Kabel. Daneben gibt es P2P-Tunnel für Items, Flüssigkeiten, Redstone und FE."
	]
	quest.5238F7F69B050C3D.title: "P2P-Tunnel"
	quest.525DF83D3C7E1714.quest_desc: [
		"Wirf eine Enderperle auf ein Bienennest oder einen Bienenstock, schon bist du in der Bienenwelt.\n\nDie Bienen dort werden schnell wütend, also kein Honig klauen, ohne aufzupassen."
	]
	quest.525DF83D3C7E1714.title: "Bumblezone"
	quest.525E9C5AF90B003A.quest_desc: [
		"Der Tachometer zeigt die Drehzahl, der Stressmesser die Belastung des Netzes.\n\n&cÜberlastung&r stoppt das ganze Netz. Dann brauchst du mehr Kraftquellen oder weniger Maschinen."
	]
	quest.525E9C5AF90B003A.title: "Messgeräte"
	quest.525F86E4BD93E8BC.quest_desc: [
		"Mit der Brille siehst du beim Hinschauen Drehzahl, Belastung und Inhalt von Maschinen. Ein Muss!"
	]
	quest.525F86E4BD93E8BC.title: "Ingenieursbrille"
	quest.527D03498D23F798.quest_desc: [
		"Der Erz-Evoker hält sich in einem Fort auf. Er beschwört Vexe und Fangzähne."
	]
	quest.527D03498D23F798.title: "Erz-Evoker"
	quest.527D7BE1E12B556A.quest_desc: [
		"Am Amboss kombinierst du Schriftrollen zu höheren Stufen und setzt &eUpgrade-Kugeln&r in Rüstung ein."
	]
	quest.527D7BE1E12B556A.title: "Arkaner Amboss"
	quest.52AACD6970BCEA12.quest_desc: [
		"Erweiterte Schnittstelle und erweitertes Laufwerk: mehr Plätze pro Block, weniger Platzbedarf im Speicherraum."
	]
	quest.52AACD6970BCEA12.title: "Mehr Platz"
	quest.52B7D2B3E1662907.quest_desc: [
		"Die &eUV-Lichtbox&r belichtet leere Platinen. Sie braucht Druckluft, und je länger belichtet wird, desto besser."
	]
	quest.52B7D2B3E1662907.title: "UV-Lichtbox"
	quest.52D2A51CDCD2661F.quest_desc: [
		"Industriepresse macht Pflanzenöl, Industriefermenter macht Ethanol, die Raffinerie mischt beides zu Biodiesel."
	]
	quest.52D2A51CDCD2661F.title: "Biodiesel"
	quest.52D5B8E3FEC04198.quest_desc: [
		"&eCataclysm: Spellbooks&r verbindet Iron's Spells mit L_Ender's Cataclysm. Den Stab baust du aus einem Amethyst-Krabbenpanzer."
	]
	quest.52D5B8E3FEC04198.title: "Blütenstein-Stab"
	quest.52E0C3AF5E700AE5.quest_desc: [
		"Lohenstaub plus Enderperle. Wirf ein Auge in die Luft, es fliegt Richtung Festung. Für das Endportal brauchst du bis zu 12 Stück."
	]
	quest.52E0C3AF5E700AE5.title: "Enderaugen"
	quest.52EC4ED19725FA3F.quest_desc: [
		"Create: Connected. Die Batterie speichert Rotation und gibt sie später wieder ab. Connected hat noch viele kleine Helfer wie Bremse und Kupplungen."
	]
	quest.52EC4ED19725FA3F.title: "Kinetische Batterie"
	quest.52F8EC74625961E6.quest_desc: [
		"Farmer's Delight bringt eine richtige Küche. Alles beginnt mit dem Messer."
		""
		"Mit dem Messer bekommst du von Tieren Extra-Zutaten und von hohem Gras Stroh."
	]
	quest.52F8EC74625961E6.title: "Küchenmesser"
	quest.530370D2275B9F1A.quest_desc: [
		"Mit Stufen-Upgrades bekommt der Reiserucksack mehr Platz und größere Tanks."
	]
	quest.530370D2275B9F1A.title: "Reiserucksack aufwerten"
	quest.53306CC04399A8A6.quest_desc: [
		"Ein Ofen für die Küche. Der Kochtisch kann damit auch Gerichte zubereiten, die gebraten werden müssen."
	]
	quest.53306CC04399A8A6.title: "Küchenofen"
	quest.5330D1AF3B7B2CB2.quest_desc: [
		"Arkanes Kristallerz findest du tief unter der Erde. Der Kristall ist der Grundstoff für fast alles in Forbidden & Arcanus."
	]
	quest.5330D1AF3B7B2CB2.title: "Arkaner Kristall"
	quest.5334A676EBED47DD.quest_desc: [
		"Netherit-Werkzeug und -Rüstung halten fast alles aus und brennen nicht in Lava. Jetzt steht dir das ganze Pack offen!"
	]
	quest.5334A676EBED47DD.title: "Bestens ausgerüstet"
	quest.53359954A9CCC95F.quest_desc: [
		"Mit Genen kannst du Eigenschaften wie Produktivität oder Hitzetoleranz auf Bienen übertragen. Der Indexer sortiert deine Gen-Proben."
	]
	quest.53359954A9CCC95F.title: "Gen-Indexer"
	quest.533E9D8FD7617ABA.quest_desc: [
		"Quests sind gesperrt, bis ihre Vorgänger erledigt sind. Die Linien zeigen, was wovon abhängt."
		""
		"Items werden automatisch erkannt, sobald du sie im Inventar hast. Belohnungen musst du selbst anklicken."
	]
	quest.533E9D8FD7617ABA.title: "So geht das Questbuch"
	quest.5346935B168B88AE.quest_desc: [
		"Einfache und fortgeschrittene &eSpulen&r brauchst du für fast alle weiteren Maschinen."
	]
	quest.5346935B168B88AE.title: "Spulen"
	quest.534BDCAE13F52BC7.quest_desc: [
		"Die &eDraconic-Brustplatte&r: großer Schild, und mit dem Flug-Modul kannst du fliegen."
	]
	quest.534BDCAE13F52BC7.title: "Draconic-Brustplatte"
	quest.534F744EBD8EB6DC.quest_desc: [
		"Strom aus Sonnenlicht, ganz ohne Brennstoff. Nachts ist Pause."
	]
	quest.534F744EBD8EB6DC.title: "Solarpanel"
	quest.535FEF3FD863A74A.quest_desc: [
		"Die Gartenglocke lässt Pflanzen mit Strom wachsen. Gut für Hanf, Kürbisse und Co."
	]
	quest.535FEF3FD863A74A.title: "Gartenglocke"
	quest.536CB221B0973737.quest_desc: [
		"Bessere Module für mehr Energie und einen stärkeren Schild."
	]
	quest.536CB221B0973737.title: "Wyvern-Module"
	quest.536E567B4BFC8730.quest_desc: [
		"Das stärkste Metall des Packs. Abbauen kannst du es nur mit Vibranium-Werkzeug."
	]
	quest.536E567B4BFC8730.title: "Unobtainium"
	quest.53743B61F7C8A1BE.quest_desc: [
		"Die Labyrinthmutter schwimmt durch das Eislabyrinth und greift aus der Tiefe an."
	]
	quest.53743B61F7C8A1BE.title: "Labyrinthmutter"
	quest.537444F0AE80D61C.quest_desc: [
		"Draconium-Staub schmilzt du im Ofen zu &eDraconium-Barren&r."
	]
	quest.537444F0AE80D61C.title: "Draconium-Barren"
	quest.53853B92B6039F45.quest_desc: [
		"Speichert &eQuelle&r (Source), die Energie dieser Mod. Maschinen ziehen sie aus Gläsern in der Nähe."
	]
	quest.53853B92B6039F45.title: "Quellglas"
	quest.53894892051DF4F1.quest_desc: [
		"Magnetspulen und Motoren stecken in fast jeder Oritech-Maschine. Mach gleich ein paar mehr."
	]
	quest.53894892051DF4F1.title: "Spulen und Motoren"
	quest.539E2A03C207057A.quest_desc: [
		"Stahlblatt findest du beim Erkunden des Twilight Forest. Daraus gibt es Werkzeuge und Rüstung."
	]
	quest.539E2A03C207057A.title: "Stahlblatt"
	quest.53B1A1FE2A58E117.quest_desc: [
		"Ein Teleport-Pad im Nether bringt dich nach &eThe Other&r. Dort ist es gefährlich, aber hier liegt Vibranium."
	]
	quest.53B1A1FE2A58E117.title: "The Other"
	quest.53BD55348A6B2EFD.quest_desc: [
		"Verstärkte Platten sind Zutat für viele Maschinen und Addons."
	]
	quest.53BD55348A6B2EFD.title: "Verstärkte Platten"
	quest.53C83E6645F9B3E6.quest_desc: [
		"Gib 64 Komprimiertes Eisen ab und hol dir eine Belohnung."
	]
	quest.53C83E6645F9B3E6.title: "Abgabe: Komprimiertes Eisen"
	quest.53E26D0B0248FF19.quest_desc: [
		"Der Energiewürfel speichert Strom und lädt Items auf. Später rüstest du ihn Stufe für Stufe auf."
	]
	quest.53E26D0B0248FF19.title: "Energiewürfel"
	quest.5424D10A69C591E1.quest_desc: [
		"Der brennende Ritter wartet in der Brennenden Arena im Nether. Das &eFlammenauge&r zeigt dir den Weg.\n\nEr hinterlässt Ignitium, eines der besten Materialien im Pack."
	]
	quest.5424D10A69C591E1.title: "Ignis"
	quest.54325F6FE566120E.quest_desc: [
		"Die beste Brustplatte von Draconic Evolution mit dem größten Schild."
	]
	quest.54325F6FE566120E.title: "Chaotische Brustplatte"
	quest.54356D11368FAB00.quest_desc: [
		"Aus verzaubertem Stoff nähst du dir Hut, Robe und Stiefel einer echten Hexe."
	]
	quest.54356D11368FAB00.title: "Hexengewand"
	quest.545C8319D8611E95.quest_desc: [
		"Zombie, Skelett, Creeper und Spinne sind Stufe 3. Dafür brauchst du je eine volle Seelenurne."
	]
	quest.545C8319D8611E95.title: "Monster-Samen"
	quest.5460162DB1C3C268.quest_desc: [
		"Kleiner Fokus plus Meisterzeichen ergibt den großen Fokus deines Elements. Hak ab, wenn du einen hast."
	]
	quest.5460162DB1C3C268.title: "Großer Fokus"
	quest.5481C6F79B78ABC3.quest_desc: [
		"Einfaches Gehäuse, Kunststoff, Netheritschrott, Gold und ein Diamantzahnrad, dazu pinker Schleim im Auflösungsapparat."
	]
	quest.5481C6F79B78ABC3.title: "Fortschrittliches Gehäuse"
	quest.548A32AAD28AB0FC.quest_desc: [
		"Das Handbuch erklärt jede Maschine von Powah. Ein Buch plus Paste."
	]
	quest.548A32AAD28AB0FC.title: "Powah-Handbuch"
	quest.548CE9F9E7033ADC.quest_desc: [
		"Deorum ist ein magisches Gold aus Goldbarren, Kristallstaub, Mundabitur-Staub und Holzkohle."
	]
	quest.548CE9F9E7033ADC.title: "Deorum"
	quest.548DE04BFBE19EE0.quest_desc: [
		"Essenz-Ackerland erhöht die Ernte von Pflanzen der gleichen Stufe."
	]
	quest.548DE04BFBE19EE0.title: "Inferium-Ackerland"
	quest.54A1DBEB104BDEDA.quest_desc: [
		"Ein &eAufzug&r aus Basis und Rahmen, der mit Druckluft fährt. Mit dem Elevator Caller rufst du ihn auf jedes Stockwerk."
	]
	quest.54A1DBEB104BDEDA.title: "Aufzug"
	quest.54AB18BE5C3A357F.quest_desc: [
		"Die beste Angel von Aquaculture."
	]
	quest.54AB18BE5C3A357F.title: "Neptunium-Angel"
	quest.54AB88392A129F40.quest_desc: [
		"Bienenhelm, -brustpanzer, -hose und -stiefel geben dir besondere Fähigkeiten im Umgang mit Bienen. Du bekommst sie z. B. beim Tausch mit der Bee Queen. Hak ab, wenn du ein Teil hast."
	]
	quest.54AB88392A129F40.title: "Bienenrüstung"
	quest.54B68CA0B2656BAF.quest_desc: [
		"Leg das Blutsiegel in den Kessel und spring dreimal hinein. Das Blut füllst du in eine Flasche ab."
	]
	quest.54B68CA0B2656BAF.title: "Blutsiegel"
	quest.54B72C2B9145C579.quest_desc: [
		"Wie das Andesitgehäuse, nur mit Messing. Für die schlaueren Maschinen."
	]
	quest.54B72C2B9145C579.title: "Messingrahmen"
	quest.54C39A5283D2D0BA.quest_desc: [
		"Der höllische Drache ist der stärkste Boss von Bosses'Rise. Feuerschutz ist Pflicht."
	]
	quest.54C39A5283D2D0BA.title: "Ashlord"
	quest.5526B75543C0038E.quest_desc: [
		"Schau einen Block oder ein Tier an: Oben am Bildschirm zeigt Jade Name, Mod und z. B. den Fortschritt einer Maschine."
	]
	quest.5526B75543C0038E.title: "Jade: Was ist das?"
	quest.553AAAE0FFEDA20E.quest_desc: [
		"Inferium-Samen wachsen zu mehr Inferium-Essenz. Je besser das Ackerland darunter, desto mehr Essenz pro Ernte."
	]
	quest.553AAAE0FFEDA20E.title: "Inferium-Samen"
	quest.55487E634C671C0C.quest_desc: [
		"Easy Villagers: Dorfbewohner lassen sich als Item mitnehmen. Wie das geht, steht in EMI. So ziehst du mit ihnen um, ohne sie mühsam zu führen."
	]
	quest.55487E634C671C0C.title: "Dorfbewohner einpacken"
	quest.555069810060F442.quest_desc: [
		"Simple Voice Chat: Mit &eV&r öffnest du das Menü, dort stellst du Mikrofon und Lautstärke ein. Standardmäßig sprichst du mit gedrückter Push-to-Talk-Taste (Feststelltaste)."
		""
		"Wer weiter weg ist, hört dich leiser. In Gruppen hören sich alle überall."
	]
	quest.555069810060F442.title: "Voice Chat"
	quest.5552DE1973760971.quest_desc: [
		"Auch im End gibt es etwas Neues: eine Burg auf den äußeren Inseln."
	]
	quest.5552DE1973760971.title: "End-Burg"
	quest.555A4B2D3C60608F.quest_desc: [
		"Drachenschuppen, Obsidianstahl und eine Netherit-Brustplatte werden in einer Stufe-2-Schmiede zur &eDraco-Arcanus&r-Rüstung.\n\nDrachenschuppen hinterlässt der Enderdrache."
	]
	quest.555A4B2D3C60608F.title: "Draco Arcanus"
	quest.55624FF1397A2BE0.quest_desc: [
		"Alraune, Tollkirsche, Beifuß und Ampfer wachsen wild in der Welt. Rechtsklick auf eine reife Pflanze gibt dir die Blüten."
	]
	quest.55624FF1397A2BE0.title: "Hexenkräuter"
	quest.5587164CA2B6729B.quest_desc: [
		"Leitungsbinder-Verbundstoff im Ofen ergibt Leitungsbinder. Damit und mit Legierungen baust du Leitungen für Strom, Items, Flüssigkeiten und Redstone (dafür Redstone-Legierung aus Kupfer und Redstone). Mehrere Sorten passen in denselben Block."
	]
	quest.5587164CA2B6729B.title: "Leitungen"
	quest.559C55F0FA269F56.quest_desc: [
		"Baut den Block vor sich ab. Mit einem Bohrer an einer Contraption gräbst du ganze Tunnel."
	]
	quest.559C55F0FA269F56.title: "Mechanischer Bohrer"
	quest.55A08EC167F70FB3.quest_desc: [
		"Die Zaubererrobe mit Netherit aufgewertet: viel Schutz und Mana."
	]
	quest.55A08EC167F70FB3.title: "Netherit-Kampfmagier"
	quest.55B355EB5FB49019.quest_desc: [
		"Mystical Agradditions bringt eine sechste Stufe: &5Insanium&r. Vier Supremium-Essenzen ergeben ein Insanium."
	]
	quest.55B355EB5FB49019.title: "Insanium"
	quest.55BA8DDE2362A284.quest_desc: [
		"Create Jetpack: Fliegen mit Druckluft. Braucht Elytren, also erst ins End."
	]
	quest.55BA8DDE2362A284.title: "Jetpack"
	quest.55CBF3EEE1C73453.quest_desc: [
		"Eine riesige Schlange im Innenhof aus Nagastein. Sie ist schnell, also nicht im Freien herumstehen."
	]
	quest.55CBF3EEE1C73453.title: "Die Naga"
	quest.55CD268875F82883.quest_desc: [
		"Ein Apfel mit Allthemodium-Nuggets. Ein teurer, aber starker Snack."
	]
	quest.55CD268875F82883.title: "Allthemodium-Apfel"
	quest.5602D2237114336F.quest_desc: [
		"Verbrennt Treibstoff und liefert kräftige Rotation. Größere Motoren gibt es auch."
	]
	quest.5602D2237114336F.title: "Dieselmotor"
	quest.5603A84865332C9B.quest_desc: [
		"Eine verfluchte Pyramide in der Wüste."
	]
	quest.5603A84865332C9B.title: "Verfluchte Pyramide"
	quest.560D1EA0B060B764.quest_desc: [
		"Holz, Eisen und Redstone ergeben das primitive Maschinengehäuse. Darauf bauen die ersten Maschinen auf."
	]
	quest.560D1EA0B060B764.title: "Primitives Gehäuse"
	quest.56210A817EE386B4.quest_desc: [
		"Aus Zellstoff gepresst. Karton ist das Material für das Paketsystem von Create 6."
	]
	quest.56210A817EE386B4.title: "Karton"
	quest.564618AB69ED6D1D.quest_desc: [
		"Infundierter Drachenatem ist die Zutat für das &eEndregal&r, eines der stärksten Regale."
	]
	quest.564618AB69ED6D1D.title: "Endregal"
	quest.565E8956BF7D174D.quest_desc: [
		"Folge den Enderaugen bis zur Festung. YUNG's Better Strongholds macht daraus ein riesiges Labyrinth mit Fallen.\n\nIrgendwo darin liegt der Portalraum."
	]
	quest.565E8956BF7D174D.title: "Die Festung"
	quest.56611F476884C54B.quest_desc: [
		"In der &eBumblezone&r, der Bienendimension, wachsen Honigkristalle. Wie du hinkommst, steht im Kapitel Dimensionen."
	]
	quest.56611F476884C54B.title: "Honigkristalle"
	quest.566EE65F77EC43F1.quest_desc: [
		"Das beste Zauberbuch: das meiste Mana und alle Glyphen. Es braucht den Wilden-Tribut und einen Netherstern."
	]
	quest.566EE65F77EC43F1.title: "Erzmagier"
	quest.56734AB9ED4111D8.quest_desc: [
		"Jede Stufe kann mehr speichern. Alte Zellen werden beim Aufrüsten mitverbaut."
	]
	quest.56734AB9ED4111D8.title: "Bessere Speicher"
	quest.567BAE142A02038B.quest_desc: [
		"Eine volle Eisenrüstung macht dich deutlich robuster."
	]
	quest.567BAE142A02038B.title: "Eisenrüstung"
	quest.567DE26F709106CF.quest_desc: [
		"Der &eItem Dislocator&r zieht Items in deiner Nähe an. Mit Shift-Rechtsklick an- und ausschalten."
	]
	quest.567DE26F709106CF.title: "Item-Magnet"
	quest.56918F752A8712B5.quest_desc: [
		"Hast du zu viel Unobtainium? Gib 16 Barren ab."
	]
	quest.56918F752A8712B5.title: "Abgabe: Unobtainium"
	quest.569796E6D130174A.quest_desc: [
		"Der Minoschwammerl hinterlässt Meef Stroganoff. Sehr sättigend!"
	]
	quest.569796E6D130174A.title: "Meef Stroganoff"
	quest.56A7B86CE84A9FA1.quest_desc: [
		"Tragbarer Bohrer und Messing-Drohne. Probier sie aus!"
	]
	quest.56A7B86CE84A9FA1.title: "Spielzeug"
	quest.56B845C645C8F236.quest_desc: [
		"AppleSkin zeigt in der Hungerleiste, wie satt du wirklich bist (Sättigung). Im Tooltip von Essen siehst du, wie viel es bringt."
		""
		"&eTipp:&r Gerichte mit hoher Sättigung halten viel länger vor als rohes Zeug."
	]
	quest.56B845C645C8F236.title: "AppleSkin: Sättigung"
	quest.56C5DA0F8D7E5132.quest_desc: [
		"Zeigt deinen ganzen Bestand und nimmt Bestellungen an. Lass dir alles an einen Verpacker liefern.\n\nTipp: Mit einem Sitz und einem Blaze davor wird er zum Verkäufer."
	]
	quest.56C5DA0F8D7E5132.title: "Lagerticker"
	quest.56C9AB415B67066B.quest_desc: [
		"Aus der Knochenrüstung und Netherziegeln wird die Wither-Rüstung."
	]
	quest.56C9AB415B67066B.title: "Wither-Rüstung"
	quest.56D9BA6A550DD1BB.quest_desc: [
		"In der Yetihöhle im Schneewald. Er wirft Eisbrocken, also immer in Bewegung bleiben."
	]
	quest.56D9BA6A550DD1BB.title: "Der Alpha-Yeti"
	quest.56E7D090F3DF3F56.quest_desc: [
		"Der Kochtisch ist das Herz der Küche. Er zeigt alle Gerichte, die du mit den Zutaten aus deiner ganzen Küche kochen kannst."
		""
		"Zur Küche gehört alles, was direkt oder über Küchentheken und -schränke an den Tisch grenzt."
	]
	quest.56E7D090F3DF3F56.title: "Kochtisch"
	quest.570967F49F4AF69A.quest_desc: [
		"Pyromant, Kryomant und Elektromant: Jede Robe stärkt ihre Schule."
	]
	quest.570967F49F4AF69A.title: "Elementar-Roben"
	quest.57208C0C2C420D6C.quest_desc: [
		"Honigkristalle findest du überall in der Bumblezone. Aus den Splittern baust du z. B. einen Honigkristall-Schild."
	]
	quest.57208C0C2C420D6C.title: "Honigkristalle"
	quest.573727DF36677410.quest_desc: [
		"Druckrohre leiten Luft von Maschine zu Maschine. Jede Maschine hat einen &cHöchstdruck&r: Wird der überschritten, explodiert sie."
	]
	quest.573727DF36677410.title: "Druckrohre"
	quest.573A6DA966E04EE1.quest_desc: [
		"Der Dieselgenerator verbrennt Biodiesel und liefert richtig viel Strom."
	]
	quest.573A6DA966E04EE1.title: "Dieselgenerator"
	quest.57505C9E3760C4EA.quest_desc: [
		"Der erste Aether-Dungeon. Am Ende wartet ein Boss (siehe Bosse-Kapitel), danach kommen Silber- und Gold-Dungeon."
	]
	quest.57505C9E3760C4EA.title: "Bronze-Dungeon"
	quest.575248B71CE7A84D.quest_desc: [
		"ME-Glaskabel verbinden alles im Netzwerk. Die Quarzfaser leitet nur Strom, aber keine Daten."
	]
	quest.575248B71CE7A84D.title: "Erste Kabel"
	quest.5785882EF16DB58D.quest_desc: [
		"&eIron Jetpacks&r gibt es in vielen Stufen aus verschiedenen Materialien. Alle brauchen einen &eLederriemen&r und Spulen."
	]
	quest.5785882EF16DB58D.title: "Lederriemen"
	quest.57892775D733D070.quest_desc: [
		"Der Deployer benutzt das Item in seiner Hand wie ein Spieler: Blöcke setzen, klicken, Items auf andere anwenden.\n\nEr ist ein Kernteil der Sequenziellen Montage."
	]
	quest.57892775D733D070.title: "Einsatzgerät"
	quest.579C1EC495E68A8A.quest_desc: [
		"Auch Materialien aus anderen Mods lassen sich anbauen, z. B. Certus-Quarz für AE2, Osmium und Stahl für Mekanism. Welche es gibt, zeigt EMI."
	]
	quest.579C1EC495E68A8A.title: "Mod-Samen"
	quest.57B9E61DA276EDB0.quest_desc: [
		"Alle Ender-Zellen auf demselben Kanal teilen sich ihren Speicher, egal wie weit weg."
	]
	quest.57B9E61DA276EDB0.title: "Ender-Zelle"
	quest.57BACA7A994C26C4.quest_desc: [
		"Füttert dich automatisch mit Essen aus dem Rucksack, wenn du Hunger hast."
	]
	quest.57BACA7A994C26C4.title: "Futter-Upgrade"
	quest.57BBFF64A5C23FDA.quest_desc: [
		"Aus der Robe, Gold und einem &eTotem der Unsterblichkeit&r. Sie fängt ab und zu einen Treffer ganz ab."
	]
	quest.57BBFF64A5C23FDA.title: "Göttliche Rüstung"
	quest.57D07B30385FD81C.quest_desc: [
		"Die Fluixperle steckt in allem, was drahtlos oder über Raum funktioniert."
	]
	quest.57D07B30385FD81C.title: "Fluixperle"
	quest.57DE92569CC9C130.quest_desc: [
		"Fast jede Maschine braucht Zahnräder aus Eisen, Gold oder Diamant. Ein paar davon solltest du immer dabeihaben."
	]
	quest.57DE92569CC9C130.title: "Zahnräder"
	quest.57E487E44E5AB494.quest_desc: [
		"Ein Eimer aus Holz. Er kann sogar Lava tragen, allerdings nicht ewig."
	]
	quest.57E487E44E5AB494.title: "Edelholz-Eimer"
	quest.57E6800EC78C8B06.quest_desc: [
		"Neben einen knospenden Block gestellt und mit Strom versorgt, lässt er die Kristalle viel schneller wachsen."
	]
	quest.57E6800EC78C8B06.title: "Wachstumsbeschleuniger"
	quest.58028C82EE9FC2C8.quest_desc: [
		"Seven Seas bringt Schiffe aufs Meer. Die kleine Yacht ist das harmloseste davon."
	]
	quest.58028C82EE9FC2C8.title: "Kleine Yacht"
	quest.58170E5B009A81BF.quest_desc: [
		"Der Importeur zieht Items aus Maschinen ins Netzwerk, der Exporteur schiebt sie hinein. So automatisierst du Öfen und Maschinen."
	]
	quest.58170E5B009A81BF.title: "Importeur und Exporteur"
	quest.5824B1C996578B1A.quest_desc: [
		"Zünde in der Oberwelt ein Feuer auf Grundgestein oder Tiefenschiefer an. Wenn es ausgeht, liegen manchmal Körner der Ewigkeit herum."
	]
	quest.5824B1C996578B1A.title: "Körner der Ewigkeit"
	quest.5834D7EFBA5EBAD1.quest_desc: [
		"Mit Wasserstoff befüllt fliegt es dich durch die Gegend. Zum Befüllen den Elektrolyseur nutzen."
	]
	quest.5834D7EFBA5EBAD1.title: "Jetpack"
	quest.5837BAD6082D319B.quest_desc: [
		"Leichte Rüstung für flinke Kämpfer. Das Assassinen-Set ist die nächste Stufe."
	]
	quest.5837BAD6082D319B.title: "Schurken-Rüstung"
	quest.58570FE37A79A715.quest_desc: [
		"Der Wroughtnaut kann seine riesige Axt oder seinen Helm fallen lassen. Die Axt trifft mit einem breiten Schwung."
	]
	quest.58570FE37A79A715.title: "Axt der tausend Metalle"
	quest.585BFE2584CC8996.quest_desc: [
		"Oritech beginnt mit &eNickel&r. Das Erz findest du in der Oberwelt, einfach schmelzen."
		""
		"Das Handbuch und EMI zeigen dir alle Rezepte."
	]
	quest.585BFE2584CC8996.title: "Nickel"
	quest.5866B739609C824A.quest_desc: [
		"Mit der Vibranium-Vorlage wertest du deine Allthemodium-Rüstung auf."
	]
	quest.5866B739609C824A.title: "Vibranium-Rüstung"
	quest.58696D7FE12AD869.quest_desc: [
		"Patronen baust du an der Ingenieurswerkbank mit der passenden Blaupause."
	]
	quest.58696D7FE12AD869.title: "Patronen"
	quest.5869D4503286A747.quest_desc: [
		"Eine &eDrohne&r fliegt mit Luft und macht, was du ihr programmierst: abbauen, ernten, Items verteilen, kämpfen."
	]
	quest.5869D4503286A747.title: "Drohnen"
	quest.586EC9D09CA9BB57.quest_desc: [
		"Schriftrollen findest du in Truhen und bei Händlern. Lesen = einmal zaubern, am Tisch eintragen = für immer im Buch."
	]
	quest.586EC9D09CA9BB57.title: "Schriftrollen"
	quest.58777B3FFAF1E7BE.quest_desc: [
		"Andesitlegierung auf entrindetes Holz anwenden. Das Gehäuse ist die Grundlage vieler Maschinen."
	]
	quest.58777B3FFAF1E7BE.title: "Andesitgehäuse"
	quest.587B6F95BD602E09.quest_desc: [
		"Gib 16 Mithril-Schrott ab."
	]
	quest.587B6F95BD602E09.title: "Abgabe: Mithril"
	quest.588CBF641B6F9FB7.quest_desc: [
		"Repositories plus Lagerpult ergeben ein einfaches Lagersystem: Das Pult zeigt den Inhalt aller verbundenen Lager."
	]
	quest.588CBF641B6F9FB7.title: "Magisches Lager"
	quest.5896A1411B083BC8.quest_desc: [
		"Energie-, Item- und Flüssigkeitsrohre verbinden deine Maschinen. Mit der Rohrzange stellst du Ein- und Ausgänge ein."
	]
	quest.5896A1411B083BC8.title: "Rohre"
	quest.58B2439153283A9D.quest_desc: [
		"Eisen ist das wichtigste Metall am Anfang. Rohes Eisen im Ofen schmelzen."
	]
	quest.58B2439153283A9D.title: "Eisenzeit"
	quest.58C985FEC0782440.quest_desc: [
		"Das Speed-Upgrade lässt Bienen schneller arbeiten. Das BaBee-Upgrade sorgt für Nachwuchs im Stock."
	]
	quest.58C985FEC0782440.title: "Upgrades"
	quest.58CCAA04310E4B38.quest_desc: [
		"Stell Wasser vor einen Lüfter und lass zerkleinertes Erz durch den Luftstrom fallen. Heraus kommen Klumpen und manchmal Nebenprodukte.\n\nHak die Quest ab, wenn deine Waschanlage läuft."
	]
	quest.58CCAA04310E4B38.title: "Waschen"
	quest.58E01905C47F2844.quest_desc: [
		"Das Pack hat jede Menge Dimensionen: Nether und End, aber auch Aether, Undergarden, Weltraum und mehr.\n\nFang mit dem Klassiker an: 10 Obsidian für ein Netherportal. Mit Diamant-Spitzhacke abbauen oder per Wasser auf Lava erzeugen."
	]
	quest.58E01905C47F2844.title: "Raus aus der Overworld"
	quest.59128093FAC338BF.quest_desc: [
		"Gib 32 Stahlbarren ab."
	]
	quest.59128093FAC338BF.title: "Abgabe: Stahl"
	quest.593C01348F1C1D75.quest_desc: [
		"Ganz oben im Dunklen Turm. Der Kampf hat eine eigene Mechanik, ein Blick ins Wiki lohnt sich."
	]
	quest.593C01348F1C1D75.title: "Der Ur-Ghast"
	quest.596773173107569C.quest_desc: [
		"Über die Konsole siehst du alles im Netzwerk, kannst suchen, einlagern und rausnehmen."
	]
	quest.596773173107569C.title: "Konsole"
	quest.599733B31D2BA79D.quest_desc: [
		"Der verstärkte Reaktor kann mit Wasser gekühlt werden und macht dann Dampf statt Strom."
	]
	quest.599733B31D2BA79D.title: "Verstärkter Reaktor"
	quest.599E1CFB476A39FF.quest_desc: [
		"Aus Magebloom werden Fasern. Leg dir ein kleines Feld an, du brauchst viele davon."
	]
	quest.599E1CFB476A39FF.title: "Magieblütenfaser"
	quest.59C263E2311EDF79.quest_desc: [
		"Pollenbälle findest du in Pollenhaufen. Mit Honig wird daraus &eBienenbrot&r, das Bienen heilt und dich stärkt."
	]
	quest.59C263E2311EDF79.title: "Pollen und Bienenbrot"
	quest.59CFEB5C33633069.quest_desc: [
		"Eine echte Bahnhofsuhr. Dazu gibt es verbesserte Anzeigetafeln für Abfahrtszeiten."
	]
	quest.59CFEB5C33633069.title: "Bahnhofsuhr"
	quest.59D5FD0D5B2130C1.quest_desc: [
		"Gib 32 Körner der Ewigkeit ab."
	]
	quest.59D5FD0D5B2130C1.title: "Abgabe: Körner"
	quest.59E2B975A420A43A.quest_desc: [
		"Thoriumerz findest du unter Tage. Daraus wird der Brennstoff für den Reaktor."
	]
	quest.59E2B975A420A43A.title: "Thorium"
	quest.59F65DE2E476C01D.quest_desc: [
		"Holt einen eingesetzten Edelstein wieder heraus, ohne ihn zu zerstören."
	]
	quest.59F65DE2E476C01D.title: "Edelsteine entnehmen"
	quest.5A044730D3704EC3.quest_desc: [
		"Baue ihn aus vier Seelensand und drei Witherskelettschädeln. Am besten tief unter der Erde, denn er sprengt alles weg.\n\nEr lässt einen &eNetherstern&r fallen."
	]
	quest.5A044730D3704EC3.title: "Der Wither"
	quest.5A0488ECA027EE8C.quest_desc: [
		"Die Energiezelle speichert Strom, Kabel verteilen ihn."
	]
	quest.5A0488ECA027EE8C.title: "Energiezelle und Kabel"
	quest.5A0F6819AD8F90AC.quest_desc: [
		"Mit dem Mobfanggerät sammelst du Mobs ein. Der Monsterschnetzler erledigt Mobs vor sich und sammelt Beute und Erfahrung ein."
	]
	quest.5A0F6819AD8F90AC.title: "Mob-Fabrik"
	quest.5A10E60A04811FDD.quest_desc: [
		"Der Network Analyzer zeigt dir dein Netzwerk als Bild an: Kabel, Kanäle und Geräte. Super, um Kanalprobleme zu finden."
	]
	quest.5A10E60A04811FDD.title: "Netzwerk-Analyse"
	quest.5A32AF8CCFA3B535.quest_desc: [
		"Die Imbuement-Kammer lädt Items mit Quelle auf. Leg Lapis oder Amethyst hinein und du bekommst &eQuelljuwelen&r."
	]
	quest.5A32AF8CCFA3B535.title: "Verzauberungskammer"
	quest.5A4C4872325EA74B.quest_desc: [
		"Du kennst jetzt die wichtigsten Werkzeuge. Weiter geht es im Kapitel &eErste Schritte&r."
		""
		"Viel Spaß!"
	]
	quest.5A4C4872325EA74B.title: "Bereit fürs Abenteuer"
	quest.5A4CB58337120BFF.quest_desc: [
		"Energetische Legierung mit Enderperle. Die beste Legierung für Leitungen und Maschinen."
	]
	quest.5A4CB58337120BFF.title: "Strahlende Legierung"
	quest.5A4F4F3EB7830CEF.quest_desc: [
		"Mit Redstone steuern: Die Kupplung trennt die Verbindung, die Gangschaltung kehrt die Drehrichtung um."
	]
	quest.5A4F4F3EB7830CEF.title: "Kupplung und Gangschaltung"
	quest.5A511C1485C3CBAF.quest_desc: [
		"Eine Truhe, die Werkzeuge darin mit Blut repariert."
	]
	quest.5A511C1485C3CBAF.title: "Blutkiste"
	quest.5A5741A4439AE871.quest_desc: [
		"Aus Chaos-Fragmenten, Draconic-Kernen und Erwachtem Draconium entsteht der &eChaotische Kern&r."
	]
	quest.5A5741A4439AE871.title: "Chaotischer Kern"
	quest.5A5E5AFC1B6F3237.quest_desc: [
		"Bessere Angeln halten länger und fangen besser."
	]
	quest.5A5E5AFC1B6F3237.title: "Goldene Angel"
	quest.5A7A1D2B14036142.quest_desc: [
		"8 Legierungsziegel als 2x2x2-Würfel, dann mit dem Hammer draufhauen. Der Ofen läuft mit Brennstoff und schmilzt zwei Metalle zu einer Legierung."
	]
	quest.5A7A1D2B14036142.title: "Legierungsofen"
	quest.5A9B42080B092B83.quest_desc: [
		"Die vier Element-Samen brauchen Agglomerate als Zutat. Ihre Essenzen stecken in vielen anderen Samen-Rezepten und im Erweckungsaltar."
	]
	quest.5A9B42080B092B83.title: "Elemente"
	quest.5A9EE3254969658A.quest_desc: [
		"Die &eThermopneumatische Verarbeitungsanlage&r macht aus LPG und Kohle Plastik. Rezept und Bedingungen in EMI."
	]
	quest.5A9EE3254969658A.title: "Plastik"
	quest.5AA7DF14990F98E8.quest_desc: [
		"Die Reaktionskammer aus AdvancedAE verarbeitet Items zusammen mit Flüssigkeiten und Strom. Sie macht unter anderem Quantenlegierung."
	]
	quest.5AA7DF14990F98E8.title: "Reaktionskammer"
	quest.5AADE548DC2A3AD6.quest_desc: [
		"Ein Block, der von selbst schwebt. Ideal für Luftschiffe ohne Ballon."
	]
	quest.5AADE548DC2A3AD6.title: "Levitit"
	quest.5AB8E54C08E79DDE.quest_desc: [
		"Der &eDraconic-Kern&r aus Erwachtem Draconium, Wyvern-Kernen und einem Nether-Stern."
	]
	quest.5AB8E54C08E79DDE.title: "Draconic-Kern"
	quest.5AC3E32BE02F4FFD.quest_desc: [
		"Im &eLogik-Programmierer&r beschreibst du &eVariablenkarten&r mit Werten und Operationen. Das ist das Herz der Mod."
	]
	quest.5AC3E32BE02F4FFD.title: "Variablenkarten"
	quest.5ACD7695AD914332.quest_desc: [
		"Tinte bestimmt die Seltenheit neuer Schriftrollen. Sie entsteht im Alchemistenkessel."
	]
	quest.5ACD7695AD914332.title: "Gewöhnliche Tinte"
	quest.5ACF3CAEE22F373F.quest_desc: [
		"Du hast alle drei Mods gemeistert: Kristalle aufgeladen, ein Logik-Netzwerk gebaut und bist mit dem Jetpack unterwegs. Stark!"
	]
	quest.5ACF3CAEE22F373F.title: "Kleiner Techniker"
	quest.5AE482777D3CE561.quest_desc: [
		"Bosses'Rise bringt eigene Arenen mit Bossen. Skor ist der Yeti und haust in der Kälte."
	]
	quest.5AE482777D3CE561.title: "Skor, der Yeti"
	quest.5AF5813950C905F2.quest_desc: [
		"Löscht alles, was nicht mehr in die volle Schublade passt. Ideal für Farmen, die zu viel liefern."
	]
	quest.5AF5813950C905F2.title: "Leerenerweiterung"
	quest.5B0132E6BB384A49.quest_desc: [
		"Der Blutinfusor tränkt Items mit Blut und verwandelt sie dabei. Er ist die wichtigste Maschine der Mod."
		""
		"Welche Items du darin herstellen kannst, zeigt dir EMI."
	]
	quest.5B0132E6BB384A49.title: "Blutinfusor"
	quest.5B118AEDF8570D24.quest_desc: [
		"Primitives Gehäuse, Kunststoff, Netherziegel, Eisen und ein Goldzahnrad, dazu Latex im Auflösungsapparat."
	]
	quest.5B118AEDF8570D24.title: "Einfaches Gehäuse"
	quest.5B15D8E8909416D0.quest_desc: [
		"Würmer sind ein guter Köder. Du findest sie beim Graben in Erde und Gras oder züchtest sie in der Wurmfarm."
	]
	quest.5B15D8E8909416D0.title: "Würmer"
	quest.5B3576182CB1493E.quest_desc: [
		"Jeder fängt mal klein an: Hau einen Baum um, mach Bretter daraus und daraus Stöcke."
	]
	quest.5B3576182CB1493E.title: "Holz hacken"
	quest.5B4493ACF298D461.quest_desc: [
		"Schwert und Bogen wirken beim Treffer einen eingespeicherten Zauber."
	]
	quest.5B4493ACF298D461.title: "Zauberer-Waffen"
	quest.5B4A3E17410B6885.quest_desc: [
		"Ein starker Langbogen aus Gold und Diamant. Mit Netherit wird er noch besser."
	]
	quest.5B4A3E17410B6885.title: "Königlicher Langbogen"
	quest.5B4C4D10866B3555.quest_desc: [
		"Der &eGenerator&r verbrennt Brennstoff und macht Strom (FE). Für Fusion Crafting brauchst du einiges davon."
	]
	quest.5B4C4D10866B3555.title: "Generator"
	quest.5B4F5F0A3246261E.quest_desc: [
		"Bestellt bei einem Redstone-Signal eine feste Menge Items an eine Adresse."
	]
	quest.5B4F5F0A3246261E.title: "Redstone-Anfrager"
	quest.5B5F6093BC635BCF.quest_desc: [
		"Wandelt Rotation in Strom (FE) um. So betreibst du Strom-Maschinen anderer Mods mit Create-Kraft."
	]
	quest.5B5F6093BC635BCF.title: "Lichtmaschine"
	quest.5B817B815DE814DB.quest_desc: [
		"In der Rezeptkonsole schreibst du Rezepte auf leere Muster. Steck sie in einen Autohersteller, dann stellt das Netzwerk die Items auf Bestellung her."
		""
		"Bestellen geht in der Konsole: Item suchen und anklicken."
	]
	quest.5B817B815DE814DB.title: "Autocrafting"
	quest.5B87BC0CBB0278E5.quest_desc: [
		"Der Kessel erhitzt Wasser mit Strom oder heißem Natrium zu Dampf für die Turbine."
	]
	quest.5B87BC0CBB0278E5.title: "Thermoelektrischer Kessel"
	quest.5B9335E05F924891.quest_desc: [
		"Der Lichtbogenofen schmilzt Erz und Legierungen mit Strom und braucht dafür Graphitelektroden. Bau ihn und leg eine Elektrode ein."
	]
	quest.5B9335E05F924891.title: "Lichtbogenofen"
	quest.5B9A9B737B3D52B9.quest_desc: [
		"Aus Dunkelmetall-Stücken machst du Barren für Rüstung und Waffen von Born in Chaos. Schau in EMI, wo du sie findest."
	]
	quest.5B9A9B737B3D52B9.title: "Dunkles Metall"
	quest.5B9BBFC60BBD529C.quest_desc: [
		"Die Bibliothek speichert Verzauberungen aus Büchern. Du kannst sie später einzeln wieder auf Bücher ziehen."
	]
	quest.5B9BBFC60BBD529C.title: "Verzauberungsbibliothek"
	quest.5BA7DEF463BA2E2F.quest_desc: [
		"Der &eKohlegenerator&r macht Strom aus allem, was im Ofen brennt."
	]
	quest.5BA7DEF463BA2E2F.title: "Kohlegenerator"
	quest.5BC3E48821BB81B0.quest_desc: [
		"Ein ganzer Block aus dem seltensten Metall des Packs."
	]
	quest.5BC3E48821BB81B0.title: "Unobtainium"
	quest.5BE070EE6618E255.quest_desc: [
		"Das &eFlux Gate&r aus Platin, Fluxit und einer Verarbeitungseinheit steckt in allen späten Maschinen."
	]
	quest.5BE070EE6618E255.title: "Flux Gate"
	quest.5BF5BF6C1820304C.quest_desc: [
		"Besieg eine Spinne mit einem Messer in der Hand, dann lässt sie Spinnenfleisch fallen."
	]
	quest.5BF5BF6C1820304C.title: "Spinnenfleisch"
	quest.5BFB514C31A51DF8.quest_desc: [
		"Der Frosch schnappt Pakete und schickt sie über Kettenförderer zum Ziel. Sehr süß, sehr nützlich."
	]
	quest.5BFB514C31A51DF8.title: "Frosch-Anschluss"
	quest.5C01D1E40794CE76.quest_desc: [
		"Besondere Waben verarbeitest du in der &eZentrifuge&r zu Ressourcen und Wachs. Die einfache Zentrifuge läuft per Hand."
	]
	quest.5C01D1E40794CE76.title: "Zentrifuge"
	quest.5C0E288574DA7994.quest_desc: [
		"Das stärkste Werkzeug aus Mekanism Tools."
	]
	quest.5C0E288574DA7994.title: "Obsidianwerkzeug"
	quest.5C3CAECCEF236153.quest_desc: [
		"Mehr Platz und ein Upgrade-Slot mehr."
	]
	quest.5C3CAECCEF236153.title: "Kupferrucksack"
	quest.5C410D2DC94C9FAE.quest_desc: [
		"Blitz, Explosion und Wolfsrudel gehören zu den starken Glyphen. Manche davon kann erst das Erzmagier-Buch wirken."
	]
	quest.5C410D2DC94C9FAE.title: "Mächtige Glyphen"
	quest.5C4315C3F11112E1.quest_desc: [
		"Inventory Profiles Next fügt Sortier-Knöpfe an Inventar und Kisten hinzu."
		""
		"Mouse Tweaks: Mit gedrückter Maustaste über Slots ziehen verteilt Items, Shift + Ziehen verschiebt viele Stacks auf einmal, das Mausrad schiebt einzelne Items."
	]
	quest.5C4315C3F11112E1.title: "Inventar sortieren"
	quest.5C4AB9C5E8DCE064.quest_desc: [
		"Züchte eine Biene, die &eEisen&r oder &eKupfer&r liefert. Ab jetzt sammeln deine Bienen echte Erze."
	]
	quest.5C4AB9C5E8DCE064.title: "Erz-Bienen"
	quest.5C6C580F128E6151.quest_desc: [
		"Das Herz des Netzwerks. Er stellt 32 Kanäle pro Seite bereit. Controller-Blöcke kann man zu größeren Strukturen zusammenbauen."
	]
	quest.5C6C580F128E6151.title: "ME-Controller"
	quest.5C73296C4E848F3E.quest_desc: [
		"Stahlrohre halten deutlich mehr Pulver aus. Für die Profis gibt es noch Netherstahl."
	]
	quest.5C73296C4E848F3E.title: "Stahlkanone"
	quest.5C751EA80F463D0A.quest_desc: [
		"Für den Reaktor brauchst du Uran. Das Erz wird zu Yellowcake verarbeitet, daraus entsteht über mehrere Chemie-Schritte Spaltbrennstoff."
	]
	quest.5C751EA80F463D0A.title: "Uran"
	quest.5C79B486F0C5E9D2.quest_desc: [
		"Kupfer findest du häufig in Höhlen. Mit der Steinspitzhacke abbauen und im Ofen schmelzen."
		""
		"Viele Mods brauchen Kupfer, vor allem Create."
	]
	quest.5C79B486F0C5E9D2.title: "Kupfer"
	quest.5C95B5594548E536.quest_desc: [
		"Die besten Seeregale. Für das Herzregal brauchst du ein Herz des Meeres."
	]
	quest.5C95B5594548E536.title: "Kristall und Herz"
	quest.5C9A8942972E2BD6.quest_desc: [
		"Rechtsklick mit der Gießkanne lässt die Pflanzen rundherum schneller wachsen. Bessere Kannen decken mehr Fläche ab."
	]
	quest.5C9A8942972E2BD6.title: "Gießkanne"
	quest.5CBB164EF2C1F856.quest_desc: [
		"Am Bahnhof baust du den Zug zusammen: Drehgestelle aufs Gleis, Zug daran bauen, am Bahnhof &eZusammenbauen&r.\n\nMit Sekundenkleber hältst du die Wagenteile zusammen."
	]
	quest.5CBB164EF2C1F856.title: "Bahnhof"
	quest.5CC2FFCA701041C5.quest_desc: [
		"Drygmys sammeln Drops von Mobs in der Nähe, ohne sie zu töten. Ideal neben einer Tierweide."
	]
	quest.5CC2FFCA701041C5.title: "Drygmy"
	quest.5CC329632FE6A52E.quest_desc: [
		"Die &eAnzeigetafel&r zeigt den Wert einer Variablenkarte an, z. B. wie viele Items in deinem Lager sind."
	]
	quest.5CC329632FE6A52E.title: "Anzeigetafel"
	quest.5CCD13E9A744BE99.quest_desc: [
		"Ein Buch plus Eisenwerkzeuge ergibt dein &eAnfänger-Zauberbuch&r. Damit baust du Zauber aus &eGlyphen&r zusammen: eine Form, dann Effekte und Augmente.\n\nDrück &eC&r, um das Zauber-Menü zu öffnen."
	]
	quest.5CCD13E9A744BE99.title: "Das erste Zauberbuch"
	quest.5CE435D1495C885B.quest_desc: [
		"Der Chaotische Kern braucht Fragmente des Chaos-Wächters. Das Endziel von Draconic Evolution."
	]
	quest.5CE435D1495C885B.title: "Chaotischer Kern"
	quest.5D03BC8D63F2C0A6.quest_desc: [
		"Occultism dreht sich um Geister aus der Anderswelt. Alles beginnt mit den Samen des &eDämonentraums&r (Demon's Dream), die du beim Abbauen von Gras findest.\n\nPflanz sie auf Ackerland an."
	]
	quest.5D03BC8D63F2C0A6.title: "Dämonentraum"
	quest.5D23892372AF6C97.quest_desc: [
		"Für den &eWyvern-Kern&r brauchst du einen &eNether-Stern&r. Zeit, den Wither zu besuchen."
	]
	quest.5D23892372AF6C97.title: "Wyvern-Kern"
	quest.5D2FD991B0991441.quest_desc: [
		"Auch die Plünderer-Außenposten haben neue Stile, jeder Außenposten zählt. &cDas Banner bringt Unheil&r, wenn du den Hauptmann besiegst."
	]
	quest.5D2FD991B0991441.title: "Außenposten"
	quest.5D31489D4764E843.quest_desc: [
		"Zerkleinertes Erz schmilzt zu einem Barren. Gewaschen gibt es zusätzlich Klumpen dazu."
	]
	quest.5D31489D4764E843.title: "Zerkleinertes Erz"
	quest.5D3208F6F78195A6.quest_desc: [
		"Im Geisterofen werden gefangene Geister verarbeitet und lassen dabei die Beute ihres Mobs fallen."
	]
	quest.5D3208F6F78195A6.title: "Geisterofen"
	quest.5D32961FEE5248B0.quest_desc: [
		"Kondensatoren speichern Strom. LV braucht Bleibleche, MV Elektrum und Nickel."
	]
	quest.5D32961FEE5248B0.title: "Kondensatoren"
	quest.5D3CF0AEC395A3E0.quest_desc: [
		"Leichte und schwere Ingenieursbausteine sind die Bauteile der großen Multiblöcke. Welche du wo brauchst, steht im Handbuch."
	]
	quest.5D3CF0AEC395A3E0.title: "Ingenieursbausteine"
	quest.5D4B50F8767E03C6.quest_desc: [
		"Ein Eichensetzling im Geisterfeuer wird zu einem instabilen Anderswelt-Setzling. Pflanz ihn ein und fäll den Baum mit aktivem Dritten Auge, sonst bekommst du nur Eichenholz."
	]
	quest.5D4B50F8767E03C6.title: "Andersweltbäume"
	quest.5D4DDE3A08C629E0.quest_desc: [
		"Create: Central Kitchen verbindet Create mit Farmer's Delight. Viele Kochtopf-Rezepte lassen sich mit Mixer und beheiztem Becken automatisieren."
		""
		"Welche genau, zeigt dir EMI."
	]
	quest.5D4DDE3A08C629E0.title: "Küche automatisieren"
	quest.5D522C686AE0C08D.quest_desc: [
		"Die Naga lässt Schuppen fallen. Daraus wird eine Rüstung, die dich gegen Rückstoß schützt."
	]
	quest.5D522C686AE0C08D.title: "Nagaschuppen"
	quest.5D5C2579E73DA288.quest_desc: [
		"Inferium-Erz findest du überall unter Tage. Es gibt &eInferium-Essenz&r, die Grundlage der ganzen Mod.\n\nMit Mystical Agriculture baust du Erze, Edelsteine und Mob-Drops als Pflanzen an."
	]
	quest.5D5C2579E73DA288.title: "Inferium"
	quest.5D69A70FC646AB37.quest_desc: [
		"Auf den Stock gesetzt verdoppelt die Box Platz für Bienen und Upgrades."
	]
	quest.5D69A70FC646AB37.title: "Erweiterungsbox"
	quest.5D73D581C13B7C38.quest_desc: [
		"Benutze das Herz am Portalrahmen in der Antiken Stadt. Die Otherside ist eine Sculk-Welt voller Gefahren."
	]
	quest.5D73D581C13B7C38.title: "Die Otherside"
	quest.5D7647A0C28F2210.quest_desc: [
		"Mit Applied Mekanistics speichert dein ME-Netz Gase und Chemikalien aus Mekanism. Busse und Schnittstellen können sie dann auch transportieren."
	]
	quest.5D7647A0C28F2210.title: "Chemie im Netz"
	quest.5D88D4DD701D408E.quest_desc: [
		"Füttere es an einen zahmen Wolf. Das stärkt und heilt ihn."
	]
	quest.5D88D4DD701D408E.title: "Hundefutter"
	quest.5D8ED4F78FF59D57.quest_desc: [
		"Tief im Schnee lauert die Eisspinne. Sie liefert Zutaten für das Frostbuch."
	]
	quest.5D8ED4F78FF59D57.title: "Eisspinnen-Höhle"
	quest.5D9281AFF0A2E9FC.quest_desc: [
		"In der Mitte jedes Meteoriten steckt ein &eMysteriöser Würfel&r. Baust du ihn ab, bekommst du die vier Gravurdrucke.\n\nOhne diese Pressen gibt es keine Prozessoren. Also gut aufpassen!"
	]
	quest.5D9281AFF0A2E9FC.title: "Die vier Pressen"
	quest.5DB9DB297C2BE157.quest_desc: [
		"Füllt Behälter neben sich ständig mit Wasser."
	]
	quest.5DB9DB297C2BE157.title: "Endlose Urne"
	quest.5DD7516037F398AE.quest_desc: [
		"Darkstone liegt ganz tief, nahe am Grundgestein. Poliert wird er zum Baumaterial für Schmiede und Clibano."
	]
	quest.5DD7516037F398AE.title: "Darkstone"
	quest.5DD7BDCA311F263F.quest_desc: [
		"Wenn zwei Mods dasselbe Rezept nutzen, erscheint an der Werkbank ein kleiner Knopf. Damit wählst du aus, welches Ergebnis du willst."
	]
	quest.5DD7BDCA311F263F.title: "Polymorph: Rezeptkonflikte"
	quest.5DEAAE9A93AC882D.quest_desc: [
		"Ein Provider mit mehr Plätzen und eine Energiezelle, die viel mehr fasst als die dichte."
	]
	quest.5DEAAE9A93AC882D.title: "MEGA-Geräte"
	quest.5DED8F13FA57FD0A.quest_desc: [
		"Garnished bringt Nüsse und viele neue Rezepte für Mixer, Lüfter und Ausguss. Das Beil hilft beim Sammeln, Details in EMI."
	]
	quest.5DED8F13FA57FD0A.title: "Garnished"
	quest.5DFB83C82E8BD14F.quest_desc: [
		"Tief in der versunkenen Stadt lauert der Leviathan. Das &eAbgrundauge&r führt dich hin.\n\nOhne Wasseratmung oder Conduit wird es hier schnell eng."
	]
	quest.5DFB83C82E8BD14F.title: "Der Leviathan"
	quest.5E018CFE381561BA.quest_desc: [
		"Archwood-Bäume wachsen in &eArchwood-Wäldern&r. Fast alle Ars-Maschinen brauchen das Holz."
	]
	quest.5E018CFE381561BA.title: "Archwood"
	quest.5E02D8912764863C.quest_desc: [
		"Ein Multiblock-Akku mit riesigem Speicher. Zellen speichern, Anbieter bestimmen, wie viel Strom fließen kann."
	]
	quest.5E02D8912764863C.title: "Induktionsmatrix"
	quest.5E225227B1FE73E5.quest_desc: [
		"Rote Kreide braucht Afrit-Essenz. Für die schwarze Kreide lässt du einen Afrit Witherite-Staub herstellen."
	]
	quest.5E225227B1FE73E5.title: "Kreide für Marids"
	quest.5E23F16BB6C6407A.quest_desc: [
		"Das ME-Laufwerk hält bis zu 10 Speicherzellen. Eine 1k-Zelle fasst 1024 Bytes, verteilt auf bis zu 63 verschiedene Items."
	]
	quest.5E23F16BB6C6407A.title: "Laufwerk und Zelle"
	quest.5E505728D4AEF23B.quest_desc: [
		"Pad im End benutzen: The Beyond. Unobtainium, das stärkste Metall, findest du in den End-Hochländern (abbauen mit Vibranium-Spitzhacke)."
	]
	quest.5E505728D4AEF23B.title: "The Beyond"
	quest.5E55C15DF5291F26.quest_desc: [
		"Mit AppleSkin siehst du im Tooltip, wie viel Hunger und Sättigung ein Essen bringt. Gekochte Gerichte schlagen rohes Essen um Längen."
		""
		"Viele Gerichte aus Farmer's Delight geben zusätzlich Effekte, die den Hunger länger fernhalten."
	]
	quest.5E55C15DF5291F26.title: "Tipp: Sättigung"
	quest.5E61E19A4F1B9DEE.quest_desc: [
		"Eisen und Gold auf die Energiekugel: Das ergibt energetisierten Stahl, die Basis der Hardened-Stufe."
	]
	quest.5E61E19A4F1B9DEE.title: "Energetisierter Stahl"
	quest.5E7C7971E6510BE7.quest_desc: [
		"Kreuze zwei Bienenarten miteinander. Welche Eltern du für welche Biene brauchst, zeigt EMI unter \"Bee Breeding\". Hak ab, sobald du deine erste neue Art gezüchtet hast."
	]
	quest.5E7C7971E6510BE7.title: "Bienen züchten"
	quest.5E8E80FBFDCC3C8A.quest_desc: [
		"&eMenril-Bäume&r (blaugraue Bäume mit Beeren) wachsen in Wäldern. Ihr Holz ist die Basis von Integrated Dynamics."
	]
	quest.5E8E80FBFDCC3C8A.title: "Menril-Bäume"
	quest.5E9AE75D5E97AC5F.quest_desc: [
		"Zanit-Werkzeuge werden stärker, je mehr sie abgenutzt sind. Aus Zanit und Heiligstein baust du außerdem den Altar."
	]
	quest.5E9AE75D5E97AC5F.title: "Zanit"
	quest.5E9F6973DBFBF681.quest_desc: [
		"Der Zaubernuss-Besen ist schneller und braucht einen Diamanten statt Gold. Der Mahagonibesen ist der schnellste, braucht aber Netherit."
	]
	quest.5E9F6973DBFBF681.title: "Schnellere Besen"
	quest.5E9F99C79E90F18E.quest_desc: [
		"Create Train Utilities bringt echte Schiebetüren. Dafür brauchst du Transistor, Steuereinheit und Gummidichtung."
	]
	quest.5E9F99C79E90F18E.title: "Bauteile für Zugtüren"
	quest.5EA2C0A6A27DB1F9.quest_desc: [
		"Eine Gruft voller Untoter. Fackeln und Heiltränke einpacken."
	]
	quest.5EA2C0A6A27DB1F9.title: "Untote Gruft"
	quest.5EC0505F1B78AF0F.quest_desc: [
		"&eDraconium-Erz&r gibt es tief in der Oberwelt und im Nether, am meisten aber im &eEnd&r. Es lässt &eDraconium-Staub&r fallen, Glück erhöht die Menge."
	]
	quest.5EC0505F1B78AF0F.title: "Draconium"
	quest.5EC8C14267F2315F.quest_desc: [
		"Eine Spitzhacke zum Werfen aus Quark. Baut Blöcke aus der Ferne ab und kommt zurück."
	]
	quest.5EC8C14267F2315F.title: "Pickarang"
	quest.5EECCCA78341CB28.quest_desc: [
		"Die höchste Stufe für die stärksten Maschinen. Braucht Netheritbarren, Diamanten und Äthergas, Details in EMI."
	]
	quest.5EECCCA78341CB28.title: "Überlegenes Gehäuse"
	quest.5EF1FA3E3FC2E0E5.quest_desc: [
		"Die chemische Injektionskammer nutzt Chlorwasserstoff und macht aus einem Erz vier Barren."
	]
	quest.5EF1FA3E3FC2E0E5.title: "Erze vervierfachen"
	quest.5F19A0D00AC23FE8.quest_desc: [
		"Mit dem &eInfusionskristall&r wandelst du Essenzen in die nächste Stufe um: 4 Essenzen um den Kristall ergeben 1 Essenz der höheren Stufe."
	]
	quest.5F19A0D00AC23FE8.title: "Infusionskristall"
	quest.5F29754F3F37D01B.quest_desc: [
		"&cStrahlung!&r Hier gibt es Uran, Säure und radioaktive Kreaturen. Schutzausrüstung lohnt sich."
	]
	quest.5F29754F3F37D01B.title: "Giftige Höhlen"
	quest.5F367F416130822E.quest_desc: [
		"Der Zauberbeutel nimmt Zauberrollen und Caster-Tomes auf."
	]
	quest.5F367F416130822E.title: "Zauberbeutel"
	quest.5F36C2A37BE7EB02.quest_desc: [
		"Zieht Items und Erfahrung aus der Umgebung zu dir."
	]
	quest.5F36C2A37BE7EB02.title: "Magnet"
	quest.5F4387C9CF94C891.quest_desc: [
		"Mit dem Physik-Assembler wird dein Bau zum fliegenden Objekt, mit dem Steuerrad lenkst du es."
	]
	quest.5F4387C9CF94C891.title: "Ans Steuer!"
	quest.5F4B59C0430D5BFB.quest_desc: [
		"Die Grundrobe aus Arkanem Tuch. Mit einer Rune wird daraus die Rüstung einer Schule."
	]
	quest.5F4B59C0430D5BFB.title: "Zaubererrobe"
	quest.5F5DCBFF90D4D0B2.quest_desc: [
		"Die Anreicherungskammer macht aus einem Erz zwei Staub. &aDoppelte Ausbeute&r ab jetzt!"
	]
	quest.5F5DCBFF90D4D0B2.title: "Erze verdoppeln"
	quest.5F603826CCB498E0.quest_desc: [
		"Pro Stufe brauchst du eine &eEnergiezelle&r, &eTriebwerke&r und einen &eKondensator&r aus dem jeweiligen Material. Welche Stufe was braucht, steht in EMI."
	]
	quest.5F603826CCB498E0.title: "Zelle und Triebwerk"
	quest.5F6A2D5E471E60D1.quest_desc: [
		"Quellzellen speichern Quelle im Netz. Das ME-Quellgefäß stellt sie deinen Ars-Geräten wie ein normales Gefäß zur Verfügung."
	]
	quest.5F6A2D5E471E60D1.title: "Quelle speichern"
	quest.5F75304C6523BDC6.quest_desc: [
		"Mit dem &eDraconic-Flug-Modul&r in der Brustplatte fliegst du wie im Kreativmodus."
	]
	quest.5F75304C6523BDC6.title: "Flug-Modul"
	quest.5F7606D5D16714DC.quest_desc: [
		"Baue das Fundament der Schmiede, stell einen Schmiedetisch in die Mitte und klick ihn mit Mundabitur-Staub an.\n\nDen genauen Aufbau zeigt dir Ponder (Taste W über dem Item in EMI)."
	]
	quest.5F7606D5D16714DC.title: "Hephaistos-Schmiede"
	quest.5F76303CA5D13E31.quest_desc: [
		"Wenig Schwerkraft, kein Sauerstoff. Auf dem Mond gibt es &eDesh&r für die nächste Rakete und Käse."
	]
	quest.5F76303CA5D13E31.title: "Der Mond"
	quest.5F7868A74604F5AF.quest_desc: [
		"YUNG's Better Dungeons macht aus den kleinen Monsterräumen echte Dungeons, mit mehr Räumen und mehr Beute."
	]
	quest.5F7868A74604F5AF.title: "Bessere Dungeons"
	quest.5F788D99EB031DDC.quest_desc: [
		"Zerkleinere arkane Kristalle zu Staub. Den brauchst du für Mundabitur-Staub, Deorum und arkanes Knochenmehl."
	]
	quest.5F788D99EB031DDC.title: "Kristallstaub"
	quest.5F7C2F291A5102BF.quest_desc: [
		"Jetzt wird es ernst: Die Dampfmaschine liefert richtig viel Kraft.\n\nSie kommt an einen Kessel, also einen Flüssigkeitstank mit Wasser und Lohenbrennern darunter."
	]
	quest.5F7C2F291A5102BF.title: "Dampfmaschine"
	quest.5F7D1EEAE2905C93.quest_desc: [
		"Elektrum ist Gold plus Silber, Constantan ist Kupfer plus Nickel. Silber- und Nickelerz findest du in der Oberwelt."
	]
	quest.5F7D1EEAE2905C93.title: "Elektrum und Constantan"
	quest.5F8D04C8C623504B.quest_desc: [
		"Wandelt automatisch um: Nuggets, Barren und Blöcke liegen in einer Schublade und du nimmst raus, was du brauchst."
	]
	quest.5F8D04C8C623504B.title: "Verdichtungsschublade"
	quest.5FB80ED347529826.quest_desc: [
		"Terralith baut die Overworld um: heiße Quellen, Vulkane, Kirschblütentäler. Der Kompass der Natur findet Biome für dich."
	]
	quest.5FB80ED347529826.title: "Terralith"
	quest.5FC8AC773525DC2D.quest_desc: [
		"Kampf ist hier Vanilla, aber du hast viel mehr Waffen zur Auswahl: Simply Swords, Archers, Rogues & Warriors und mehr.\n\nJede Waffenart spielt sich anders. Probier einfach aus, was dir liegt."
	]
	quest.5FC8AC773525DC2D.title: "Waffenkammer"
	quest.5FD1C12B8EF7053A.quest_desc: [
		"Der &eTragbare Energiespeicher&r puffert Strom für dein Netz."
	]
	quest.5FD1C12B8EF7053A.title: "Energiespeicher"
	quest.5FDB7E58DD6A46D6.quest_desc: [
		"&eWachstum&r wirkt wie Knochenmehl, &eErnte&r erntet reife Pflanzen und pflanzt neu."
	]
	quest.5FDB7E58DD6A46D6.title: "Natur-Glyphen"
	quest.5FF569CD20969FE0.quest_desc: [
		"Mit FTB Teams spielt ihr als Team: &e/ftbteams party create <Name>&r, dann lädst du andere mit &e/ftbteams party invite <Spieler>&r ein."
		""
		"Das Team teilt sich den Quest-Fortschritt. Was einer erledigt, ist für alle erledigt."
	]
	quest.5FF569CD20969FE0.title: "Ein Team gründen"
	quest.5FF6752CBC44B92C.quest_desc: [
		"Ein Langbogen aus Knochen. Er zieht langsamer, schießt aber stärker als der normale Bogen."
	]
	quest.5FF6752CBC44B92C.title: "Kompositbogen"
	quest.5FFF4C719AC45B6B.quest_desc: [
		"Eine Legierung aus Gold und Silber. Wo du sie herstellst, zeigt EMI."
	]
	quest.5FFF4C719AC45B6B.title: "Elektrum"
	quest.70280879DB26AA8B.quest_desc: [
		"Runen sind das Herz jeder Schule. Ein leerer Runenstein wird mit dem Fokus-Item einer Schule geprägt."
	]
	quest.70280879DB26AA8B.title: "Leere Runensteine"
	quest.7031B172ED438FB9.quest_desc: [
		"Andesit plus Eisen- oder Zinkklumpen ergibt &eAndesitlegierung&r. Daraus besteht fast alles in Create.\n\nSpäter kann der Mixer die Legierung für dich herstellen."
	]
	quest.7031B172ED438FB9.title: "Andesitlegierung"
	quest.7039A4C4C36ED18F.quest_desc: [
		"Braucht Wärme von unten (Lava, Magma und Co.) und Kühlung mit Wasser oder Eis."
	]
	quest.7039A4C4C36ED18F.title: "Thermo-Generator"
	quest.704A0A13B6F0CE96.quest_desc: [
		"Atomlegierung (mit Raffiniertem Obsidian infundiert) und der ultimative Schaltkreis. Die höchste Stufe!"
	]
	quest.704A0A13B6F0CE96.title: "Ultimativ"
	quest.7051B3593A22F472.quest_desc: [
		"Wenn du den Enderdrachen besiegst, lässt er ein &eDrachenherz&r fallen. Herz, Draconium-Blöcke und Draconium-Kerne verschmelzen per Fusion (Wyvern-Stufe) zu &eErwachtem Draconium&r."
		""
		"Der Drache lässt sich mit Endkristallen neu beschwören, falls du mehr Herzen brauchst."
	]
	quest.7051B3593A22F472.title: "Erwachtes Draconium"
	quest.7052F1010D4774CE.quest_desc: [
		"Buch, Feder und schwarzer Farbstoff werden im Geisterfeuer zu Tabu-Buch, erwachter Feder und gereinigter Tinte. Daraus wird ein &eBindungsbuch&r.\n\nKombinier es mit dem Wörterbuch, dann kennst du den Namen des Geistes und das Buch ist gebunden."
	]
	quest.7052F1010D4774CE.title: "Bindungsbuch: Foliot"
	quest.7067082034621F27.quest_desc: [
		"Ein Foliot in einer magischen Lampe baut für dich Erze ab. Iesnium-Spitzhacke und Lampe kommen ins Ritual."
	]
	quest.7067082034621F27.title: "Geister-Bergbau"
	quest.706800609AEB7869.quest_desc: [
		"Mehr Plätze für Zauber als das Notizbuch."
	]
	quest.706800609AEB7869.title: "Eisernes Buch"
	quest.707D0F5F22AA7441.quest_desc: [
		"Gold, Lapis, Erfahrung und End-Stein."
	]
	quest.707D0F5F22AA7441.title: "Stufe 4: Gold und Lapis"
	quest.7085DA41999ACC0C.quest_desc: [
		"Ambrosium-Splitter heilen ein bisschen und sind Brennstoff für Altar und Freezer."
	]
	quest.7085DA41999ACC0C.title: "Ambrosium"
	quest.709801E59DFFA810.quest_desc: [
		"Die Quantenrüstung ist mit dem ME-Netz verbunden und lässt sich mit Karten aufrüsten. Basis ist Netherit, und für die Platten brauchst du einen Netherstern."
	]
	quest.709801E59DFFA810.title: "Quantenrüstung"
	quest.709FB3DDB244BA04.quest_desc: [
		"Die verbesserten Höllenregale geben noch mehr Eterna bzw. Quanta."
	]
	quest.709FB3DDB244BA04.title: "Glühend und lodernd"
	quest.70B180FA1251A142.quest_desc: [
		"Mit Graphitformen gießt du Barren. Stahl und Wolfram gibt es so nur hier. Wolframit findest du als Erz."
	]
	quest.70B180FA1251A142.title: "Stahl und Wolfram"
	quest.70BC043C001FD949.quest_desc: [
		"Sophisticated Backpacks: ein Rucksack mit eigenen Upgrade-Slots. Du kannst ihn tragen oder als Block abstellen."
		""
		"Mit &eB&r öffnest du ihn, während du ihn trägst."
	]
	quest.70BC043C001FD949.title: "Rucksack"
	quest.70D3F7785F3C21F0.quest_desc: [
		"Leeres Pergament ist die Basis für Schriftrollen und Rituale."
	]
	quest.70D3F7785F3C21F0.title: "Pergament"
	quest.70DA252F1E6F30E8.quest_desc: [
		"Mit Stößel und Mörser zermahlst du Kräuter zu Mischungen."
	]
	quest.70DA252F1E6F30E8.title: "Mörser"
	quest.70EFAAA480DAC57C.quest_desc: [
		"Läuft deine Montagestraße? Dann her damit."
	]
	quest.70EFAAA480DAC57C.title: "Abgabe: Präzisionsgetriebe"
	quest.710D00F679A63C7D.quest_desc: [
		"Sirenen leben am Meer. Mit dem Amulett holst du dir eine nach Hause."
	]
	quest.710D00F679A63C7D.title: "Sirene"
	quest.710EB57C692C3F9D.quest_desc: [
		"Zeig, dass deine Legierungs-Produktion läuft."
	]
	quest.710EB57C692C3F9D.title: "Abgabe: Andesitlegierung"
	quest.712A57AAE4399292.quest_desc: [
		"Die Basis für alle Rucksack-Upgrades. Upgrades steckst du rechts im Rucksack-Fenster ein."
	]
	quest.712A57AAE4399292.title: "Rucksack-Upgrades"
	quest.71424B3192094B27.quest_desc: [
		"Ein Bauteil für Elektromotor, Akku und Teslaspule."
	]
	quest.71424B3192094B27.title: "Kondensator"
	quest.7156E7C24DDC9215.quest_desc: [
		"Eisen mit Kohle infundieren, das Ergebnis noch einmal infundieren und den Stahlstaub im Ofen schmelzen."
	]
	quest.7156E7C24DDC9215.title: "Stahl"
	quest.716A4D98506918B1.quest_desc: [
		"Drei gleiche Tränke und sechs Lohenstaub ergeben ein &eTrank-Amulett&r. Im Inventar gibt es dir den Trank-Effekt dauerhaft, solange es Haltbarkeit hat."
	]
	quest.716A4D98506918B1.title: "Trank-Amulett"
	quest.717D43283A7C701F.quest_desc: [
		"Endergolems bewachen die Zerfallene Zitadelle im End. Sie lassen einen &eLeerenkern&r fallen."
	]
	quest.717D43283A7C701F.title: "Endergolem"
	quest.717F2F753C0B9CE8.quest_desc: [
		"Schiebt Blöcke vor und zurück, so weit die Verlängerungsstangen reichen."
	]
	quest.717F2F753C0B9CE8.title: "Mechanischer Kolben"
	quest.7180357A290DAA08.quest_desc: [
		"Dinosaurier unter der Erde! Riesige Höhle mit Dschungel, Vulkanen und Bernstein."
	]
	quest.7180357A290DAA08.title: "Urzeit-Höhlen"
	quest.7185A3D85D3FC4B0.quest_desc: [
		"Podeste halten Zutaten für die Kammer und den Verzauberungsapparat. Rund um die Kammer gestellt, ermöglichen sie neue Rezepte."
	]
	quest.7185A3D85D3FC4B0.title: "Arkanes Podest"
	quest.718D79B0BA9AE058.quest_desc: [
		"Der Pumpenbock fördert Rohöl aus dem Boden. Den Aufbau zeigt das Ponder."
	]
	quest.718D79B0BA9AE058.title: "Pumpenbock"
	quest.71BDF721C338EA17.quest_desc: [
		"In der Schmiede machst du aus Papier, Tinte und einem Fokus-Item eine neue Schriftrolle der passenden Schule."
	]
	quest.71BDF721C338EA17.title: "Schriftrollen-Schmiede"
	quest.71C65067CA8E7404.quest_desc: [
		"Comforts: Im Schlafsack schläfst du nachts, ohne deinen Spawnpunkt zu ändern. Ideal unterwegs."
		""
		"Die Hängematte hängst du mit Seil und Nägeln zwischen zwei Blöcke. Darin schläfst du am Tag bis zur Nacht."
	]
	quest.71C65067CA8E7404.title: "Schlafsack und Hängematte"
	quest.71D2BD5535739D9F.quest_desc: [
		"Der Solar-Neutronen-Aktivator macht aus Atommüll Polonium. Daraus entstehen Polonium-Pellets für die Endgame-Rezepte."
	]
	quest.71D2BD5535739D9F.title: "Polonium"
	quest.71D357980117F27E.quest_desc: [
		"Eisen, Kohle und Obsidian. Dunkelstahl ist hart und steckt in Werkzeugen und besseren Maschinen."
	]
	quest.71D357980117F27E.title: "Dunkelstahl"
	quest.71DC93DC79FC8AF2.quest_desc: [
		"&eEnderische Verbindung&r bekommst du u. a. aus dem Pulverizer, z. B. aus Enderperlen. Du brauchst sie für den Laser."
	]
	quest.71DC93DC79FC8AF2.title: "Enderische Verbindung"
	quest.71DD9257BE56BF00.quest_desc: [
		"EMI Loot zeigt in EMI auch Beute: Drück &eR&r auf ein Item und du siehst, welche Mobs, Blöcke und Truhen es fallen lassen."
	]
	quest.71DD9257BE56BF00.title: "Was droppt wo?"
	quest.71E141B611AE7AEE.quest_desc: [
		"Die größte normale Speicherzelle. Damit ist dein Lager für lange Zeit groß genug."
	]
	quest.71E141B611AE7AEE.title: "Riesenlager"
	quest.71E3B0DD4DE8E73D.quest_desc: [
		"Aus Gehäuse und Glas baust du die Außenhülle des Reaktors. Die Größe bestimmst du selbst."
	]
	quest.71E3B0DD4DE8E73D.title: "Reaktorgehäuse"
	quest.7200200FB52FD53F.quest_desc: [
		"Dank Lootr hat jede Truhe in Strukturen für jeden Spieler eigene Beute. Ihr müsst euch also nicht beeilen, wer zuerst plündert."
		""
		"Zum Abbauen einer Lootr-Truhe musst du schleichen."
	]
	quest.7200200FB52FD53F.title: "Eigene Beute"
	quest.722CEFB96B22D92B.quest_desc: [
		"Roben für Heilig, Evokation und Natur."
	]
	quest.722CEFB96B22D92B.title: "Priester und Evoker"
	quest.7232BA1CDB30A59A.quest_desc: [
		"L_Ender's Cataclysm versteckt starke Bosse in großen Strukturen. Die Uralte Fabrik in der Overworld ist ein Anfang (Kämpfe: siehe Bosse-Kapitel)."
	]
	quest.7232BA1CDB30A59A.title: "Uralte Fabrik"
	quest.723719286E4299DF.quest_desc: [
		"Das Ladegerät lädt Certus-Quarz auf. Strom bekommt es per FE von einer anderen Mod oder du kurbelst mit der Holzkurbel."
	]
	quest.723719286E4299DF.title: "Unter Strom"
	quest.723B195D28A35401.quest_desc: [
		"&eArs Ocultas&r verbindet Ars mit Occultism. Der Altar braucht Silber und eine goldene Opferschale aus Occultism."
	]
	quest.723B195D28A35401.title: "Opferaltar"
	quest.723FFFFB3130AE5A.quest_desc: [
		"Wellen leiten Drehbewegung weiter, in gerader Linie.\n\nAlles in Create läuft über Rotation: Quelle, Welle, Maschine."
	]
	quest.723FFFFB3130AE5A.title: "Wellen"
	quest.725B598A337D8364.quest_desc: [
		"Für Wasser, Lava und Milch. Ein Wassereimer rettet dich auch bei Stürzen."
	]
	quest.725B598A337D8364.title: "Eimer"
	quest.726AC811D4977176.quest_desc: [
		"Überladene Metalle brauchst du für bessere Motoren, Drähte und Heizungen."
	]
	quest.726AC811D4977176.title: "Überladene Metalle"
	quest.727E270803076BB7.quest_desc: [
		"Jede Farbe trägt andere Früchte und wird für andere Rituale gebraucht. Sammel von jeder Art Holz."
	]
	quest.727E270803076BB7.title: "Vier Archwood-Arten"
	quest.72967E589692A5C0.quest_desc: [
		"Endlich siehst du alles auf einen Blick. Die Konsole zeigt alle Items im Netzwerk mit Suchfeld."
	]
	quest.72967E589692A5C0.title: "ME-Konsole"
	quest.72AF9A03A2764343.quest_desc: [
		"Linsen kommen vor den Rekonstruktor und ändern den Laser. Die &eLinse des Bergmanns&r erzeugt z. B. Erze im Stein."
	]
	quest.72AF9A03A2764343.title: "Linsen"
	quest.72B04CE4EC2ED1AC.quest_desc: [
		"Ohne Steuerung fährt kein Zug. Setz dich davor und fahr selbst, oder gib dem Zug einen Fahrplan."
	]
	quest.72B04CE4EC2ED1AC.title: "Zugsteuerung"
	quest.72B5C24D234DA8D2.quest_desc: [
		"Mit dem &eManometer&r siehst du den Druck in Rohren und Maschinen, mit dem &ePneumatischen Schraubenschlüssel&r drehst du Blöcke und baust sie schnell ab."
	]
	quest.72B5C24D234DA8D2.title: "Druck messen"
	quest.72C65EEBF10EE622.quest_desc: [
		"Packt den Inhalt eines Lagers in Pakete und packt Pakete wieder aus. Pakete haben eine Adresse."
	]
	quest.72C65EEBF10EE622.title: "Verpacker"
	quest.72E8B73059819995.quest_desc: [
		"Der &eDimensional Storage Actuator&r ist ein ganzes Lagersystem in einem Block. Foliot und Djinni stellen die Teile im Ritual her."
	]
	quest.72E8B73059819995.title: "Dimensionales Lager"
	quest.7303C4DD108E7C51.quest_desc: [
		"Ein Curio-Ring für mehr Mana."
	]
	quest.7303C4DD108E7C51.title: "Ring des Manas"
	quest.730B1D39D839186C.quest_desc: [
		"Der &ePulverizer&r mahlt Erze zu Staub und verdoppelt so deine Ausbeute."
	]
	quest.730B1D39D839186C.title: "Pulverizer"
	quest.730C251306BE383E.quest_desc: [
		"Doppelschicht- und Oktadischer Kondensator. Tausch sie gegen die einfachen, dann laufen deine Maschinen deutlich schneller."
	]
	quest.730C251306BE383E.title: "Bessere Kondensatoren"
	quest.731D6E87C7D21E20.quest_desc: [
		"Open Parties and Claims schützt deine Chunks vor Fremden und Mobs-Griefing. Chunks beanspruchst du direkt auf der Xaero-Weltkarte (Rechtsklick) oder im Claims-Menü."
		""
		"Dein Team darf in deinen Chunks bauen, andere nicht."
	]
	quest.731D6E87C7D21E20.title: "Grundstück sichern"
	quest.7355898D68B1F468.quest_desc: [
		"Das Gehäuse für die großen Blöcke im Netzwerk."
	]
	quest.7355898D68B1F468.title: "Maschinengehäuse"
	quest.735A6F339644AF18.quest_desc: [
		"Das Zauberbuch des Erzmagiers hat Platz für die stärksten Glyphen von Ars Nouveau."
	]
	quest.735A6F339644AF18.title: "Erzmagier"
	quest.736F8A72717BDDA2.quest_desc: [
		"Stell die Kugel hin und Energiestäbe drumherum in Reichweite. Die Stäbe brauchen Strom, die Kugel verwandelt dann Items."
	]
	quest.736F8A72717BDDA2.title: "Energiekugel"
	quest.7373720CF4574E06.quest_desc: [
		"Die &eZentrifuge&r trennt Stoffe auf. Mit dem Flüssigkeits-Addon verarbeitet sie auch Flüssigkeiten. Aus Kohlestaub macht sie Kohlefasern."
	]
	quest.7373720CF4574E06.title: "Zentrifuge"
	quest.737AFD55F6B4B69A.quest_desc: [
		"Genauso wie Barren: Diamant und Prosperity ergeben einen Prosperity-Edelstein, mit Essenz den Edelstein der Stufe. Daraus werden Werkzeuge wie die Sichel."
	]
	quest.737AFD55F6B4B69A.title: "Essenz-Edelsteine"
	quest.737BA78A73DE35D8.quest_desc: [
		"Gib 64 Certus-Quarz ab. Mit Knospen-Blöcken und Wachstumsbeschleuniger wird das bald ein Klacks."
	]
	quest.737BA78A73DE35D8.title: "Abgabe: Certus"
	quest.738A8835181888C5.quest_desc: [
		"Der Höhepunkt: Nethersterne vom Feld. Setz den Netherstern-Crux unter das Ackerland, sonst wächst nichts."
	]
	quest.738A8835181888C5.title: "Netherstern-Samen"
	quest.73905C48D054EEBF.quest_desc: [
		"Immersive Armors hat viele Sets mit eigenen Effekten. Die schwere Rüstung schützt stark, macht dich aber langsam."
	]
	quest.73905C48D054EEBF.title: "Schwere Rüstung"
	quest.7390A586441BA250.quest_desc: [
		"Elevator Mod: Stell zwei Aufzug-Blöcke genau übereinander, mit beliebig viel Platz dazwischen."
		""
		"Auf dem Block &eSpringen&r fährt nach oben, &eSchleichen&r nach unten. Für den Aufzug brauchst du Wolle und eine Enderperle."
	]
	quest.7390A586441BA250.title: "Aufzug"
	quest.739357D0EDBAD9B9.quest_desc: [
		"Kupfer auf entrindetes Holz. Grundlage für Ausguss und Abfluss."
	]
	quest.739357D0EDBAD9B9.title: "Kupferrahmen"
	quest.73A3CB3A69E5D177.quest_desc: [
		"Das zweite Buch: mehr Mana und Zugriff auf stärkere Glyphen. Du brauchst dafür einen Lohenrute aus dem Nether."
	]
	quest.73A3CB3A69E5D177.title: "Magier-Zauberbuch"
	quest.73B949E7BF99ECFF.quest_desc: [
		"Drachenhaut, Obsidian und ein zerstörtes Buch. Ein starkes Buch für Endgame-Magier."
	]
	quest.73B949E7BF99ECFF.title: "Drachenhautbuch"
	quest.73BD1BE78E4BA748.quest_desc: [
		"Pad in der Overworld benutzen: Die Mining-Dimension ist flach und ideal für Steinbrüche und zum Testen."
	]
	quest.73BD1BE78E4BA748.title: "Mining-Dimension"
	quest.73C6FE8D34742A63.quest_desc: [
		"Ein Obelisk neben der Schmiede erzeugt passiv &eAureal&r-Essenz. Du baust ihn aus arkanen Kristallblöcken auf arkanem Darkstone und weckst ihn mit Mundabitur-Staub."
	]
	quest.73C6FE8D34742A63.title: "Arkaner Obelisk"
	quest.73CDA466DC1DA3BF.quest_desc: [
		"Alle großen Bosse liegen dir zu Füßen."
	]
	quest.73CDA466DC1DA3BF.title: "Bossjäger"
	quest.73D98FD73535E685.quest_desc: [
		"Stell den Assembler direkt an den Provider. Er erledigt alle normalen Werkbank-Rezepte."
	]
	quest.73D98FD73535E685.title: "Molekularassembler"
	quest.73DFEB47082A7C15.quest_desc: [
		"Der Tierfarmer melkt und schert Tiere in seiner Reichweite, der Tierfütterer sorgt für Nachwuchs."
	]
	quest.73DFEB47082A7C15.title: "Tierfarm"
	quest.73F04C6F357FA1DC.quest_desc: [
		"Schwebende Inseln über den Wolken. &cPass auf, nicht herunterzufallen!&r Unten wartet die Overworld, aus großer Höhe.\n\nWerkzeuge aus Himmelswurzel- (Skyroot) Holz und Heiligstein gibt es gleich am Anfang."
	]
	quest.73F04C6F357FA1DC.title: "Der Aether"
	quest.73F859085DECE506.quest_desc: [
		"Das Material für &5epische&r Ausrüstung. Epische Teile findest du eher in schwierigen Gegenden und bei Bossen."
	]
	quest.73F859085DECE506.title: "Arkaner Sand"
	quest.73FD8B3805A285CC.quest_desc: [
		"Ein Zauberbuch mit Bonus auf Eiszauber. Dafür brauchst du Eisgift; woher es kommt, zeigt EMI."
	]
	quest.73FD8B3805A285CC.title: "Frostbuch"
	quest.73FE427D1DFC30CC.quest_desc: [
		"Der Kessel braut Tinte und Elixiere und löst alte Schriftrollen wieder auf. Stell ihn über ein Feuer."
	]
	quest.73FE427D1DFC30CC.title: "Alchemistenkessel"
	quest.74098C5DBE34760E.quest_desc: [
		"Fischfilet und Seegras ergeben Sushi."
	]
	quest.74098C5DBE34760E.title: "Sushi"
	quest.7409A789B7D28D25.quest_desc: [
		"Cooking for Blockheads: Das Kochbuch zeigt dir alle Gerichte, die du mit den Zutaten in deinem Inventar kochen kannst."
	]
	quest.7409A789B7D28D25.title: "Kochbuch"
	quest.741229F943E627A1.quest_desc: [
		"Zwei Mahlwerkräder nebeneinander, gegenläufig gedreht: Erze werden zerkleinert, mit mehr Bonus als beim Mahlstein.\n\nDamit sind die Grundlagen geschafft. Weiter geht es mit Dampf, Zügen und Logistik!"
	]
	quest.741229F943E627A1.title: "Mahlwerk"
	quest.742D9DA3667D8349.quest_desc: [
		"Presst Barren auf einem Depot oder Förderband zu Blechen. Über einem Becken kann sie Items verdichten."
	]
	quest.742D9DA3667D8349.title: "Mechanische Presse"
	quest.7438C528B9F74410.quest_desc: [
		"&eLicht&r setzt Magielichter, &eEntzünden&r legt Feuer, &eUnter den Füßen&r wirkt den Zauber auf den Block unter dir."
	]
	quest.7438C528B9F74410.title: "Nützliche Glyphen"
	quest.743B8BB897219955.quest_desc: [
		"Die Schleuse nimmt Items von Bändern und aus Kisten oder legt sie hinein. Der Tunnel verteilt Items auf nebeneinanderliegende Bänder."
	]
	quest.743B8BB897219955.title: "Schleuse und Tunnel"
	quest.7440044A9BDF183F.quest_desc: [
		"Würfle die Affixe eines Gegenstands neu aus. Kostet Material und Edelsteinstaub."
	]
	quest.7440044A9BDF183F.title: "Einfacher Umschmiedetisch"
	quest.744908FBE18473ED.quest_desc: [
		"Der Drache ist besiegt, jetzt beginnt das echte Endgame. Für jede große Mod gibt es hier ein letztes Ziel.\n\nJede Quest wird frei, sobald du das passende Kapitel abgeschlossen hast."
	]
	quest.744908FBE18473ED.title: "Das große Finale"
	quest.744D80EB6E87ECCA.quest_desc: [
		"Harnisch und Beinschutz aus Nagaschuppen."
	]
	quest.744D80EB6E87ECCA.title: "Nagarüstung"
	quest.745895C31AA831F2.quest_desc: [
		"Das Gegenstück für Biome. Sehr praktisch, wenn du ein bestimmtes Biom suchst."
	]
	quest.745895C31AA831F2.title: "Kompass der Natur"
	quest.745B1FDCD23332F0.quest_desc: [
		"Infinity-Werkzeuge laufen mit Strom, wachsen mit Stufen und laden im Infinity-Ladegerät auf."
	]
	quest.745B1FDCD23332F0.title: "Unendlichkeit"
	quest.7489E428DB65C72A.quest_desc: [
		"Prosperity-Erz ist etwas seltener. Die Splitter brauchst du für Samenbasen, Infusionskristalle und Barren."
	]
	quest.7489E428DB65C72A.title: "Prosperity"
	quest.7495DE051E223842.quest_desc: [
		"Zu viel Bruchstein im Lager? Gib 256 Stück ab und bekomm dafür eine seltene Kiste."
	]
	quest.7495DE051E223842.title: "Abgabe: Bruchstein"
	quest.7498B3A2F0CA0C8E.quest_desc: [
		"Aether, Undergarden, Otherside, Bumblezone, Twilight Forest, The Beyond und der Mars: Du warst überall.\n\nWer das geschafft hat, hat wirklich alles gesehen. Hak ab und hol dir die Belohnung."
	]
	quest.7498B3A2F0CA0C8E.title: "Weltenbummler"
	quest.74A943755402B2ED.quest_desc: [
		"Universalkabel für Strom, Rohre für Flüssigkeiten, Druckschläuche für Gase."
	]
	quest.74A943755402B2ED.title: "Leitungen"
	quest.74BC2FB065B9D8E8.quest_desc: [
		"Lila Kreide brauchst du für das Foliot-Handwerkspentakel. Damit stellt ein Foliot Gegenstände für dich her."
	]
	quest.74BC2FB065B9D8E8.title: "Lila Kreide"
	quest.74C0EF07792FCF56.quest_desc: [
		"Hebt und senkt Blöcke senkrecht am Seil."
	]
	quest.74C0EF07792FCF56.title: "Flaschenzug"
	quest.74C906347AD0C652.quest_desc: [
		"Mit dieser Schmiedevorlage bringst du Modifikatoren auf Werkzeuge und Rüstung, z. B. &eewig&r (unzerstörbar) oder &emagnetisch&r."
	]
	quest.74C906347AD0C652.title: "Modifikatoren"
	quest.74DE9DAA189ED502.quest_desc: [
		"Tanks lassen sich zu großen Speichern stapeln und verbinden."
	]
	quest.74DE9DAA189ED502.title: "Flüssigkeitstank"
	quest.74DFFEBA3439E943.quest_desc: [
		"Oben rechts ist die Xaero-Minimap. Mit &eM&r öffnest du die große Weltkarte, mit &eB&r setzt du einen Wegpunkt."
		""
		"Wenn du stirbst, wird automatisch ein Todes-Wegpunkt gesetzt."
	]
	quest.74DFFEBA3439E943.title: "Minimap und Weltkarte"
	quest.74F47EBA9AFFC99A.quest_desc: [
		"Aus seinen Knochen kannst du eine eigene Rüstung bauen. Schau in EMI nach."
	]
	quest.74F47EBA9AFFC99A.title: "Mutantenskelett"
	quest.74FB2DE10B6D7B9D.quest_desc: [
		"Manche Endstädte haben ein Schiff. Dort hängt eine Elytra im Rahmen. Mit Feuerwerksraketen fliegst du damit richtig weit."
	]
	quest.74FB2DE10B6D7B9D.title: "Flügel"
	quest.750EB9A544BC7E5F.quest_desc: [
		"An Seilen aus Supplementaries kannst du hoch- und runterklettern. Gut für Schächte und Höhlen."
	]
	quest.750EB9A544BC7E5F.title: "Seil"
	quest.750F5EF7F3E1478F.quest_desc: [
		"Wie bei Vanilla: Diamantwaffe, Netheritbarren und Netherit-Schmiedevorlage in den Schmiedetisch."
	]
	quest.750F5EF7F3E1478F.title: "Netheritklinge"
	quest.750F9518FA3362B0.quest_desc: [
		"HDPE entsteht in der Druck-Reaktionskammer aus Substrat, Ethen und Sauerstoff. Die Folien stecken in MekaSuit, SPS und Modulen."
	]
	quest.750F9518FA3362B0.title: "Plastik"
	quest.7518AA78B267E39E.quest_desc: [
		"In der Welt gibt es viele besondere Nester: in Stein, Sand, Schnee, im Nether und im End. Aus jedem kommen andere wilde Bienen. Der Nest-Finder zeigt dir die Richtung."
	]
	quest.7518AA78B267E39E.title: "Nester finden"
	quest.7529BFEBCB0FF9E2.quest_desc: [
		"Im &eGärfass&r wird Rapsöl veredelt. Der &eÖlgenerator&r verbrennt die Öle zu Strom, das bessere Öl gibt mehr."
	]
	quest.7529BFEBCB0FF9E2.title: "Ölgenerator"
	quest.752B64908FE70DE4.quest_desc: [
		"Unter dem Ackerland platziert lässt er die Pflanzen darüber schneller wachsen. Je höher die Stufe, desto größer die Reichweite."
	]
	quest.752B64908FE70DE4.title: "Wachstumsbeschleuniger"
	quest.756D8A47BF739035.quest_desc: [
		"Die Diamant-Erweiterung bringt richtig viel Platz. Darüber gibt es nur noch Netherit."
	]
	quest.756D8A47BF739035.title: "Noch größer"
	quest.75739C2C9A43B64C.quest_desc: [
		"Modifikationen machen ein Rohr schneller und schalten Filter und Verteilmodi frei. Es gibt mehrere Stufen."
	]
	quest.75739C2C9A43B64C.title: "Rohr-Modifikation"
	quest.758E3E4158402D76.quest_desc: [
		"Erweitert ein Zauberbuch um einen Platz."
	]
	quest.758E3E4158402D76.title: "Mehr Zauberplätze"
	quest.75A248C6B8B1FB6B.quest_desc: [
		"Diesel, Kerosin und LPG sind gute Brennstoffe und Zutaten. LPG brauchst du gleich für Plastik."
	]
	quest.75A248C6B8B1FB6B.title: "Treibstoffe"
	quest.75A34509B82AA848.quest_desc: [
		"BetterEnd verwandelt die äußeren Inseln: neblige Pilzlande, Chorus-Wälder und Kristallberge."
	]
	quest.75A34509B82AA848.title: "End-Biome"
	quest.75C192B636A80509.quest_desc: [
		"Ein ewig dämmriger Wald voller Bosse. Alles dazu steht im eigenen Kapitel &2Twilight Forest&r."
	]
	quest.75C192B636A80509.title: "Twilight Forest"
	quest.75DF269E30E7CA19.quest_desc: [
		"Osmium brauchst du ständig. Gib 64 Barren ab."
	]
	quest.75DF269E30E7CA19.title: "Abgabe: Osmium"
	quest.75FFB5081D3EAF14.quest_desc: [
		"Energie-Kristalle übertragen Strom &ekabellos&r. Mit dem Kristallbinder verbindest du sie."
	]
	quest.75FFB5081D3EAF14.title: "Energie-Kristalle"
	quest.76117789BAA94D97.quest_desc: [
		"Essenzen entstehen in der Verzauberungskammer, wenn Podeste mit den passenden Zutaten drumherum stehen. Sie stecken in vielen Glyphen."
	]
	quest.76117789BAA94D97.title: "Essenzen"
	quest.7624B3FFF6FE597A.quest_desc: [
		"Merkt sich einen Ort und bringt dich dorthin zurück. Wird beim Benutzen verbraucht."
	]
	quest.7624B3FFF6FE597A.title: "Warp-Schriftrolle"
	quest.7646DCE867DF81E0.quest_desc: [
		"&eGlück&r bringt mehr Drops, &eExtrahieren&r baut Blöcke wie mit Behutsamkeit ab."
	]
	quest.7646DCE867DF81E0.title: "Mehr Beute"
	quest.764AB106ACACE0A0.quest_desc: [
		"Runentafeln findest du in Truhen. Mit Diamant wird daraus eine Runenwaffe mit zufälliger Fähigkeit."
	]
	quest.764AB106ACACE0A0.title: "Runentafel"
	quest.7653F1086E5DAC47.quest_desc: [
		"Der Extended Machine Frame ist die Basis für die großen ExtendedAE-Strukturen."
	]
	quest.7653F1086E5DAC47.title: "Maschinenrahmen"
	quest.7658A16568C80FE7.quest_desc: [
		"Die Unobtainium-Vorlage entsteht aus Vibranium und Endstein. Danach geht es wie bei den Stufen davor."
	]
	quest.7658A16568C80FE7.title: "Unobtainium-Spitzhacke"
	quest.766BD0C0C59A81FE.quest_desc: [
		"&eRaps&r (Canola) wächst wild. Die Rapspresse macht daraus Rapsöl."
	]
	quest.766BD0C0C59A81FE.title: "Raps"
	quest.768010A8535AF6EB.quest_desc: [
		"Bau einen Rahmen aus Obsidian (4 breit, 5 hoch) und zünde ihn mit dem Feuerzeug an."
		""
		"&cVorsicht:&r Im Nether gibt es kein Wasser, und Betten explodieren. Nimm Essen, Blöcke und eine gute Rüstung mit."
	]
	quest.768010A8535AF6EB.title: "Ab in den Nether"
	quest.76866FFECBDCF896.quest_desc: [
		"Diamanten aufladen ergibt niotische Kristalle."
	]
	quest.76866FFECBDCF896.title: "Niotischer Kristall"
	quest.76908281938983FD.quest_desc: [
		"Simply Swords hat viele Waffenarten: Langschwert, Katana, Großhammer, Sense, Speer und mehr. Alle gibt es aus Eisen, Gold, Diamant und Netherit."
	]
	quest.76908281938983FD.title: "Eiserne Klinge"
	quest.769809318A856B1F.quest_desc: [
		"Ein Armreif, der sich mit Essenzen auf ein Element ausrichten lässt. Braucht einen Endkristall."
	]
	quest.769809318A856B1F.title: "Zauberer-Armreif"
	quest.769D0751DBB32792.quest_desc: [
		"Aus dem getrockneten Harz entsteht &eKristallisiertes Menril&r. Daraus wird fast alles der Mod gebaut."
	]
	quest.769D0751DBB32792.title: "Kristallisiertes Menril"
	quest.76A5DF34B008C608.quest_desc: [
		"Bleche brauchst du für viele Rezepte. Ein Förderband unter der Presse macht das vollautomatisch."
	]
	quest.76A5DF34B008C608.title: "Bleche"
	quest.76A79F09E9D39C54.quest_desc: [
		"Säge und Hammer gibt es auch in der Infinity-Version."
	]
	quest.76A79F09E9D39C54.title: "Mehr Unendlichkeit"
	quest.76A915753B38445C.quest_desc: [
		"Lauf, Trommel und Hammer aus Stahl, dazu ein Holzgriff. Mit Upgrades an der Werkbank wird er noch besser."
	]
	quest.76A915753B38445C.title: "Revolver"
	quest.76B750E2193AFEB8.quest_desc: [
		"Ein großes Anwesen der Illager. Erwarte Magier und Verwüster."
	]
	quest.76B750E2193AFEB8.title: "Illager-Anwesen"
	quest.76BE00C3DFE42F0F.quest_desc: [
		"Gib 64 Eisenbarren ab und bekomm dafür eine seltene Kiste."
	]
	quest.76BE00C3DFE42F0F.title: "Abgabe: Eisen"
	quest.76C23EB01CAAF8CB.quest_desc: [
		"An einer fahrenden Contraption ernten sie Felder bzw. pflügen den Boden."
	]
	quest.76C23EB01CAAF8CB.title: "Erntemaschine und Pflug"
	quest.76C90CBCC4E57A7D.quest_desc: [
		"Create Big Cannons: Kanonen baust du aus einzelnen Blöcken auf einer Kanonenstütze. Die Holzkanone ist der Einstieg.\n\nDas Ponder erklärt Aufbau und Laden."
	]
	quest.76C90CBCC4E57A7D.title: "Erste Kanone"
	quest.76CF8FAB836EE64C.quest_desc: [
		"Die Latexverarbeitung macht mit Strom aus Latex und Wasser Gummiklumpen."
	]
	quest.76CF8FAB836EE64C.title: "Gummi"
	quest.76CFD07B09E9C244.quest_desc: [
		"Das erste richtige Regal: mehr Eterna und Quanta. Du brauchst dafür Netherziegel und Lohenruten."
	]
	quest.76CFD07B09E9C244.title: "Höllenregal"
	quest.76D7706B4F43AB4E.quest_desc: [
		"Gib 64 Schwarzen Quarz ab und hol dir eine Belohnung."
	]
	quest.76D7706B4F43AB4E.title: "Abgabe: Schwarzer Quarz"
	quest.76D7D309A7284A42.quest_desc: [
		"Gehäuse der Leere, Bimetallzahnrad und einfacher Kondensator sind die Grundlage der ersten Maschinen. Kondensatoren kommen in einen eigenen Slot und machen Maschinen schneller."
	]
	quest.76D7D309A7284A42.title: "Gehäuse der Leere"
	quest.76DFAF14CC5E07E3.quest_desc: [
		"Jede Seltenheit hat ihr Material: Gewöhnlich, Ungewöhnlich und Selten. Du brauchst sie zum Schleifen von Edelsteinen und zum Umschmieden."
	]
	quest.76DFAF14CC5E07E3.title: "Seltenheitsmaterial"
	quest.76E3A4004544D385.quest_desc: [
		"Bretter plus ein Eimer Kreosotöl ergeben behandeltes Holz. Das brauchst du für Werkbank, Windräder und viele Bauteile."
	]
	quest.76E3A4004544D385.title: "Behandeltes Holz"
	quest.76EF3C773870B1DA.quest_desc: [
		"Pulverisierter Obsidian wird über mehrere Schritte zu Robustem Blech. Wie genau, zeigt dir EMI."
	]
	quest.76EF3C773870B1DA.title: "Robustes Blech"
	quest.76F5E1350AEC1627.quest_desc: [
		"Die Werkbank brauchst du für fast alles."
		""
		"Dank Visual Workbench bleiben die Items liegen, wenn du sie verlässt, und du siehst sie oben auf dem Block."
	]
	quest.76F5E1350AEC1627.title: "Werkbank"
	quest.76F910D48C09D19B.quest_desc: [
		"Gib 32 Dunkle Edelsteine ab und bekomm dafür eine seltene Kiste."
	]
	quest.76F910D48C09D19B.title: "Abgabe: Dunkle Edelsteine"
	quest.76FB08086710BAC9.quest_desc: [
		"Die Railgun von Immersive Engineering verschießt Stäbe mit Strom. Ein echtes Prunkstück."
	]
	quest.76FB08086710BAC9.title: "Railgun"
	quest.7709305FD5C60622.quest_desc: [
		"BetterNether bringt viele neue Biome. Finde den Nether-Dschungel, die Kieswüste und die Seelenebene."
	]
	quest.7709305FD5C60622.title: "Nether-Biome"
	quest.770B72427A645427.quest_desc: [
		"Ins Laufwerk steckst du die Speicherzellen. Darin landen alle Items deines Netzwerks."
	]
	quest.770B72427A645427.title: "Laufwerk und Speicherzelle"
	quest.7717C33283ACAE3C.quest_desc: [
		"In der Schablonenkonsole schreibst du Rezepte auf leere Schablonen. Das ist der erste Schritt zum Autocrafting."
	]
	quest.7717C33283ACAE3C.title: "Schablonen"
	quest.77352E8DF03C27B0.quest_desc: [
		"Relais schicken Quelle über Entfernung von Glas zu Glas oder zu Maschinen. Verbinde sie mit dem Dominion-Stab."
	]
	quest.77352E8DF03C27B0.title: "Quellrelais"
	quest.7737AE9AC6F36984.quest_desc: [
		"Der Sonnengeist ist der letzte Boss des Aether und haust im Gold-Dungeon. Feuerschutz ist Pflicht."
	]
	quest.7737AE9AC6F36984.title: "Sonnengeist"
	quest.7751BCAB91D8BA98.quest_desc: [
		"Eine Arena tief im Nether, gebaut für einen sehr großen Gegner."
	]
	quest.7751BCAB91D8BA98.title: "Brennende Arena"
	quest.775537CC0E722B0D.quest_desc: [
		"Der Harbinger hinterlässt Witherit. Damit baust du unter anderem den Mechanischen Fusionsamboss."
	]
	quest.775537CC0E722B0D.title: "Witherit"
	quest.77637D8E275DBF21.quest_desc: [
		"Augmente stehen hinter einem Effekt und verändern ihn: stärker, größerer Bereich, längere Dauer.\n\nTipp: Projektil + Abbauen + Fläche ergibt einen 3x3-Abbauzauber."
	]
	quest.77637D8E275DBF21.title: "Augmente"
	quest.7769E9E1CA0D6502.quest_desc: [
		"Der &eGroße Energiespeicher&r fasst richtig viel Strom."
	]
	quest.7769E9E1CA0D6502.title: "Großer Energiespeicher"
	quest.777BA16A9F495E84.quest_desc: [
		"Feuerdrachen leben in Höhlen oder auf Horsten mit viel Gold. Feuerschutz ist Pflicht.\n\nDas Herz brauchst du für die Drachenschmiede."
	]
	quest.777BA16A9F495E84.title: "Feuerdrache"
	quest.77A4F6DAAD802CC4.quest_desc: [
		"Mehr Lohenbrenner, mehr Wasser und ein größerer Tank heben die Kesselstufe. Die Brille zeigt dir, was fehlt.\n\nTipp: Mit Brennstoff per Schleuse oder Mechanischem Arm laufen die Brenner dauerhaft. Hak ab, wenn dein Kessel läuft."
	]
	quest.77A4F6DAAD802CC4.title: "Kessel heizen"
	quest.77A806DB0A85413A.quest_desc: [
		"Füll den Kessel mit geschmolzenem Talg (aus Kerzen, Honigwaben oder Tierfett), setz den Dipper drauf und häng Fäden hinein. So ziehst du Kerzen."
	]
	quest.77A806DB0A85413A.title: "Kerzen ziehen"
	quest.77ACBA9F396D1B95.quest_desc: [
		"Der Kompass zeigt auf den nächsten Meteoriten. Praktisch, wenn du mehrere Pressen-Sätze oder mehr Himmelsstein brauchst."
	]
	quest.77ACBA9F396D1B95.title: "Meteoritenkompass"
	quest.77E07F477656283B.quest_desc: [
		"Die Technica-Version des Meisterzeichens. Braucht ebenfalls den Wilden-Tribut."
	]
	quest.77E07F477656283B.title: "Technomantie-Zeichen"
	quest.77E10D28312CFDB8.quest_desc: [
		"Sand in der SAG-Mühle ergibt Silikon. Das brauchst du später für Steuerungen."
	]
	quest.77E10D28312CFDB8.title: "Silikon"
	quest.77E44B5F9D4F730F.quest_desc: [
		"Dein erstes Ritual: Quantenkern auf die Schmiede, Spawner-Schrott auf die Sockel. Der &eQuantenfänger&r fängt Mobs ein und lässt sie woanders wieder frei.\n\nSpawner-Schrott bekommst du beim Abbauen von Spawnern."
	]
	quest.77E44B5F9D4F730F.title: "Quantenfänger"
	quest.77EB2A78FA4E6BF5.quest_desc: [
		"Die dritte Stufe der Injektoren. Jetzt sind die Draconic-Werkzeuge dran."
	]
	quest.77EB2A78FA4E6BF5.title: "Draconic-Injektoren"
	quest.77EBE0ECB68949C1.quest_desc: [
		"Die Robe aus Ars Technica: Arkanisten-Robe, Netherit, Messing und ein Meister- oder Technomantie-Zeichen."
	]
	quest.77EBE0ECB68949C1.title: "Technomanten-Robe"
	quest.77F327FA3244D192.quest_desc: [
		"Göttliche Perle für Heilig, giftige Kartoffel für Natur, Smaragd für Evokation."
	]
	quest.77F327FA3244D192.title: "Heilig, Natur, Evokation"
	quest.78278E7C701E1498.quest_desc: [
		"Mit dem Verzauberer machst du aus Büchern und Zutaten gezielt Verzauberungsbücher. Was er kann, steht in EMI."
	]
	quest.78278E7C701E1498.title: "Verzauberer"
	quest.783C45DB630387CD.quest_desc: [
		"Diamanten liegen ganz unten, am häufigsten knapp über dem Grundgestein."
		""
		"Spar sie dir für Spitzhacke und Zaubertisch."
	]
	quest.783C45DB630387CD.title: "Diamanten!"
	quest.784C0B3981ADD0E4.quest_desc: [
		"Die Bulk-Zelle speichert nur eine Item-Sorte, davon aber praktisch unbegrenzt viel. Perfekt für Bruchstein und Co."
	]
	quest.784C0B3981ADD0E4.title: "Bulk-Zelle"
	quest.78A28E1AB6296C7F.quest_desc: [
		"Fällt Bäume oder sägt Items auf einem Förderband, zum Beispiel Stämme zu Brettern."
	]
	quest.78A28E1AB6296C7F.title: "Mechanische Säge"
	quest.78B184763A82F719.quest_desc: [
		"Ein &ePhantomface&r verhält sich wie der Block, mit dem du es verbindest, auch aus der Entfernung. Praktisch für Rohre und Lager."
	]
	quest.78B184763A82F719.title: "Phantomface"
	quest.78BAA5E34EDF0793.quest_desc: [
		"Die &eEssence of the Bees&r bekommst du, wenn du die Aufgaben der Bee Queen erfüllst. Mit ihr greifen dich Bienen in der Bumblezone nicht mehr an."
	]
	quest.78BAA5E34EDF0793.title: "Essenz der Bienen"
	quest.78CF1314DC9B7E87.quest_desc: [
		"Die nächste Stufe. Großhammer und Großaxt sind langsam, aber treffen hart. Rapier und Sai sind schnell."
	]
	quest.78CF1314DC9B7E87.title: "Diamantklinge"
	quest.78D36C6AB90A6B87.quest_desc: [
		"Der Foliot ist der schwächste Geist. Beschwör einen &eFoliot-Zerkleinerer&r: Er macht aus einem Erz zwei Staub.\n\nWelche Zutaten in die Schalen kommen, steht im Wörterbuch."
	]
	quest.78D36C6AB90A6B87.title: "Foliot beschwören"
	quest.78DC9BB2270B5FF0.quest_desc: [
		"Der Energieakzeptor wandelt FE aus anderen Mods in AE-Energie um. So bekommt dein Netzwerk Saft."
	]
	quest.78DC9BB2270B5FF0.title: "Strom fürs Netz"
	quest.78F1E467E7B385AA.quest_desc: [
		"Im Aurora-Palast auf dem Gletscher regiert die Schneekönigin. Sie ist der letzte große Boss des Twilight Forest."
	]
	quest.78F1E467E7B385AA.title: "Die Schneekönigin"
	quest.7910D50051A25EDE.quest_desc: [
		"Ein untoter Piglin-Magier aus Allthemodium. Er lässt sein Herz fallen."
	]
	quest.7910D50051A25EDE.title: "Piglich"
	quest.7912F3F4A5C7E07F.quest_desc: [
		"Monster lassen manchmal Ausrüstung mit farbigem Namen fallen. Diese hat zufällige &eAffixe&r und eine Seltenheit von Gewöhnlich bis Mythisch.\n\nHak ab, sobald du ein solches Teil gefunden hast."
	]
	quest.7912F3F4A5C7E07F.title: "Affix-Beute"
	quest.7938DBBC73EE0197.quest_desc: [
		"Erst die Pulverladungen, dann das Geschoss in die Kanone. Mehr Ladungen = weiter, aber zu viele zerlegen schwache Rohre."
	]
	quest.7938DBBC73EE0197.title: "Munition"
	quest.79409711733C9E19.quest_desc: [
		"Vertraute (Familiars) sind kleine Geister, die dich begleiten und Boni geben. Mit dem Ring kannst du einen Vertrauten tragen."
	]
	quest.79409711733C9E19.title: "Vertraute"
	quest.795479D5B24AD67E.quest_desc: [
		"Wilder Reis wächst im flachen Wasser. Pflanz ihn in Wasser, das nur einen Block tief ist."
	]
	quest.795479D5B24AD67E.title: "Reis"
	quest.7959DACE8659FC77.quest_desc: [
		"Eine ganze Stadt im Nether, gebaut wie eine Endstadt."
	]
	quest.7959DACE8659FC77.title: "Nether-Stadt"
	quest.7962AB82AD302E11.quest_desc: [
		"Der SPS macht aus Polonium Antimaterie, braucht dafür aber extrem viel Strom. Spätestens jetzt lohnt sich der Fusionsreaktor."
	]
	quest.7962AB82AD302E11.title: "Superkritischer Phasenwandler"
	quest.79640B5A8342904A.quest_desc: [
		"Eine komplette Eisenfarm in einem Block. Dafür kommt ein Dorfbewohner hinein."
	]
	quest.79640B5A8342904A.title: "Eisenfarm im Block"
	quest.796EF133A6EC7899.quest_desc: [
		"Das Material für &6mythische&r Ausrüstung, das seltenste von allen."
	]
	quest.796EF133A6EC7899.title: "Gottgeschmiedete Perle"
	quest.7973DBE11E287880.quest_desc: [
		"Feuer vor dem Lüfter räuchert (kocht Essen), Lava schmilzt. Seelenfeuer macht noch etwas anderes, schau in EMI.\n\nHak die Quest ab, wenn du es ausprobiert hast."
	]
	quest.7973DBE11E287880.title: "Räuchern und Schmelzen"
	quest.7974981E19B01287.quest_desc: [
		"Die Forlorn Hollows: finstere Höhlen voller Schatten. Hier lauern die unheimlichsten Kreaturen der Mod."
	]
	quest.7974981E19B01287.title: "Verlassene Höhlen"
	quest.797AB693CAEC1BFF.quest_desc: [
		"Das Teleport-Pad bringt dich in die Allthemodium-Welten: &eSchleichen + Rechtsklick mit leeren Händen&r. Wo es steht, entscheidet über das Ziel: Overworld, Nether oder End."
	]
	quest.797AB693CAEC1BFF.title: "Teleport-Pad"
	quest.798A3AD1AF5DF50C.quest_desc: [
		"Die Megafackel von TorchMaster verhindert in einem großen Umkreis das Spawnen von Monstern."
		""
		"Perfekt für die Basis."
	]
	quest.798A3AD1AF5DF50C.title: "Megafackel"
	quest.79A351FCC5F157E3.quest_desc: [
		"Gold, Redstone und leitfähige Legierung. Daraus werden bessere Leitungen, Zahnräder und Kondensatoren."
	]
	quest.79A351FCC5F157E3.title: "Energetische Legierung"
	quest.79A70F31B70793E7.quest_desc: [
		"Verbesserte Spulen (Gold) und Elite-Spulen (Diamant) brauchst du für die mittleren Stufen."
	]
	quest.79A70F31B70793E7.title: "Bessere Spulen"
	quest.79AC132265A61AE3.quest_desc: [
		"Gold, Diamant, Smaragd: Auch dafür gibt es Bienen. Die Zucht ist aufwendiger, lohnt sich aber."
	]
	quest.79AC132265A61AE3.title: "Edelstein-Bienen"
	quest.79CF753B18D26C5E.quest_desc: [
		"Der Digital Miner baut gezielt Erze in einem großen Radius ab, ohne dass du graben musst. Filter einstellen nicht vergessen."
	]
	quest.79CF753B18D26C5E.title: "Digitaler Bergarbeiter"
	quest.79ECCF044C4F3414.quest_desc: [
		"Kabel verbinden Controller, Laufwerke und Konsolen. Anders als bei AE2 gibt es kein Kanal-Limit."
	]
	quest.79ECCF044C4F3414.title: "Kabel"
	quest.79F98304CA2D2FA6.quest_desc: [
		"Oxidierer und Isotopenzentrifuge sind die letzten Schritte zum Spaltbrennstoff. Die ganze Kette zeigt dir EMI."
	]
	quest.79F98304CA2D2FA6.title: "Spaltbrennstoff"
	quest.7A03239EEEC0EDFB.quest_desc: [
		"Ein Antimaterie-Pellet aus dem SPS. Dafür brauchst du sehr viel Polonium und noch mehr Strom."
	]
	quest.7A03239EEEC0EDFB.title: "Antimaterie"
	quest.7A0C7257CB8DF33C.quest_desc: [
		"Aus Alpha-Yetifell wird eine Rüstung, die Gegner einfrieren kann."
	]
	quest.7A0C7257CB8DF33C.title: "Yeti-Rüstung"
	quest.7A37CD879B58C194.quest_desc: [
		"Die beiden Kerne stecken in Konsolen, Bussen und Schnittstellen. Mach gleich ein paar mehr."
	]
	quest.7A37CD879B58C194.title: "Formation und Annihilation"
	quest.7A3D513D6D40C877.quest_desc: [
		"Der &eKondensator&r lädt deine Werkzeuge und Rüstung unterwegs auf."
	]
	quest.7A3D513D6D40C877.title: "Wyvern-Kondensator"
	quest.7A45EE883882B3CE.quest_desc: [
		"Die &eUltimative Spule&r (Smaragd) ist für die höchsten Jetpack-Stufen."
	]
	quest.7A45EE883882B3CE.title: "Ultimative Spule"
	quest.7A60DFAC4EFEFE47.quest_desc: [
		"Die nasse Bürste mischst du im Kessel und trocknest sie auf dem Gestell. Ohne Bürste fliegt kein Besen."
	]
	quest.7A60DFAC4EFEFE47.title: "Besenbürste"
	quest.7A662B376EA6BA68.quest_desc: [
		"Im Bronze-Dungeon des Aether wartet der Slider, ein rutschender Steinblock. Er ist nur mit einer Spitzhacke gut zu treffen.\n\nSein Schlüssel öffnet die Schatztruhe."
	]
	quest.7A662B376EA6BA68.title: "Der Slider"
	quest.7A68A0DFD3EFE9B8.quest_desc: [
		"Bau einen Rahmen aus Teleporterrahmen um den Teleporter. Mit dem Tragbaren Teleporter geht es auch unterwegs."
	]
	quest.7A68A0DFD3EFE9B8.title: "Teleporter"
	quest.7A8608CC68BB59F2.quest_desc: [
		"Der Energiekern der höchsten Stufe, Zutat für chaotische Ausrüstung."
	]
	quest.7A8608CC68BB59F2.title: "Chaotischer Energiekern"
	quest.7A8666B548428CC0.quest_desc: [
		"Aus Steam 'n' Rails: ein klassisches Flügelsignal, das an einem Zugsignal die Stellung anzeigt."
	]
	quest.7A8666B548428CC0.title: "Formsignal"
	quest.7A868566133E6D5E.quest_desc: [
		"Der &eCrusher&r verdoppelt Erze zu Staub. Den Doppel-Crusher gibt es auch."
	]
	quest.7A868566133E6D5E.title: "Zerkleinerer"
	quest.7A8EB442623F86E0.quest_desc: [
		"Der Reiniger entfernt schlechte Verzauberungen und Flüche von Items und kann noch mehr. Details im Handbuch."
	]
	quest.7A8EB442623F86E0.title: "Reiniger"
	quest.7AA391CBB9F572A2.quest_desc: [
		"Wie der Naturkompass, nur für Strukturen: Dörfer, Dungeons, Tempel und alles, was die Mods mitbringen."
	]
	quest.7AA391CBB9F572A2.title: "Kompass des Entdeckers"
	quest.7AAB44A7BA875B9D.quest_desc: [
		"EvilCraft ist dunkle Magie mit Blut. Alles beginnt mit &eDunklen Edelsteinen&r aus Dunklem Erz in der Overworld."
	]
	quest.7AAB44A7BA875B9D.title: "Dunkle Edelsteine"
	quest.7AD279CA40D7CFDF.quest_desc: [
		"Fertige einen Ring und eine Kette mit Edelstein."
	]
	quest.7AD279CA40D7CFDF.title: "Eigener Schmuck"
	quest.7ADCC75C9FAC4E30.quest_desc: [
		"Rechts im Inventar siehst du die Item-Liste von EMI. Fahr mit der Maus über ein Item und drück &eR&r für Rezepte oder &eU&r für Verwendungen."
		""
		"Unten gibt es ein Suchfeld. Mit &e@modname&r filterst du nach Mods."
	]
	quest.7ADCC75C9FAC4E30.title: "EMI: Rezepte finden"
	quest.7AEAA59AC962AF57.quest_desc: [
		"Baue einen leeren Lohenbrenner und fang damit im Nether eine Lohe ein (Rechtsklick). Gefüttert mit Brennstoff heizt er ein Becken.\n\nEine Lohe reicht, sie lebt im Brenner weiter."
	]
	quest.7AEAA59AC962AF57.title: "Lohenbrenner"
	quest.7AEE025CA84AEA71.quest_desc: [
		"Mit dem &eKristallbinder&r verknüpfst du Energie-Kristalle miteinander und mit Maschinen."
	]
	quest.7AEE025CA84AEA71.title: "Kristallbinder"
	quest.7AF1C4673EFD7558.quest_desc: [
		"&eEnergie-Laser-Relais&r schicken Strom kabellos von Relais zu Relais. Mit dem Laser-Schraubenschlüssel verbindest du sie."
	]
	quest.7AF1C4673EFD7558.title: "Laser-Relais"
	quest.7AF35B5EFFE64A8B.quest_desc: [
		"Co-Prozessoren lassen die CPU mehrere Schritte gleichzeitig erledigen, mehr Speicher erlaubt größere Aufträge."
	]
	quest.7AF35B5EFFE64A8B.title: "Schnellere CPU"
	quest.7AF5B34AF5DA025A.quest_desc: [
		"Der Kompressor verarbeitet Staub mit Osmium zu besonderen Barren."
	]
	quest.7AF5B34AF5DA025A.title: "Osmium-Kompressor"
	quest.7B005C66E54C4A96.quest_desc: [
		"Erhöht, wie viele Items in einen Slot passen. Höhere Stufen lassen sich daraus weiterbauen."
	]
	quest.7B005C66E54C4A96.title: "Stack-Upgrade"
	quest.7B1752DBCDA494CB.quest_desc: [
		"&eDuratium&r schmilzt du in der Gießerei aus Netherit und Platin."
	]
	quest.7B1752DBCDA494CB.title: "Duratium"
	quest.7B19E78630ED9DA5.quest_desc: [
		"Mit Sophisticated Storage Create Integration funktionieren die Truhen und Fässer auch auf Create-Contraptions, z. B. auf Zügen."
	]
	quest.7B19E78630ED9DA5.title: "Truhen auf Contraptions"
	quest.7B3AF0FA714D654B.quest_desc: [
		"Der Stromspeicher von Ender IO. Mehrere Bänke nebeneinander bilden einen gemeinsamen Speicher."
	]
	quest.7B3AF0FA714D654B.title: "Kondensatorbank"
	quest.7B4B7E30B3B56FA3.quest_desc: [
		"Füll einen Eimer pinken Schleim ab. Den brauchst du flüssig für das nächste Gehäuse, mit Eisen und Gold werden daraus auch pinke Schleimbarren."
	]
	quest.7B4B7E30B3B56FA3.title: "Pinker Schleim"
	quest.7B572E45F64E5BC0.quest_desc: [
		"Das Eisen des Undergarden. Gut für erste Werkzeuge dort unten."
	]
	quest.7B572E45F64E5BC0.title: "Cloggrum"
	quest.7B59ADFD4F9D37F0.quest_desc: [
		"Mit dem Funksender im Netzwerk greifst du per drahtloser Konsole von überall in Reichweite auf dein Lager zu."
	]
	quest.7B59ADFD4F9D37F0.title: "Drahtlose Konsole"
	quest.7B61F149E77508B1.quest_desc: [
		"Beste Waffe, beste Rüstung. Du bist für jeden Boss gerüstet."
	]
	quest.7B61F149E77508B1.title: "Waffenmeister"
	quest.7B8DF4C0320706E8.quest_desc: [
		"Ein &efliegender Besen&r! Der Weidenbesen ist der langsamste, aber der günstigste. Schleichen + Rechtsklick öffnet sein Inventar für Bürste und Zubehör."
	]
	quest.7B8DF4C0320706E8.title: "Weidenbesen"
	quest.7B941B77210E9405.quest_desc: [
		"Ignitium ist die Grundlage für Rüstung und Waffen der Flamme. Die Schmiedevorlage baust du aus einer Netheritvorlage."
	]
	quest.7B941B77210E9405.title: "Ignitium"
	quest.7BA7EF06C9D66245.quest_desc: [
		"Stein, Erde und Holz sind Stufe 1. Gut zum Üben am Infusionsaltar."
	]
	quest.7BA7EF06C9D66245.title: "Erste Ressourcen-Samen"
	quest.7BACE0D2E35CBB87.quest_desc: [
		"Apotheosis ist geschafft: Verzauberungen über dem Maximum, Edelsteine in jedem Sockel."
	]
	quest.7BACE0D2E35CBB87.title: "Meister der Verzauberung"
	quest.7BB2021DE12412C8.quest_desc: [
		"Bessere Rohre werden gegossen: geschmolzenes Metall in eine Gussform. EMI zeigt die Schritte."
	]
	quest.7BB2021DE12412C8.title: "Gusseisen-Kanone"
	quest.7BCACB40D971A921.quest_desc: [
		"Die &eDruckkammer&r ist ein hohler Würfel (mindestens 3x3x3) aus Wänden oder Glas, mit einem &eVentil&r für die Luft und &eInterfaces&r für Items rein und raus."
		""
		"Darin werden Items unter Druck umgewandelt, z. B. Eisen zu Komprimiertem Eisen oder Kohleblöcke zu Diamanten. Rezepte in EMI."
	]
	quest.7BCACB40D971A921.title: "Druckkammer"
	quest.7BD663D8850EAB47.quest_desc: [
		"Magier-Rüstung gibt Mana und Mana-Regeneration. Es gibt drei Stile: Zauberer (leicht), Arkanist (mittel) und Kampfmagier (schwer)."
	]
	quest.7BD663D8850EAB47.title: "Magierrobe"
	quest.7BE15ADADEA34EE7.quest_desc: [
		"Ars Énergistique verbindet Ars Nouveau mit AE2. Der Source Converter wandelt Quelle in Netz-Energie um."
	]
	quest.7BE15ADADEA34EE7.title: "Quelle im Netz"
	quest.7BE80932AE35A2B5.quest_desc: [
		"Weit draußen im End liegt die &eChaos-Insel&r. Dort wartet der &cChaos-Wächter&r, ein viel stärkerer Drache. Nimm volle Draconic-Ausrüstung mit!"
		""
		"Nach dem Sieg kannst du den Chaos-Kristall abbauen und bekommst &eChaos-Splitter&r."
	]
	quest.7BE80932AE35A2B5.title: "Chaos-Wächter"
	quest.7BE970DCA9D9B9DC.quest_desc: [
		"Der Vitalic-Link zieht Quelle aus Tieren in der Nähe, der Alchemistische aus Tränken."
	]
	quest.7BE970DCA9D9B9DC.title: "Lebens- und Trank-Quelle"
	quest.7BEA3E734F88EC9C.quest_desc: [
		"Leg eine Zutat aufs Brett und mach Rechtsklick mit dem passenden Werkzeug, z. B. dem Messer."
	]
	quest.7BEA3E734F88EC9C.title: "Schneidebrett"
	quest.7C0C7B02F8EFB645.quest_desc: [
		"Die Provider aus AdvancedAE können Zutaten gezielt auf bestimmte Seiten einer Maschine verteilen. Ideal für Maschinen mit mehreren Eingängen."
	]
	quest.7C0C7B02F8EFB645.title: "Fortgeschrittener Provider"
	quest.7C162CE57570FA36.quest_desc: [
		"Mit einer Holzspitzhacke bekommst du Bruchstein. Daraus werden bessere Werkzeuge."
	]
	quest.7C162CE57570FA36.title: "Steinzeit"
	quest.7C1CE74E3607E132.quest_desc: [
		"Schau der Gorgone nicht direkt an, sonst wirst du zu Stein. Ihr Kopf versteinert später deine Feinde."
	]
	quest.7C1CE74E3607E132.title: "Gorgone"
	quest.7C22E28BB6B7BDC6.quest_desc: [
		"Der sonnennächste Planet: heiß, karg, voller Lava."
	]
	quest.7C22E28BB6B7BDC6.title: "Der Merkur"
	quest.7C5157BD084D219E.quest_desc: [
		"Riesig, mit vielen Upgrade-Slots."
	]
	quest.7C5157BD084D219E.title: "Diamanttruhe"
	quest.7C716924B0A948EA.quest_desc: [
		"Himmelsstein ist hart und brauchst du später für den ME-Controller und als Staub für viele Rezepte. Nimm ruhig einen Stapel mit."
	]
	quest.7C716924B0A948EA.title: "Meteorit gefunden"
	quest.7C745861B1432F14.quest_desc: [
		"Die Reinigungskammer nutzt Sauerstoff und macht aus einem Erz drei Barren."
	]
	quest.7C745861B1432F14.title: "Erze verdreifachen"
	quest.7C9248114790FDE0.quest_desc: [
		"Ohne Anzug kein Weltall: Der Anzug hält dich am Leben, solange er Sauerstoff hat. Füllen kannst du ihn am Sauerstofflader."
	]
	quest.7C9248114790FDE0.title: "Raumanzug"
	quest.7CA731E845C9264F.quest_desc: [
		"FTB Backups 2 sichert die Welt automatisch in regelmäßigen Abständen. Falls doch mal etwas kaputtgeht, lässt sich ein Stand wiederherstellen."
	]
	quest.7CA731E845C9264F.title: "Backups"
	quest.7CAEDCE1F8FCD8E1.quest_desc: [
		"&cSehr heiß und saurer Regen.&r Hier gibt es &eCalorit&r. Der Netherit-Raumanzug ist hier eine gute Idee."
	]
	quest.7CAEDCE1F8FCD8E1.title: "Die Venus"
	quest.7CB70728947BA2A5.quest_desc: [
		"Hinter den äußeren Inseln (Endtransit-Portal nach dem Drachen) liegen die Endstädte. Vorsicht vor Shulkern!"
	]
	quest.7CB70728947BA2A5.title: "Endstadt"
	quest.7CBBC71A43D05755.quest_desc: [
		"Die Vibranium-Vorlage baust du aus Allthemodium und Altem Stein. Damit wertest du Allthemodium-Werkzeug auf."
	]
	quest.7CBBC71A43D05755.title: "Vibranium-Ausrüstung"
	quest.7CBC5126EFA26689.quest_desc: [
		"Rein zum Spaß: An den Kessel setzen und mit Redstone tuten lassen. Mehrere übereinander geben tiefere Töne."
	]
	quest.7CBC5126EFA26689.title: "Dampfpfeife"
	quest.7CC232DF65DFCB2A.quest_desc: [
		"Factory Logistics: verknüpft Logistiknetze miteinander. Details stehen im Tooltip."
	]
	quest.7CC232DF65DFCB2A.title: "Netzwerk-Verbindung"
	quest.7CC4A954FDA5CA77.quest_desc: [
		"Der Marid ist der stärkste Geist. Beschwör einen ungebundenen Marid und besiege ihn für &eMarid-Essenz&r. Damit stehen dir die mächtigsten Rituale offen."
	]
	quest.7CC4A954FDA5CA77.title: "Marid bezwingen"
	quest.7CC8F29FCD029FCC.quest_desc: [
		"Am Schreibertisch stellst du neue &eGlyphen&r her. Jede Glyphe kostet Zutaten und etwas XP und landet danach in deinem Buch."
	]
	quest.7CC8F29FCD029FCC.title: "Schreibertisch"
	quest.7CCF7D0CD6B3CB62.quest_desc: [
		"Vibranium ist die zweite Stufe. Schmilz das Erz wie gewohnt."
	]
	quest.7CCF7D0CD6B3CB62.title: "Vibranium"
	quest.7CD9C106A1CE5A39.quest_desc: [
		"Lohe, Ghast und Enderman sind Stufe 4."
	]
	quest.7CD9C106A1CE5A39.title: "Nether- und End-Mobs"
	quest.7CE9C825A5106558.quest_desc: [
		"Aus dem Blaze-Handbuch, Ignitium und der Ignitium-Schmiedevorlage. Das Ignitium bekommst du vom Cataclysm-Boss Ignis."
	]
	quest.7CE9C825A5106558.title: "Ignis-Zauberbuch"
	quest.7CF5EC178A7453D9.quest_desc: [
		"Mit Behutsamkeit kannst du Spawner abbauen und mitnehmen. Mit Apothic Spawners lassen sie sich danach verändern."
	]
	quest.7CF5EC178A7453D9.title: "Spawner abbauen"
	quest.7D2349DBDB6A8025.quest_desc: [
		"Hier baust du aus Köpfen und Teilen besondere Bauteile wie Zombieelektroden."
	]
	quest.7D2349DBDB6A8025.title: "Schlitz'und'Spleiß"
	quest.7D3B31FC09C87427.quest_desc: [
		"In der Welt tauchen manchmal &eBosse&r auf: verstärkte Monster mit Leuchtsäule und besonderer Beute. Hak ab, wenn du einen besiegt hast."
	]
	quest.7D3B31FC09C87427.title: "Apothische Bosse"
	quest.7D3FCF5342B7F7D8.quest_desc: [
		"Die beste Rüstung von Mekanism, gebaut auf Netherit-Rüstung. Sie braucht Strom und lässt sich mit Modulen erweitern."
	]
	quest.7D3FCF5342B7F7D8.title: "MekaSuit"
	quest.7D4A9568C4099124.quest_desc: [
		"Ein Dunkler Edelstein, mit Blut aufgeladen."
	]
	quest.7D4A9568C4099124.title: "Dunkler Kraftedelstein"
	quest.7D5471C31B97A495.quest_desc: [
		"Der Quantencomputer ist eine Multiblock-CPU mit enormem Speicher und vielen parallelen Aufträgen. Aufbau und Größen stehen im Handbuch.\n\nDas ist die Spitze von AE2!"
	]
	quest.7D5471C31B97A495.title: "Quantencomputer"
	quest.7D7361C6336E8A26.quest_desc: [
		"Ein Tiefseegraben unter dem Ozean, stockdunkel und voller Wasser. Nimm Atemhilfen mit."
	]
	quest.7D7361C6336E8A26.title: "Abyssal Chasm"
	quest.7D7CD607E5DB67EC.quest_desc: [
		"Am Anfang craftest du Legierungen per Hand: zwei Eisen und zwei Kohle ergeben Stahl, zwei Gold und zwei Redstone ergeben Elektrum. Später geht das in der Gießerei günstiger."
	]
	quest.7D7CD607E5DB67EC.title: "Stahl und Elektrum"
	quest.7D7E15F9193E7E55.quest_desc: [
		"Stell den Flüssigkeitsextraktor vor einen Baumstamm. Er zapft Latex ab und verbraucht dabei langsam den Stamm."
	]
	quest.7D7E15F9193E7E55.title: "Latex zapfen"
	quest.7D924C98258B260B.quest_desc: [
		"&eLeser&r lesen Werte aus der Welt (z. B. Kisteninhalt), &eSchreiber&r geben Werte aus (z. B. Redstone-Signal)."
	]
	quest.7D924C98258B260B.title: "Leser und Schreiber"
	quest.7D94197273554CE9.quest_desc: [
		"In der Zellenwerkbank filterst du Zellen. Karten sind Upgrades für Busse, Schnittstellen und Maschinen."
	]
	quest.7D94197273554CE9.title: "Zellenwerkbank und Karten"
	quest.7D995835AE53AC25.quest_desc: [
		"Ein Schwert aus Dunklem Kraftedelstein."
	]
	quest.7D995835AE53AC25.title: "Adernschwert"
	quest.7DA01AE8EAF32CEF.quest_desc: [
		"Der &eGrundlegende Generator&r verbrennt Brennstoff und macht Strom. Damit laufen deine ersten Maschinen."
	]
	quest.7DA01AE8EAF32CEF.title: "Strom!"
	quest.7DB2A5AB4BB5F032.quest_desc: [
		"Erfahrung gibt es hier als Flüssigkeit. Welche Wege es gibt, zeigt EMI. Fülle einen Eimer damit."
	]
	quest.7DB2A5AB4BB5F032.title: "Flüssige Erfahrung"
	quest.7DBB256EA5C0F681.quest_desc: [
		"Alle sieben Essenzen, Anima-Essenz und der Wilden-Tribut ergeben das &eMeisterzeichen&r. Damit werden Fokusse und Rüstungen aufgewertet."
	]
	quest.7DBB256EA5C0F681.title: "Meisterzeichen"
	quest.7DBE195BC92EAA01.quest_desc: [
		"Macht aus Honig Strom."
	]
	quest.7DBE195BC92EAA01.title: "Honig-Generator"
	quest.7DBE3DBBA810AEDD.quest_desc: [
		"Nimmt Items von Ein- und Ausgängen und verteilt sie. Ziele wählst du, bevor du ihn setzt (Rechtsklick auf die Blöcke)."
	]
	quest.7DBE3DBBA810AEDD.title: "Mechanischer Arm"
	quest.7DBF0E4A4542C92C.quest_desc: [
		"Das Seeregal aus Prismarin und Kugelfisch gibt Eterna und Arcana. Infundiert wird es noch besser."
	]
	quest.7DBF0E4A4542C92C.title: "Seeregal"
	quest.7DBF5A09EBAEA107.quest_desc: [
		"Towns and Towers bringt neue Dorfstile für fast jedes Biom. Jedes Towns-and-Towers-Dorf zählt."
	]
	quest.7DBF5A09EBAEA107.title: "Neue Dörfer"
	quest.7DDCD8B1E7D60BED.quest_desc: [
		"Dein erstes &eJetpack&r! Mit Strom aufladen, anziehen und mit Leertaste fliegen."
		""
		"Höhere Stufen fliegen schneller und speichern mehr Energie. Die Rezepte aller Stufen findest du in EMI."
	]
	quest.7DDCD8B1E7D60BED.title: "Jetpack!"
	quest.7DDD695F6951857B.quest_desc: [
		"Die &eLeere Platine&r ist der Rohling für Leiterplatten."
	]
	quest.7DDD695F6951857B.title: "Leere Platine"
	quest.7DEA9045F2922FBA.quest_desc: [
		"Mit Lapis und Erfahrungsleveln verzauberst du hier Werkzeuge und Rüstung."
		""
		"Bücherregale drumherum (mit einem Block Abstand) machen die Verzauberungen stärker."
	]
	quest.7DEA9045F2922FBA.title: "Zaubertisch"
	quest.7DEAD075A070658A.quest_desc: [
		"Der IO-Port schiebt Inhalte von einer Zelle ins Netz oder umgekehrt. Gut zum Umsortieren."
	]
	quest.7DEAD075A070658A.title: "IO-Port"
	quest.7DF738EF3280E727.quest_desc: [
		"Der Laser bündelt Strom zu einem Strahl. Er zündet den Fusionsreaktor und steckt in den Spulen des SPS."
	]
	quest.7DF738EF3280E727.title: "Laser"
	quest.7DFD77C0924FBBF9.quest_desc: [
		"&eSchwarzer Quarz&r ist das Grundmaterial von Actually Additions. Das Erz findest du in der Oberwelt."
	]
	quest.7DFD77C0924FBBF9.title: "Schwarzer Quarz"
	quest.7E03A16BF2020555.quest_desc: [
		"Ein günstiges Regal, das aber Eterna &cabzieht&r. Gut, um den Zufall gezielt zu steuern."
	]
	quest.7E03A16BF2020555.title: "Steinregal"
	quest.7E1E77AABF71AFB6.quest_desc: [
		"Echosplitter und Sculk aus der tiefen Dunkelheit machen die Tiefenregale noch stärker."
	]
	quest.7E1E77AABF71AFB6.title: "Echo und Seele"
	quest.7E2D231DA8B11D7A.quest_desc: [
		"Quests mit \"Abgabe:\" im Titel &cverbrauchen&r die Items. Klick dafür auf die Aufgabe, dann werden sie aus dem Inventar genommen."
		""
		"Sie sind alle optional und geben eine bessere Kiste als Belohnung."
	]
	quest.7E2D231DA8B11D7A.title: "Abgabe-Quests"
	quest.7E2F1301E6595942.quest_desc: [
		"Die &eGießerei&r schmilzt zwei Zutaten zu Legierungen, z. B. Stahl, Elektrum, Adamant und später Energit und Duratium."
	]
	quest.7E2F1301E6595942.title: "Gießerei"
	quest.7E39590C24224F46.quest_desc: [
		"Zeigt dir, was gerade hergestellt wird, und lässt dich Aufträge abbrechen."
	]
	quest.7E39590C24224F46.title: "Autocrafting-Monitor"
	quest.7E47170423CEB36E.quest_desc: [
		"Aus Eisen und Prosperity wird ein Prosperity-Barren, mit Essenz dann der Barren der jeweiligen Stufe. Daraus werden Werkzeuge, Rüstung und Maschinen-Upgrades."
	]
	quest.7E47170423CEB36E.title: "Essenzbarren"
	quest.7E52BB6A690764D2.quest_desc: [
		"Born in Chaos bringt finstere Gegner mit. Der Anführer der Schreckenshunde ist der Einstieg.\n\nEr lässt seinen &eFangzahn&r fallen."
	]
	quest.7E52BB6A690764D2.title: "Leithund"
	quest.7E54D88E8C1D55C9.quest_desc: [
		"Kupfer plus Eisen. Daraus baust du die ersten Energieleitungen."
	]
	quest.7E54D88E8C1D55C9.title: "Leitfähige Legierung"
	quest.7E78584C8E516BF3.quest_desc: [
		"Brennstoff und Reaktorstäbe: Dein Reaktor ist bereit. Mehr Strom geht mit Create kaum.\n\nViel Spaß mit den Addons!"
	]
	quest.7E78584C8E516BF3.title: "Atomkraft"
	quest.7E7BE1DDF19BBCEF.quest_desc: [
		"Der Hammer ist dein wichtigstes Werkzeug: Damit schlägst du Multiblöcke zusammen und machst im Crafting-Feld aus Barren Bleche."
	]
	quest.7E7BE1DDF19BBCEF.title: "Ingenieurshammer"
	quest.7E8062CE4178EE11.quest_desc: [
		"Splitter verteilen Quelle, Kollektoren sammeln sie ein, Einzahler füllen Gläser."
	]
	quest.7E8062CE4178EE11.title: "Relais-Varianten"
	quest.7E83AD26C177EF57.quest_desc: [
		"Draconic-Werkzeuge und -Rüstung sind modular: Mit Rechtsklick öffnest du ein Raster, in das du &eModule&r steckst (Energie, Tempo, Schaden, Schild ...)."
		""
		"Der &eModulkern&r ist die Basis jedes Moduls."
	]
	quest.7E83AD26C177EF57.title: "Modul-System"
	quest.7E9104D55AD7EB97.quest_desc: [
		"Kohle, Ton und Lava (oder Lohenstaub) ergeben dielektrische Paste. Sie steckt in fast allem von Powah."
	]
	quest.7E9104D55AD7EB97.title: "Dielektrische Paste"
	quest.7EA766940A29B5FA.quest_desc: [
		"Das &eChaotische Schwert&r ist eine der stärksten Waffen im Pack."
	]
	quest.7EA766940A29B5FA.title: "Chaotische Waffen"
	quest.7EADD692849D37A9.quest_desc: [
		"Rechtsklick mit bestimmten Items auf einen Spawner ändert seine Werte, z. B. Tempo oder Anzahl der Mobs. Welche Items was bewirken, zeigt EMI unter \"Spawner Modifiers\"."
	]
	quest.7EADD692849D37A9.title: "Spawner verändern"
	quest.7EAECFB7A9C04365.quest_desc: [
		"Die Bienenkanone verschießt Bienen auf Gegner. Die Kristallkanone verschießt Honigkristalle."
	]
	quest.7EAECFB7A9C04365.title: "Bienenkanone"
	quest.7EB88498593BB374.quest_desc: [
		"Speichert Strom. Mehrere Akkus nebeneinander bilden einen großen Speicher."
	]
	quest.7EB88498593BB374.title: "Akkumulator"
	quest.7ECF31965A8DA279.quest_desc: [
		"Auflösen mit Schwefelsäure, waschen, kristallisieren: Aus einem Erz werden fünf Barren. Die ganze Kette ist lang, schau sie dir in EMI an."
	]
	quest.7ECF31965A8DA279.title: "Erze verfünffachen"
	quest.7ECFAA5FFB5678CB.quest_desc: [
		"Der &eWyvern-Energiekern&r ist Zutat für Werkzeuge, Speicher und Kristalle."
	]
	quest.7ECFAA5FFB5678CB.title: "Wyvern-Energiekern"
	quest.7EF384820706F4D1.quest_desc: [
		"Du hast die härtesten Bosse des Packs besiegt. Respekt!\n\nJetzt wartet nur noch das große Finale."
	]
	quest.7EF384820706F4D1.title: "Bossjäger"
	quest.7F0A6AFEE5B082EB.quest_desc: [
		"Pad im Nether benutzen: The Other ist sehr feindselig, mit unterirdischen Städten und Pyramiden. Vibranium liegt hier zwischen Y 0 und 40 (abbauen mit Allthemodium-Spitzhacke)."
	]
	quest.7F0A6AFEE5B082EB.title: "The Other"
	quest.7F2B7D6DE3B51165.quest_desc: [
		"Eintöpfe und Reisgerichte machen viel länger satt als rohes Essen. Viele Gerichte geben zusätzlich nützliche Effekte."
	]
	quest.7F2B7D6DE3B51165.title: "Erste Gerichte"
	quest.7F74FD88C7F493B8.quest_desc: [
		"Fließendes Wasser dreht das Rad und damit die Welle. Je mehr Seiten vom Wasser getroffen werden, desto besser.\n\nMehrere Wasserräder auf einer Welle addieren ihre Kraft."
	]
	quest.7F74FD88C7F493B8.title: "Wasserrad"
	quest.7F80A854B9931920.quest_desc: [
		"Größere Zellen fassen mehr Bytes. Jede Item-Sorte kostet etwas Platz, also lieber wenige große Zellen."
	]
	quest.7F80A854B9931920.title: "Mehr Speicher"
	quest.7F81B6D507A9A84A.quest_desc: [
		"Verstärkt Luft- und Blitzzauber."
	]
	quest.7F81B6D507A9A84A.title: "Luft-Fokus"
	quest.7F82733A772C421F.quest_desc: [
		"Beschwörst du einen ungebundenen Afrit, musst du ihn besiegen. Er hinterlässt &eAfrit-Essenz&r.\n\n&cAchtung:&r Afrits sind gefährlich, komm gut ausgerüstet."
	]
	quest.7F82733A772C421F.title: "Afrit beschwören"
	quest.7FAF5524D80BB926.quest_desc: [
		"Das &eDictionary of Spirits&r ist das Handbuch der Mod. Dort stehen alle Pentakel, Rituale und Rezepte. Ohne das Buch geht nichts."
	]
	quest.7FAF5524D80BB926.title: "Wörterbuch der Geister"
	quest.7FD9DB8031282A88.quest_desc: [
		"Aus getrocknetem Seetang. Verbindet zwei Wellen und transportiert Items und Mobs.\n\nMit Rechtsklick auf die erste und dann auf die zweite Welle legst du das Band."
	]
	quest.7FD9DB8031282A88.title: "Förderband"
	quest.7FF2105F17625BAB.quest_desc: [
		"Das volle Set aus Allthemodium. Auch hier ist Netherit die Grundlage."
	]
	quest.7FF2105F17625BAB.title: "Allthemodium-Rüstung"
	quest.7FFE19FFD63DC240.quest_desc: [
		"Der &eFlux-Kompressor&r macht aus Strom (FE) Druckluft. Ideal, wenn du schon ein Stromnetz hast."
	]
	quest.7FFE19FFD63DC240.title: "Flux-Kompressor"
	reward_table.1854CFECFCB229DE.title: "&aSeltene Kiste"
	reward_table.34B348DFF91C65B9.title: "&6Legendäre Kiste"
	reward_table.5E240D7218821E7C.title: "&5Epische Kiste"
	reward_table.7B237B19C7A02EF9.title: "&fGewöhnliche Kiste"
}
